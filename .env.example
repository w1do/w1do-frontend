PUBLIC_TELEGRAM_CHAT_ID=

# Leads platform (backend.w1do.ru)
# Server-side only: no PUBLIC_ prefix, so these never reach the client bundle.
LEADS_API_BASE_URL=https://backend.w1do.ru
LEADS_API_KEY=
# Confirmed default_city in W1DO. Public API exposes cities and SEO, not settings.
# Update this value if the CMS default changes.
W1DO_DEFAULT_CITY=moscow
# Site's own proxy route the browser posts to.
PUBLIC_LEADS_ENDPOINT=/api/lead

REDIS_PASSWORD=
REDIS_URL=
TRUSTED_PROXY_HOPS=0
CHAT_LEAD_HASH_SECRET=
POLZA_AI_API_KEY=

# Vector RAG (server-side only)
RAG_API_URL=https://rag.w1do.ru/api/v1
RAG_API_KEY=
RAG_PROJECT_ID=
