<!-- SlickNav js file -->
<script src="/js/jquery.slicknav.js" is:inline defer></script>
<!-- Swiper js file -->
<script src="/js/swiper-bundle.min.js" is:inline defer></script>
<!-- Counter js file -->
<script src="/js/jquery.waypoints.min.js" is:inline defer></script>
