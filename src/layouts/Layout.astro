---
interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	image?: string;
	canonical?: string;
	robots?: string;
	type?: string;
	schema?: Record<string, any> | Array<Record<string, any>>;
}

import { DEFAULT_OG_IMAGE, pageSeo } from "../lib/seo";
import { cityPath, regionalSchema } from "../lib/regions";
import CookieNotice from "../components/shared/CookieNotice.astro";
import JsonLd from "../components/shared/JsonLd.astro";
import "../styles/fonts.css";
import "../styles/bootstrap.min.css";
import "../styles/slicknav.min.css";
import "../styles/swiper-bundle.min.css";
import "../styles/all.min.css";
import "../styles/animate.css";
import "../styles/magnific-popup.css";
import "../styles/mousecursor.css";
import "../styles/custom.css";

const region = Astro.locals.region;
const pagePath = region?.path || Astro.url.pathname;
const citySeo = region?.city.seo;
const isCityHome = Boolean(region && pagePath === "/");
const currentSeo = pageSeo[pagePath.replace(/\/$/, "") || "/"];
const {
    title: suppliedTitle,
    description: suppliedDescription,
    keywords: suppliedKeywords,
    image: suppliedImage,
    canonical: suppliedCanonical,
    robots: suppliedRobots,
    type = "website",
    schema,
} = Astro.props;
const pageTitle = currentSeo?.title || suppliedTitle || pageSeo["/"].title;
const pageDescription = currentSeo?.description || suppliedDescription || pageSeo["/"].description;
const title = isCityHome && citySeo?.title ? citySeo.title : region ? `${pageTitle} | ${region.city.name}` : pageTitle;
const description = isCityHome && citySeo?.description ? citySeo.description
    : region && citySeo?.description ? `${pageDescription} ${citySeo.description}` : pageDescription;
const keywords = [currentSeo?.keywords || suppliedKeywords, citySeo?.keywords].filter(Boolean).join(", ").replace(/разработчик_ии/g, "разработчик ИИ");
const robots = suppliedRobots?.includes("noindex") ? suppliedRobots
    : citySeo?.robots?.includes("noindex") ? citySeo.robots : suppliedRobots || citySeo?.robots;
const canonical = region ? new URL(cityPath(region.city.slug, region.defaultCitySlug), Astro.site || "https://w1do.ru").href
    : suppliedCanonical || new URL(Astro.url.pathname, Astro.site || "https://w1do.ru").href;
const ogTitle = isCityHome ? citySeo?.og_title || title : title;
const ogDescription = isCityHome ? citySeo?.og_description || description : description;
let image = (isCityHome ? citySeo?.og_image : undefined) || suppliedImage || DEFAULT_OG_IMAGE;
if (image.startsWith("/images/og-")) image = DEFAULT_OG_IMAGE;
if (image.startsWith("/images/blog/") && image.endsWith(".svg")) {
    image = image.replace("/images/blog/", "/images/og/").replace(/\.svg$/, ".jpg");
} else if (image.split("?")[0].toLowerCase().endsWith(".svg")) {
    image = DEFAULT_OG_IMAGE;
}
const socialImage = new URL(image, Astro.site || "https://w1do.ru").href;

const siteUrl = Astro.site?.href?.replace(/\/$/, "") || "https://w1do.ru";
const logoUrl = new URL("/images/favicon.png", Astro.site || Astro.url).href;

// Базовые структурированные данные (Schema.org) для всех страниц
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": `${siteUrl}/#organization`,
	"name": "W1DO DIGITAL",
	"url": siteUrl,
	"logo": {
		"@type": "ImageObject",
		"url": logoUrl
	},
	"description": pageSeo["/"].description,
	"sameAs": [
		"https://t.me/W1DO_DIGITAL"
	]
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${siteUrl}/#website`,
	"url": siteUrl,
	"name": "W1DO DIGITAL",
	"inLanguage": "ru-RU",
	"publisher": { "@id": `${siteUrl}/#organization` }
};

const suppliedSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
if (isCityHome && citySeo?.json_ld) suppliedSchemas.push(citySeo.json_ld);
const extraSchemas = region ? suppliedSchemas.map(item => regionalSchema(item, region) as Record<string, unknown>) : suppliedSchemas;
const webPageSchema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    "url": canonical,
    "name": title,
    "description": description,
    "inLanguage": "ru-RU",
    "isPartOf": { "@id": `${siteUrl}/#website` },
};
const schemas = [organizationSchema, websiteSchema, webPageSchema, ...extraSchemas];
---

<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
    <meta name="description" content={description}>
    {keywords && <meta name="keywords" content={keywords}>}
    {robots && <meta name="robots" content={robots}>}
    <meta name="author" content="Денис Митрофанов">
    <meta name="generator" content={Astro.generator}/>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical}>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type}>
    <meta property="og:url" content={canonical}>
    <meta property="og:locale" content="ru_RU">
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:image" content={socialImage}>

    <!-- Twitter -->
    <meta name="twitter:card" content={isCityHome ? citySeo?.twitter_card || "summary_large_image" : "summary_large_image"}>
    <meta name="twitter:url" content={canonical}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={socialImage}>

    <!-- Structured Data / JSON-LD -->
    <JsonLd schema={schemas} />

    <!-- Page Title -->
    <title>{title}</title>
    <!-- Favicon Icon -->
    <link rel="shortcut icon" type="image/x-icon" href="/images/favicon.png">

    <style is:global>
        @font-face {
            font-family: 'Font Awesome 7 Free';
            font-display: swap !important;
        }
        @font-face {
            font-family: 'Font Awesome 7 Brands';
            font-display: swap !important;
        }
        @font-face {
            font-family: 'swiper-icons';
            font-display: swap !important;
        }
    </style>
</head>
<body>
<slot/>
<CookieNotice/>

<!-- Jquery Library File -->
