---
interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	image?: string;
	canonical?: string;
	robots?: string;
	type?: string;
	schema?: Record<string, any> | Array<Record<string, any>>;
}

import { DEFAULT_OG_IMAGE, pageSeo } from "../lib/seo";
import { SITE_ORIGIN, cityPath, regionalSchema } from "../lib/regions";
import CookieNotice from "../components/shared/CookieNotice.astro";
import JsonLd from "../components/shared/JsonLd.astro";
import ChatPopup from "../components/chat/ChatPopup";
import "../styles/fonts.css";
import "../styles/bootstrap.min.css";
import "../styles/slicknav.min.css";
import "../styles/swiper-bundle.min.css";
import "../styles/all.min.css";
import "../styles/animate.css";
import "../styles/magnific-popup.css";
import "../styles/mousecursor.css";
import "../styles/custom.css";

const region = Astro.locals.region;
const pagePath = region?.path || Astro.url.pathname;
const citySeo = region?.city.seo;
const isCityHome = Boolean(region && pagePath === "/");
const currentSeo = pageSeo[pagePath.replace(/\/$/, "") || "/"];
const {
    title: suppliedTitle,
    description: suppliedDescription,
    keywords: suppliedKeywords,
    image: suppliedImage,
    canonical: suppliedCanonical,
    robots: suppliedRobots,
    type = "website",
    schema,
} = Astro.props;
const pageTitle = currentSeo?.title || suppliedTitle || pageSeo["/"].title;
const pageDescription = currentSeo?.description || suppliedDescription || pageSeo["/"].description;
const title = isCityHome && citySeo?.title ? citySeo.title : region ? `${pageTitle} | ${region.city.name}` : pageTitle;
const description = isCityHome && citySeo?.description ? citySeo.description
    : region && citySeo?.description ? `${pageDescription} ${citySeo.description}` : pageDescription;
const keywords = [currentSeo?.keywords || suppliedKeywords, citySeo?.keywords].filter(Boolean).join(", ").replace(/разработчик_ии/g, "разработчик ИИ");
const robots = suppliedRobots?.includes("noindex") ? suppliedRobots
    : citySeo?.robots?.includes("noindex") ? citySeo.robots : suppliedRobots || citySeo?.robots;
const canonical = region ? new URL(cityPath(region.city.slug, region.defaultCitySlug), SITE_ORIGIN).href
    : suppliedCanonical || new URL(Astro.url.pathname, SITE_ORIGIN).href;
const ogTitle = isCityHome ? citySeo?.og_title || title : title;
const ogDescription = isCityHome ? citySeo?.og_description || description : description;
let image = (isCityHome ? citySeo?.og_image : undefined) || suppliedImage || DEFAULT_OG_IMAGE;
if (image.startsWith("/images/og-")) image = DEFAULT_OG_IMAGE;
if (image.startsWith("/images/blog/") && image.endsWith(".svg")) {
    image = image.replace("/images/blog/", "/images/og/").replace(/\.svg$/, ".jpg");
} else if (image.split("?")[0].toLowerCase().endsWith(".svg")) {
    image = DEFAULT_OG_IMAGE;
}
const socialImage = new URL(image, SITE_ORIGIN).href;

const siteUrl = SITE_ORIGIN;
const logoUrl = new URL("/images/favicon.png", SITE_ORIGIN).href;

// Базовые структурированные данные (Schema.org) для всех страниц
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": `${siteUrl}/#organization`,
	"name": "AiCRAFT.AGENCY",
	"url": siteUrl,
	"logo": {
		"@type": "ImageObject",
		"url": logoUrl
	},
	"description": pageSeo["/"].description,
	"founder": { "@type": "Person", "name": "Денис Митрофанов" },
	"sameAs": [
		"https://t.me/W1DO_DIGITAL",
		"https://www.youtube.com/@w1do_digital"
	]
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${siteUrl}/#website`,
	"url": siteUrl,
	"name": "AiCRAFT.AGENCY",
	"inLanguage": "ru-RU",
	"publisher": { "@id": `${siteUrl}/#organization` }
};

const suppliedSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
if (isCityHome && citySeo?.json_ld) suppliedSchemas.push(citySeo.json_ld);
const extraSchemas = region ? suppliedSchemas.map(item => regionalSchema(item, region) as Record<string, unknown>) : suppliedSchemas;
const webPageSchema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    "url": canonical,
    "name": title,
    "description": description,
    "inLanguage": "ru-RU",
    "isPartOf": { "@id": `${siteUrl}/#website` },
};
const schemas = [organizationSchema, websiteSchema, webPageSchema, ...extraSchemas];
const showChatPopup = pagePath.replace(/\/+$/, "") !== "/chat";
const quickTelegramUrl = import.meta.env.PUBLIC_TELEGRAM_URL || "https://t.me/W1DO_DIGITAL";
---

<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    {keywords && <meta name="keywords" content={keywords}>}
    {robots && <meta name="robots" content={robots}>}
    <meta name="author" content="Денис Митрофанов">
    <meta name="generator" content={Astro.generator}/>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical}>
    <link rel="preconnect" href="https://mc.yandex.ru" crossorigin>
    {pagePath === "/" && <link rel="preload" as="image" href="/images/hero-service-infrastructure.webp" fetchpriority="high" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type}>
    <meta property="og:url" content={canonical}>
    <meta property="og:locale" content="ru_RU">
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:image" content={socialImage}>

    <!-- Twitter -->
    <meta name="twitter:card" content={isCityHome ? citySeo?.twitter_card || "summary_large_image" : "summary_large_image"}>
    <meta name="twitter:url" content={canonical}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={socialImage}>

    <!-- Structured Data / JSON-LD -->
    <JsonLd schema={schemas} />

    <!-- Page Title -->
    <title>{title}</title>
    <!-- Favicon Icon -->
    <link rel="shortcut icon" type="image/x-icon" href="/images/favicon.png">

    <style is:global>
        a:focus-visible,
        button:focus-visible,
        input:focus-visible,
        textarea:focus-visible,
        select:focus-visible,
        summary:focus-visible {
            outline: 2px solid var(--accent-color);
            outline-offset: 3px;
        }
        .mobile-cta { display: none; }
        @media (max-width: 767px) {
            body { padding-bottom: 84px; }
            .mobile-cta {
                position: fixed;
                left: 12px;
                right: 12px;
                bottom: calc(12px + env(safe-area-inset-bottom));
                z-index: 1000;
                display: flex;
                gap: 8px;
                padding: 8px;
                border: 1px solid var(--divider-color);
                border-radius: 18px;
                background: rgba(10, 10, 10, 0.92);
                backdrop-filter: blur(16px);
            }
            .mobile-cta a {
                display: flex;
                flex: 1;
                align-items: center;
                justify-content: center;
                min-height: 48px;
                padding: 0 16px;
                border-radius: 12px;
                font-size: 15px;
                font-weight: 600;
            }
            .mobile-cta__primary { background: var(--accent-color); color: #0a0a0a; }
            .mobile-cta__secondary { border: 1px solid var(--divider-color); color: var(--primary-color); }
            .ai-chat-popup__toggle { bottom: calc(86px + env(safe-area-inset-bottom)); }
            /* Пока открыт cookie-баннер, быстрые действия не перекрывают его. */
            body:has(.cookie-notice.is-visible) .mobile-cta,
            body:has(.cookie-notice.is-visible) .ai-chat-popup__toggle { display: none; }
        }
        @font-face {
            font-family: 'Font Awesome 7 Free';
            font-display: swap !important;
        }
        @font-face {
            font-family: 'Font Awesome 7 Brands';
            font-display: swap !important;
        }
        @font-face {
            font-family: 'swiper-icons';
            font-display: swap !important;
        }
    </style>
</head>
<body>
<slot/>
<CookieNotice/>
<div class="mobile-cta" aria-label="Быстрые действия">
    <a class="mobile-cta__primary" href="/contact">Оставить заявку</a>
    <a class="mobile-cta__secondary" href={quickTelegramUrl} rel="noopener">Telegram</a>
</div>
{showChatPopup && <ChatPopup client:load />}

<!-- Jquery Library File -->
<script src="/js/jquery-3.7.1.min.js" is:inline></script>
<!-- Circle Progress Js File -->
<script src="/js/circle-progress.min.js" is:inline defer></script>
<!-- Bootstrap js file -->
<script src="/js/bootstrap.min.js" is:inline defer></script>
<!-- Validator js file -->
<!-- SlickNav js file -->
<script src="/js/jquery.slicknav.js" is:inline defer></script>
<!-- Swiper js file -->
<script src="/js/swiper-bundle.min.js" is:inline defer></script>
<!-- Counter js file -->
<script src="/js/jquery.waypoints.min.js" is:inline defer></script>
<script src="/js/jquery.counterup.min.js" is:inline defer></script>
<!-- Magnific js file -->
<script src="/js/jquery.magnific-popup.min.js" is:inline defer></script>
<!-- SmoothScroll -->
<script src="/js/SmoothScroll.js" is:inline defer></script>
<!-- Isotop js file -->
<script src="/js/isotope.min.js" is:inline defer></script>
<!-- Parallax js -->
<script src="/js/parallaxie.js" is:inline defer></script>
<!-- MagicCursor js file -->
<script src="/js/gsap.min.js" is:inline defer></script>
<script src="/js/magiccursor.js" is:inline defer></script>
<!-- Text Effect js file -->
<script src="/js/SplitText.min.js" is:inline defer></script>
<script src="/js/ScrollTrigger.min.js" is:inline defer></script>
<!-- YTPlayer js File -->
<script src="/js/jquery.mb.YTPlayer.min.js" is:inline defer></script>
<!-- Typed js file -->
<script src="/js/typed.js" is:inline defer></script>
<!-- Wow js file -->
<script src="/js/wow.min.js" is:inline defer></script>
<!-- Main Custom js file -->
<script src="/js/function.js" is:inline defer></script>

<!-- Yandex.Metrika counter -->
<script type="text/javascript">
    (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
    })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=109810952', 'ym');

    ym(109810952, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
