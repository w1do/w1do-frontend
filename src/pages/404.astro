---
import Layout from "../layouts/Layout.astro";
import Header from "../components/shared/Header.astro";
import Footer from "../components/shared/Footer.astro";

export const prerender = false;
Astro.response.status = 404;
---
<Layout title="Страница не найдена | AiCRAFT"
  description="Страница не найдена или больше не опубликована. Перейдите на главную, в каталог услуг, кейсы или блог AiCRAFT."
  robots="noindex,follow">
  <Header />
  <main class="error-page">
    <div class="container">
      <span class="error-page__code">404</span>
      <h1>Страница не найдена</h1>
      <p>Возможно, адрес изменился или страница больше не существует. Вот куда можно перейти:</p>
      <div class="error-page__links">
        <a href="/" class="btn-default">На главную</a>
        <a href="/services">Услуги</a>
        <a href="/case">Кейсы</a>
        <a href="/pricing">Цены</a>
        <a href="/blog">Блог</a>
        <a href="/contact">Контакты</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .error-page { padding: 180px 0 100px; text-align: center; }
  .error-page__code {
    display: inline-block;
    margin-bottom: 12px;
    color: var(--accent-color);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }
  .error-page h1 { margin: 0 0 16px; color: var(--primary-color); font-size: clamp(32px, 5vw, 56px); }
  .error-page p { max-width: 560px; margin: 0 auto 28px; color: var(--text-color); font-size: 17px; line-height: 1.6; }
  .error-page__links { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; align-items: center; }
  .error-page__links a:not(.btn-default) { color: var(--primary-color); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 575px) { .error-page { padding: 140px 0 80px; } }
</style>
