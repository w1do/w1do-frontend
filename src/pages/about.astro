---
import Layout from "../layouts/Layout.astro";
import Header from "../components/shared/Header.astro";
import Breadcrumbs from "../components/shared/Breadcrumbs.astro";
import AboutMe from "../components/About.astro";
import Awards from "../components/Awards.astro";
import Process from "../components/Process.astro";
import Footer from "../components/shared/Footer.astro";
import Faqs from "../components/Faqs.astro";
import Cta from "../components/Cta.astro";
import { SITE_ORIGIN } from "../lib/regions";
import { breadcrumbSchema } from "../lib/breadcrumbs";

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Денис Митрофанов",
    "jobTitle": "Разработчик ИИ и LLM",
    "url": new URL("/about", SITE_ORIGIN).href,
    "worksFor": { "@id": `${SITE_ORIGIN}/#organization` },
    "sameAs": [
        "https://t.me/W1DO_DIGITAL",
        "https://www.youtube.com/@w1do_digital"
    ]
};
const pageBreadcrumbs = breadcrumbSchema([
    { name: "Главная", path: "/" },
    { name: "Об агентстве", path: "/about" }
]);

---
<Layout 
    title="Об агентстве AiCRAFT | Разработка и внедрение ИИ-агентов"
    description="AiCRAFT помогает компаниям запускать ИИ-агентов, проектировать agent harness и развёртывать Claude Code для команд разработки."
    keywords="AiCRAFT, агентство ИИ, разработка ИИ-агентов, инфраструктура Claude Code"
    image="/images/og-about.jpg"
    schema={[personSchema, pageBreadcrumbs]}
>
    <Header/>
    <Breadcrumbs 
        title="Об агентстве AiCRAFT"
        breadcrumbItems={[
            { label: "Главная", href: "/" },
            { label: "Об агентстве", active: true }
        ]} 
    />
    
    <AboutMe 
        subTitle="Об агентстве"
        title="Помогаем компаниям внедрять ИИ в рабочие процессы"
        description="AiCRAFT проектирует агентов для процессов, где нужно читать документы, работать с CRM и выполнять согласованные действия. Технический профиль агентства включает разработку LLM-приложений и настройку интеграций. Для инженерных команд помогаем развернуть <a href='/consultation/claude-cursor-setup'>инфраструктуру Claude Code</a>."
        counterValue="3"
        counterTag="Направления работы"
        counterDescription="Агенты, инфраструктура и интеграции для рабочих процессов."
    />

    <Process 
        subTitle="Как мы работаем"
        title="Определяем границы проекта до разработки"
        description="Согласуем результат, владельца процесса и условия доступа. По итогам пилота вы сможете решить, стоит ли расширять сценарий."
        step1Title="Бизнес-задача"
        step1Desc="Разбираем текущий процесс и определяем, как проверить результат."
        step2Title="Архитектура"
        step2Desc="Уточняем интеграции, доступы и правила работы с данными."
        step3Title="Пилот"
        step3Desc="Проверяем типовые задачи, исключения и обработку ошибок."
        step4Title="Передача"
        step4Desc="Документируем настройки и согласуем поддержку после запуска."
    />

    <Awards 
        subTitle="Инструментарий"
        title="Инструменты для разных этапов проекта"
        description="Подбираем модель, интеграции и среду запуска по задачам, требованиям к данным и условиям эксплуатации."
        counterValue=""
        counterDesc=""
        awards={[
            {
                icon: '/images/llm/claude-color.svg',
                title: 'Claude Code',
                description: 'Общие настройки репозиториев, интеграции и проверки для команд разработки.',
                year: 'CI'
            },
            {
                icon: '/images/llm/gemini-color.svg',
                title: 'Языковые модели',
                description: 'Подбираем модель по типу данных, результатам проверки и условиям эксплуатации.',
                year: 'LLM'
            },
            {
                icon: '/images/llm/openai.svg',
                title: 'Agent harness',
                description: 'Среда для управления контекстом, правами, инструментами и исполнением задач агента.',
                year: 'MCP'
            }
        ]}
        sliderText="Материалы AiCRAFT об ИИ и автоматизации"
        showSocialLinks={true}
    />

    <Faqs/>
    <Cta 
        title="Обсудим проект вашей компании"
        description="Расскажите о задаче и системах, которыми уже пользуется команда. Предложим первый сценарий для проверки."
    />
    <Footer/>
</Layout>