---
import { getServiceHubs } from '../lib/server/w1do/services';
import Header from "../components/shared/Header.astro";
import IntroVideo from "../components/IntroVideo.astro";
import Feature from "../components/Feature.astro";
import Faqs from "../components/Faqs.astro";
import { breadcrumbSchema } from "../lib/breadcrumbs";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/shared/Footer.astro";
import Breadcrumbs from "../components/shared/Breadcrumbs.astro";
import ServicesList from "../components/services/ServicesList.astro";
import ServiceCard from "../components/services/ServiceCard.astro";
import Projects from "../components/projects/Projects.astro";
import Spacer from "../components/shared/Spacer.astro";
import Pricing from "../components/Pricing.astro";
import About from "../components/About.astro";
import Choose from "../components/Choose.astro";
import Process from "../components/Process.astro";
import Testimonials from "../components/Testimonials.astro";
import Cta from "../components/Cta.astro";
import SeoText from "../components/shared/SeoText.astro";
import { formatRubleAmount, STARTING_PROJECT_PRICE } from "../lib/pricing";

const entries = await getServiceHubs();
const services = entries.map((service) => ({
    ...service,
    link: service.url,
    delay: `${(parseInt(service.no || "0") - 1) * 0.2}s`
}));

// Три направления, с которых начинают большинство проектов.
const startDirections = [
    {
        no: "01",
        title: "Разработка ИИ-агентов под ключ",
        description: "Проектируем сценарий, подключаем данные и рабочие системы, проверяем агента на ваших примерах и передаём команде.",
        icon: "/images/icon-service-1.svg",
        tags: ["ИИ-агенты", "Пилот"],
        link: "/ai-agents",
    },
    {
        no: "02",
        title: "Архитектура ИИ-систем и agent harness",
        description: "Определяем, где работает модель, как хранятся данные и какие инструменты получает агент, чтобы действие можно было проверить.",
        icon: "/images/icon-service-4.svg",
        tags: ["Архитектура", "Инфраструктура"],
        link: "/services/ai-solution-architecture",
    },
    {
        no: "03",
        title: "Инфраструктура Claude Code для команд",
        description: "Настраиваем общие правила работы в репозиториях, MCP-инструменты, разрешения и автоматические проверки для разработчиков.",
        icon: "/images/icon-service-6.svg",
        tags: ["Claude Code", "Разработка"],
        link: "/consultation/claude-cursor-setup",
    },
];

const servicesFaqs = [
    {
        question: "Чем услуга по внедрению ИИ отличается от разработки агента?",
        answer: "Внедрение начинается с процесса и людей: разбираем, где теряется время, какие данные нужны и кто принимает решение. Агент — один из инструментов внутри этого проекта. Можно заказать только разработку, если сценарий и требования уже описаны.",
    },
    {
        question: "Можно ли начать с одной услуги, а не с полного внедрения?",
        answer: "Да. Первым шагом берут консультацию или аудит процесса: на нём фиксируем задачу, ограничения и критерии результата. Дальше решаете, запускать пилот сразу или сначала проверить сценарий на одном отделе.",
    },
    {
        question: "Какие услуги нужны, если у нас уже есть прототип агента?",
        answer: "Смотрим, что уже работает, а чего не хватает: доступов к системам, проверки ответов, обработки ошибок или среды запуска. После разбора предлагаем доработку прототипа, интеграции или настройку эксплуатации.",
    },
    {
        question: "Кто настраивает доступы к CRM, 1С и базе знаний?",
        answer: "Доступы выдаёт ваша сторона, мы описываем, какие именно права нужны агенту. В тестовой среде проверяем работу с теми же правами, что будут на проде, и фиксируем, какие действия остаются за сотрудником.",
    },
    {
        question: "Что происходит, если агент ошибается?",
        answer: "Для каждого сценария заранее определяем, что считается ошибкой и когда вопрос передаётся человеку. На пилоте разбираем такие случаи вместе с командой, уточняем правила и добавляем проверки перед действием.",
    },
    {
        question: "Как считается стоимость услуг по внедрению ИИ?",
        answer: "На смету влияют число сценариев, состояние данных, сложность интеграций и объём проверки. Отдельно оцениваем аудит, пилот, внедрение и стоимость работы модели после запуска. Предварительный расчёт можно получить в калькуляторе.",
    },
    {
        question: "Кому передаётся решение после запуска?",
        answer: "Команде заказчика: показываем, как проверить ответ агента, где посмотреть журнал действий и как сообщить о проблеме. При необходимости договариваемся о сопровождении и обновлении базы знаний.",
    },
];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": servicesFaqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
    }))
};

const pageBreadcrumbs = breadcrumbSchema([
    { name: "Главная", path: "/" },
    { name: "Услуги", path: "/services" }
]);

const testimonials = [
    {
        rating: 5,
        text: "Заказывал разработку RAG-системы для техподдержки. Денис внедрил решение, которое теперь отвечает на 80% запросов по нашей документации. Точность ответов поразительная, а нагрузка на живых операторов снизилась в три раза. Очень профессиональный подход.",
        authorName: "Алексей Волков",
        authorRole: "Технический директор SaaS-сервиса",
        authorImage: "/images/author-3.jpg"
    },
    {
        rating: 5,
        text: "Как разработчик ИИ, Денис помог нам автоматизировать анализ юридических документов. То, на что раньше уходило 2 дня работы юриста, теперь ИИ делает за 5 минут. Внедрение окупилось за первый же месяц работы. Рекомендую как сильного эксперта.",
        authorName: "Марина Соколова",
        authorRole: "Основатель юридической фирмы",
        authorImage: "/images/author-4.jpg"
    },
    {
        rating: 5,
        text: "Внедрение ИИ-агентов в наш отдел продаж стало прорывом. Теперь квалификация лидов происходит автоматически через Telegram. Денис спроектировал систему так, что она общается как живой человек и сразу заносит данные в CRM. Скорость обработки выросла на 40%.",
        authorName: "Дмитрий Кравцов",
        authorRole: "CEO рекламного агентства",
        authorImage: "/images/author-1.jpg"
    }
];
const offerFormId = "services-offer-request";
---

<Layout
    bodyClass="services-page"
    title="Услуги по внедрению ИИ в бизнес и разработка ИИ-агентов | AiCRAFT"
    description="Внедряем ИИ в бизнес: разрабатываем ИИ-агентов, подключаем CRM, 1С и базу знаний, автоматизируем поддержку, продажи и документы. Аудит, пилот, запуск."
    keywords="услуги по внедрению ии в бизнес, внедрение ии в бизнес, разработка ии агентов, ии агенты для бизнеса, автоматизация бизнес процессов с помощью ии, интеграция ии в бизнес, заказать ии агента, внедрение ии агентов"
    image="/images/og-services.jpg"
    schema={[pageBreadcrumbs, faqSchema]}
>
    <Header/>
    <Breadcrumbs title="Услуги по внедрению ИИ в бизнес" breadcrumbItems={[
        {label: "Главная", href: "/"},
        {label: "Услуги", active: true}
    ]}/>
    <section class="container mb-5 services-intro" aria-labelledby="service-directions">
        <div class="section-title">
            <span class="section-sub-title wow fadeInUp">С чего начать</span>
            <h2 id="service-directions">Три направления, с которых начинают проекты</h2>
            <p class="wow fadeInUp" data-wow-delay="0.2s">Выберите, что требуется вашей команде — запустить агента, спроектировать среду его работы или настроить Claude Code. Если задача ещё не сформулирована, начните с разбора процесса.</p>
        </div>
        <div class="page-services services-start">
            <div class="row">
                {startDirections.map((direction) => (
                    <div class="col-xl-4 col-md-6">
                        <ServiceCard {...direction} isListPage={true} />
                    </div>
                ))}
            </div>
        </div>
    </section>
    <section class="container mb-5" aria-labelledby="service-catalog">
        <div class="section-title">
            <span class="section-sub-title wow fadeInUp">Каталог</span>
            <h2 id="service-catalog">Все услуги по ИИ и автоматизации</h2>
            <p class="wow fadeInUp" data-wow-delay="0.2s">Каждая услуга — отдельный проект со своим результатом. Их можно собрать в один маршрут: от аудита процесса до сопровождения агента в рабочих системах.</p>
        </div>
        <ServicesList services={services} isListPage={true} />
    </section>
    <About
        subTitle="Об агентстве AiCRAFT"
        title="Кто отвечает за внедрение ИИ в вашем процессе"
        description="Вместе с сотрудниками разбираем процесс и выясняем, на каких шагах уходит время. Мы отвечаем за разработку агента, подключение к вашим системам и проверку на рабочих примерах. После запуска передаём команде инструкции и согласуем сопровождение."
        counterValue="100"
        counterTag="Разработанных ИИ-систем"
        counterDescription="для работы с обращениями, документами и данными"
    />
    <Choose
        subTitle="Границы автоматизации"
        title="Что агент делает сам, а что остаётся за сотрудником"
        description="До запуска согласуем, какие действия агент выполняет без подтверждения, а где обращается к человеку. Например, при запросе на возврат он может найти заказ и сверить условия, а решение о выплате принимает сотрудник."
        benefit1Title="Права на действия"
        benefit1Desc="Указываем, какие записи агент может читать и менять. Для важных операций добавляем запрос на подтверждение сотрудника."
        benefit2Title="Передача сложных случаев"
        benefit2Desc="Если в справочнике нет ответа или клиент сообщает противоречивые данные, агент передаёт вопрос сотруднику вместе с историей обращения."
        priceTitle="Аудит процесса"
        priceDesc="Начинаем с разбора одной операции: фиксируем шаги, данные и критерии результата, чтобы проверить сценарий до разработки."
        priceValue={formatRubleAmount(STARTING_PROJECT_PRICE)}
    />
    <Process
        subTitle="Порядок работы"
        title="Как проходит проект по внедрению ИИ"
        description="Берём один типичный запрос и проходим его вместе с будущими пользователями. Так у команды есть пример, по которому можно проверить работу агента на каждом этапе."
        step1Title="Разбор процесса"
        step1Desc="Фиксируем исходные данные, ручные операции и признаки правильного результата."
        step2Title="Проектирование"
        step2Desc="Составляем схему интеграций. Для каждого шага указываем источник данных и нужные права."
        step3Title="Пилот"
        step3Desc="Проверяем прототип на обычных и спорных примерах. Вместе разбираем ошибки и уточняем правила."
        step4Title="Запуск"
        step4Desc="Подключаем рабочие системы, обучаем сотрудников и передаём инструкции по контролю агента."
    />
    <Pricing
        subTitle="Стоимость"
        title="Сколько стоит внедрение ИИ в бизнес"
        description="Оцениваем отдельно аудит, пилот и подключение к рабочим системам. На смету влияют число сценариев, состояние данных и требования к проверке результата."
    />
    <IntroVideo
        subTitle="Практика"
        title="Как оценить пользу ИИ для отдела"
        description="Возьмите типовой договор и засеките, сколько времени юрист ищет в нём расхождения с шаблоном. На пилоте сравните это время с проверкой правок, которые предложил агент. Отдельно отметьте пропуски и ложные замечания."
        tickerItems={["Время обработки", "Ручные операции", "Ошибки", "Проверка результата"]}
    />
    <Feature
        subTitle="Технологии"
        title="Из чего состоит внедрение агента"
        description="Языковая модель разбирает запрос, поиск по базе знаний подбирает документы, а интеграция через API читает или обновляет запись в рабочей системе. Выбор модели и места хранения данных зависит от задачи и правил доступа в компании."
    />
    <Testimonials
        subTitle="Отзывы клиентов"
        title="Что изменилось после внедрения ИИ"
        description="Руководители рассказывают, что изменилось в работе их команд: как поддержка отвечает по документации, юристы проверяют договоры, а отдел продаж обрабатывает обращения из Telegram."
        testimonials={testimonials}
    />
    <Projects
        subTitle="Портфолио"
        title="Примеры внедрения ИИ в бизнес"
        description="В проектах можно посмотреть, с какой задачи началась разработка и какую часть работы поручили системе. Сравните эти примеры со своим процессом, чтобы понять, что стоит проверить на первом пилоте."
        filterAi="Нейросети"
        filterAutomation="ИИ-агенты"
    />
    <Faqs
        subTitle="Вопросы об услугах"
        title="Что уточнить перед выбором услуги"
        description="Собрали вопросы, которые задают до старта: чем отличаются услуги, что делать с готовым прототипом и как устроен контроль работы агента."
        customFaqs={servicesFaqs}
    />
    <SeoText labelledBy="services-seo-title">
            <h2 id="services-seo-title">Услуги по внедрению ИИ в бизнес: что входит в проект</h2>
            <p>Внедрение ИИ начинается не с выбора модели, а с процесса. Мы разбираем, как задача выполняется сейчас, какие данные нужны сотруднику и по какому признаку он понимает, что результат верный. Из этого разбора появляется сценарий, который можно поручить агенту и проверить на ваших примерах.</p>
            <p>Услуга включает аудит процесса, выбор сценария, проектирование интеграций, сборку прототипа, пилот и запуск в рабочих системах. Отдельно можно заказать только консультацию, только разработку агента или настройку инфраструктуры — состав работ фиксируем до старта.</p>
            <ul>
                <li>Аудит процесса и карта сценариев автоматизации.</li>
                <li>Проектирование архитектуры: модель, база знаний, инструменты, права доступа.</li>
                <li>Разработка и проверка агента на типовых и спорных примерах.</li>
                <li>Интеграции с CRM, 1С, мессенджерами и внутренними сервисами.</li>
                <li>Передача инструкций команде и согласование сопровождения.</li>
            </ul>

            <h2>Разработка ИИ-агентов для бизнеса</h2>
            <p>ИИ-агенты для бизнеса отличаются от чат-ботов тем, что не только отвечают, но и выполняют действия: читает запись в CRM, готовит документ, меняет статус обращения. Для этого у него есть доступ к согласованным инструментам и правила, по которым он действует. Ответ чат-бота можно переписать, действие агента в рабочей системе нужно проверять до запуска.</p>
            <h3>Агент поддержки клиентов</h3>
            <p>Отвечает по регламентам и документации, показывает источник ответа и передаёт оператору случаи, где нет подтверждённых данных. Мы заранее определяем, какие темы агент закрывает сам, а какие сразу уходят человеку.</p>
            <h3>Агент для продаж и обработки заявок</h3>
            <p>Агент для отдела продаж разбирает входящее обращение, уточняет потребность и заполняет карточку в CRM. Отдельно проверяем, что повторная обработка не создаёт дубль, а спорные заявки не теряются между менеджерами.</p>
            <h3>Агент для документов и внутренних процессов</h3>
            <p>Сверяет договор с шаблоном, находит расхождения, готовит выгрузку или черновик ответа. Сотрудник проверяет результат перед отправкой — агент не подменяет решение, а сокращает ручную работу.</p>

            <h2>Интеграция ИИ с CRM, 1С и мессенджерами</h2>
            <p>Агент работает внутри ваших систем, поэтому интеграция — обязательная часть проекта. Смотрим, какие объекты доступны через API или штатный обмен, можно ли их менять и как часто обновляются данные. В тестовой среде проверяем доступ с теми же правами, которые получит агент на проде.</p>
            <p>Отдельные услуги по этому направлению: <a href="/services/ai-integration-1c-crm">интеграция с 1С и CRM</a> и <a href="/services/ai-integration">внедрение ИИ в бизнес-процессы</a>. Если системы закрыты, разбираем, можно ли исключить часть данных или выполнять обработку внутри вашей инфраструктуры.</p>

            <h2>Автоматизация бизнес-процессов с помощью ИИ</h2>
            <p>Автоматизация бизнес-процессов с помощью ИИ имеет смысл там, где операция повторяется, а результат можно проверить. Если сотрудники каждый раз принимают решение по-разному и правил нет, сначала придётся их сформулировать — иначе агент будет повторять ошибки, только быстрее.</p>
            <p>Признаки процесса, который стоит автоматизировать:</p>
            <ul>
                <li>Одинаковые действия повторяются каждый день и занимают часы.</li>
                <li>Есть примеры, по которым видно правильный результат.</li>
                <li>Данные хранятся в системе с доступом через API.</li>
                <li>Ошибку можно заметить до того, как она уйдёт клиенту.</li>
            </ul>
            <p>Начинаем с одной операции и одного отдела. Когда пилот показывает результат, подключаем следующие маршруты — так команда успевает привыкнуть к новой роли агента.</p>

            <h2>Стоимость услуг по внедрению ИИ</h2>
            <p>Заказать ИИ-агента «под ключ» обычно означает весь маршрут: аудит, разработку и запуск. Мы считаем эти этапы отдельно, чтобы было видно, за что платит заказчик. Смета зависит от числа сценариев, состояния данных, сложности интеграций и объёма проверки. Отдельно считаем работу модели и инфраструктуру после запуска: эти расходы остаются на стороне заказчика и зависят от количества запросов.</p>
            <ul>
                <li>Аудит и roadmap — оценка эффекта и план внедрения.</li>
                <li>Пилот — проверка сценария на ограниченном участке.</li>
                <li>Внедрение — подключение рабочих систем и обучение сотрудников.</li>
                <li>Сопровождение — обновление базы знаний и добавление сценариев.</li>
            </ul>
            <p>Форматы работ и ориентиры по стоимости собраны на странице <a href="/pricing">цен на внедрение ИИ</a>.</p>

            <h2>Как выбрать подрядчика по внедрению ИИ</h2>
            <p>Спрашивайте не про модели, а про процесс: кто разбирает задачу, как проверяется результат и что происходит при ошибке. Подрядчик, который начинает с демонстрации возможностей, а не с ваших примеров, скорее продаёт технологию, чем решает задачу.</p>
            <ul>
                <li>Какие примеры вы возьмёте для проверки пилота?</li>
                <li>Что входит в пилот, а что оплачивается отдельно?</li>
                <li>Кто отвечает за доступы и обработку персональных данных?</li>
                <li>Как будет устроен контроль действий агента после запуска?</li>
            </ul>

            <h2>Кому подходят услуги</h2>
            <p>ИИ-агенты для бизнеса нужны там, где есть повторяющиеся операции и собственные данные. Разрабатываем ИИ-системы для поддержки, продаж, юридических и финансовых задач, производства и электронной коммерции. Команда работает с компаниями, где есть повторяющиеся операции, собственные данные и ИТ-специалисты, которые могут выдать доступы. Примеры таких проектов собраны в <a href="/case">кейсах</a>.</p>
            <p>Если не уверены, с чего начать, опишите одну операцию, которая отнимает время у команды. На разборе определим, подходит ли она для агента и что понадобится для оценки — <a href="/contact">оставьте заявку</a>.</p>
