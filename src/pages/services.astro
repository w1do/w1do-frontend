---
import { getServiceHubs } from '../lib/server/w1do/services';
import Header from "../components/shared/Header.astro";
import IntroVideo from "../components/IntroVideo.astro";
import Feature from "../components/Feature.astro";
import Faqs from "../components/Faqs.astro";
import { breadcrumbSchema } from "../lib/breadcrumbs";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/shared/Footer.astro";
import Breadcrumbs from "../components/shared/Breadcrumbs.astro";
import ServicesList from "../components/services/ServicesList.astro";
import Projects from "../components/projects/Projects.astro";
import Spacer from "../components/shared/Spacer.astro";
import Pricing from "../components/Pricing.astro";

const entries = await getServiceHubs();
const services = entries.map((service) => ({
    ...service,
    link: service.url,
    delay: `${(parseInt(service.no || "0") - 1) * 0.2}s`
}));
const pageBreadcrumbs = breadcrumbSchema([
    { name: "Главная", path: "/" },
    { name: "Услуги", path: "/services" }
]);

---

<Layout 
    title="Услуги AiCRAFT | ИИ-агенты, agent harness и Claude Code"
    description="Услуги по разработке ИИ-агентов, подключению CRM, 1С и баз знаний. Настройка agent harness и инфраструктуры Claude Code для команд."
    keywords="внедрение ии в бизнес, услуги ии, разработка ии агентов, автоматизация бизнеса, интеграции crm"
    image="/images/og-services.jpg"
    schema={pageBreadcrumbs}
>
    <Header/>
    <Breadcrumbs title="Услуги по внедрению ИИ в бизнес" breadcrumbItems={[
        {label: "Главная", href: "/"},
        {label: "Услуги", active: true}
    ]}/>
    <section class="container mb-5" aria-labelledby="service-directions">
        <div class="section-title">
            <h2 id="service-directions">Основные направления</h2>
            <p>Выберите, что требуется вашей команде — запустить агента, спроектировать среду его работы или настроить Claude Code.</p>
        </div>
        <ul>
            <li><a href="/ai-agents">Разработка ИИ-агентов под ключ</a></li>
            <li><a href="/services/ai-solution-architecture/ai-agent-development">Разработка agent harness</a></li>
            <li><a href="/consultation/claude-cursor-setup">Инфраструктура Claude Code для команд</a></li>
        </ul>
    </section>
    <ServicesList services={services} isListPage={true} />
    <Pricing/>
    <IntroVideo/>
    <Feature/>
    <Faqs/>
    <Projects/>
    <Spacer/>
    <Footer/>
</Layout>
