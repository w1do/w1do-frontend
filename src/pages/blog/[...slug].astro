---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { parseFragment, serialize, type DefaultTreeAdapterMap } from "parse5";
import { canonicalCmsHtml } from "../../lib/server/regional-html";
import { getBlogCanonicalPaths, getBlogPostBySlug } from "../../lib/server/w1do/blog";
import BlogLayout from "../../layouts/BlogLayout.astro";
import Layout from "../../layouts/Layout.astro";

type HtmlNode = DefaultTreeAdapterMap["node"];
type HtmlElement = DefaultTreeAdapterMap["element"];

const sectionIdPattern = /^section-[a-z0-9-]+$/;
const headingTagPattern = /^h[2-6]$/;
const sectionAnchorAttribute = "data-section-anchor";

function* htmlElements(node: HtmlNode): IterableIterator<HtmlElement> {
  if ("tagName" in node) yield node;
  if ("childNodes" in node) {
    for (const child of node.childNodes) yield* htmlElements(child);
  }
}

function headingText(node: HtmlNode): string {
  if ("value" in node) return node.value;
  return "childNodes" in node ? node.childNodes.map(headingText).join("") : "";
}

export const prerender = false;
let entry;
let failed = false;
try {
  const path = Astro.params.slug || "";
  const slug = path.split("/").pop() || "";
  const lookupSlug = slug === "ai-agent-engineering" ? "engineering" : slug;
  entry = await getBlogPostBySlug(lookupSlug);
  if (entry && `/blog/${path}` !== entry.url) {
    if (path === slug || path === "ai-agents/ai-agent-engineering") {
      return Astro.redirect(`${entry.url}${Astro.url.search}`, 301);
    }
    entry = undefined;
  }
} catch {
  failed = true;
}
if (!entry) Astro.response.status = failed ? 502 : 404;
const processor = entry ? await createMarkdownProcessor() : undefined;
let bodyHtml = entry && processor ? (await processor.render(entry.body)).code : "";
const sections: Array<{ id: string; title: string }> = [];
if (entry) {
  bodyHtml = canonicalCmsHtml(bodyHtml, entry.url, await getBlogCanonicalPaths());
  const fallbackIds = new Map<string, string>();
  for (const block of entry.blocks) {
    const title = block.title.trim();
    const id = `section-${block.id.toLowerCase().replace(/[^a-z0-9-]/g, "")}`;
    if (title && sectionIdPattern.test(id) && !fallbackIds.has(title)) fallbackIds.set(title, id);
  }
  const fragment = parseFragment(bodyHtml);
  const elements = [...htmlElements(fragment)];
  const headings = elements.filter((element) => headingTagPattern.test(element.tagName));
  const explicitHeadings = new Map<HtmlElement, string>();
  for (const heading of headings) {
    if (!heading.attrs.some((attribute) => attribute.name === sectionAnchorAttribute)) continue;
    const id = heading.attrs.find((attribute) => attribute.name === "id")?.value;
    if (!id || !sectionIdPattern.test(id)) continue;
    heading.attrs = heading.attrs.filter((attribute) => attribute.name !== sectionAnchorAttribute);
    explicitHeadings.set(heading, id);
  }
  const explicitIds = new Set(explicitHeadings.values());
  const sectionHeadings = new Map<string, HtmlElement>();
  for (const heading of headings) {
    const title = headingText(heading).replace(/\u00a0/g, " ").trim();
    const authoredId = explicitHeadings.get(heading);
    const fallbackId = fallbackIds.get(title);
    const id = authoredId ?? (fallbackId && !explicitIds.has(fallbackId) ? fallbackId : undefined);
    if (!id || sectionHeadings.has(id)) continue;
    const attribute = heading.attrs.find((item) => item.name === "id");
    if (attribute) attribute.value = id;
    else heading.attrs.push({ name: "id", value: id });
    sectionHeadings.set(id, heading);
    if (title) sections.push({ id, title });
  }
  if (sectionHeadings.size) {
    for (const element of elements) {
      element.attrs = element.attrs.filter((attribute) => {
        const heading = attribute.name === "id" && sectionHeadings.get(attribute.value);
        return !heading || heading === element;
      });
    }
    bodyHtml = serialize(fragment);
  }
}
---

{entry ? (
  <BlogLayout frontmatter={entry.data}>
    {sections.length > 0 && (
      <nav class="article-toc" aria-label="Содержание статьи">
        <p class="article-toc__title">Содержание</p>
        <ul>
          {sections.map(section => (
            <li><a href={`#${section.id}`}>{section.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <div set:html={bodyHtml} />
    <style>
      .article-toc { margin: 0 0 36px; }
      .article-toc__title { margin: 0 0 8px; color: var(--white-color); font-weight: 700; }
      .article-toc ul { margin: 0; padding-left: 22px; }
      .article-toc li { padding-left: 2px; color: var(--text-color); }
      .article-toc a { color: var(--accent-color); line-height: 1.6; text-decoration: underline; text-decoration-color: currentColor; text-underline-offset: 3px; transition: color .2s ease, text-decoration-thickness .2s ease; }
      .article-toc a:hover, .article-toc a:focus-visible { color: var(--white-color); text-decoration-thickness: 2px; }
      :global(.post-entry h2[id], .post-entry h3[id], .post-entry h4[id], .post-entry h5[id], .post-entry h6[id]) { scroll-margin-top: 110px; }
      @media (max-width: 767px) { .article-toc { margin-bottom: 28px; } }
    </style>
  </BlogLayout>
) : (
  <Layout title={failed ? "Блог временно недоступен" : "Статья не найдена"} robots="noindex,follow">
    <main class="container" style="padding: 6rem 1rem;">
      <h1>{failed ? "Блог временно недоступен" : "Статья не найдена"}</h1>
      <p>{failed ? "Попробуйте открыть страницу позже." : "Статья не опубликована или адрес указан неверно."}</p>
      <a href="/blog">Вернуться в блог</a>
    </main>
  </Layout>
)}
