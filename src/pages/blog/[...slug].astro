---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { getBlogPostBySlug } from "../../lib/server/w1do/blog";
import BlogLayout from "../../layouts/BlogLayout.astro";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;
let entry;
let failed = false;
try {
  const path = Astro.params.slug || "";
  const slug = path.split("/").pop() || "";
  const lookupSlug = slug === "ai-agent-engineering" ? "engineering" : slug;
  entry = await getBlogPostBySlug(lookupSlug);
  if (entry && `/blog/${path}` !== entry.url) {
    if (path === slug || path === "ai-agents/ai-agent-engineering") {
      return Astro.redirect(`${entry.url}${Astro.url.search}`, 301);
    }
    entry = undefined;
  }
} catch {
  failed = true;
}
if (!entry) Astro.response.status = failed ? 502 : 404;
const processor = entry ? await createMarkdownProcessor() : undefined;
let bodyHtml = entry && processor ? (await processor.render(entry.body)).code : "";
const sections = new Map<string, { id: string; title: string }>();
if (entry) {
  for (const block of entry.blocks) {
    if (!sections.has(block.title.trim())) sections.set(block.title.trim(), {
      id: `section-${block.id.toLowerCase().replace(/[^a-z0-9-]/g, "")}`,
      title: block.title.trim(),
    });
  }
  const linkedSections = new Set<string>();
  bodyHtml = bodyHtml.replace(/<(h[2-6])\b([^>]*)>([\s\S]*?)<\/\1>/gi, (heading, tag, attributes, content) => {
    const title = content.replace(/<[^>]*>/g, "").replace(/&nbsp;/g, " ").trim();
    const section = sections.get(title);
    if (!section || linkedSections.has(section.id)) return heading;
    linkedSections.add(section.id);
    const cleanAttributes = attributes.replace(/\s+id=(?:"[^"]*"|'[^']*'|[^\s>]+)/i, "");
    return `<${tag}${cleanAttributes} id="${section.id}">${content}</${tag}>`;
  });
  for (const [title, section] of sections) {
    if (!linkedSections.has(section.id)) sections.delete(title);
  }
}
---

{entry ? (
  <BlogLayout frontmatter={entry.data}>
    {sections.size > 0 && (
      <nav class="article-toc" aria-label="Содержание статьи">
        <p class="article-toc__title">Содержание</p>
        <ul>
          {[...sections.values()].map(section => (
            <li><a href={`#${section.id}`}>{section.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <div set:html={bodyHtml} />
    <style>
      .article-toc { margin: 0 0 36px; }
      .article-toc__title { margin: 0 0 8px; color: var(--white-color); font-weight: 700; }
      .article-toc ul { margin: 0; padding-left: 22px; }
      .article-toc li { padding-left: 2px; color: var(--text-color); }
      .article-toc a { color: var(--accent-color); line-height: 1.6; text-decoration: underline; text-decoration-color: currentColor; text-underline-offset: 3px; transition: color .2s ease, text-decoration-thickness .2s ease; }
      .article-toc a:hover, .article-toc a:focus-visible { color: var(--white-color); text-decoration-thickness: 2px; }
      :global(.post-entry h2[id], .post-entry h3[id], .post-entry h4[id], .post-entry h5[id], .post-entry h6[id]) { scroll-margin-top: 110px; }
      @media (max-width: 767px) { .article-toc { margin-bottom: 28px; } }
    </style>
  </BlogLayout>
) : (
  <Layout title={failed ? "Блог временно недоступен" : "Статья не найдена"} robots="noindex,follow">
    <main class="container" style="padding: 6rem 1rem;">
      <h1>{failed ? "Блог временно недоступен" : "Статья не найдена"}</h1>
      <p>{failed ? "Попробуйте открыть страницу позже." : "Статья не опубликована или адрес указан неверно."}</p>
      <a href="/blog">Вернуться в блог</a>
    </main>
  </Layout>
)}
