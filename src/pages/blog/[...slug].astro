---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { getBlogPostBySlug } from "../../lib/server/w1do/blog";
import BlogLayout from "../../layouts/BlogLayout.astro";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;
let entry;
let failed = false;
try {
  const path = Astro.params.slug || "";
  const slug = path.split("/").pop() || "";
  const lookupSlug = slug === "ai-agent-engineering" ? "engineering" : slug;
  entry = await getBlogPostBySlug(lookupSlug);
  if (entry && `/blog/${path}` !== entry.url) {
    if (path === slug || path === "ai-agents/ai-agent-engineering") {
      return Astro.redirect(`${entry.url}${Astro.url.search}`, 301);
    }
    entry = undefined;
  }
} catch {
  failed = true;
}
if (!entry) Astro.response.status = failed ? 502 : 404;
const processor = entry ? await createMarkdownProcessor() : undefined;
const bodyHtml = entry && processor ? (await processor.render(entry.body)).code : "";
---

{entry ? (
  <BlogLayout frontmatter={entry.data}>
    <div set:html={bodyHtml} />
  </BlogLayout>
) : (
  <Layout title={failed ? "Блог временно недоступен" : "Статья не найдена"} robots="noindex,follow">
    <main class="container" style="padding: 6rem 1rem;">
      <h1>{failed ? "Блог временно недоступен" : "Статья не найдена"}</h1>
      <p>{failed ? "Попробуйте открыть страницу позже." : "Статья не опубликована или адрес указан неверно."}</p>
      <a href="/blog">Вернуться в блог</a>
    </main>
  </Layout>
)}
