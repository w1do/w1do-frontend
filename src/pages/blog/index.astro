---
import BlogTopics from "../../components/blog/BlogTopics.astro";
import { getBlogCategories } from "../../lib/server/w1do/blog-categories";
import { getBlogPosts } from "../../lib/server/w1do/blog";
export const prerender = false;
import { breadcrumbSchema } from "../../lib/breadcrumbs";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/shared/Header.astro";
import Breadcrumbs from "../../components/shared/Breadcrumbs.astro";
import BlogList from "../../components/blog/BlogList.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/shared/Footer.astro";

const POSTS_PER_PAGE = 10;

const [posts, categories] = await Promise.all([getBlogPosts(), getBlogCategories()]);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const totalPages = Math.max(1, Math.ceil(sortedPosts.length / POSTS_PER_PAGE));
const pagePosts = sortedPosts.slice(0, POSTS_PER_PAGE);

const breadcrumbItems = [
    { label: "Главная", href: "/" },
    { label: "Блог", active: true }
];
const pageBreadcrumbs = breadcrumbSchema([
    { name: "Главная", path: "/" },
    { name: "Блог", path: "/blog" }
]);

---

<Layout
    schema={pageBreadcrumbs} title="Блог AiCRAFT об ИИ-агентах и автоматизации" description="Разбираем, как работают ИИ-агенты, как подключать данные и инструменты и как оценивать сценарии перед внедрением.">
    <Header/>
    <Breadcrumbs title="Блог об ИИ-агентах и автоматизации" breadcrumbItems={breadcrumbItems} />
    <BlogTopics categories={categories} />
    <BlogList posts={pagePosts} currentPage={1} totalPages={totalPages} />
    <Cta/>
    <Footer/>
</Layout>
