---
import BlogTopics from "../../../components/blog/BlogTopics.astro";
import { getBlogCategories } from "../../../lib/server/w1do/blog-categories";
import { getBlogPosts } from "../../../lib/server/w1do/blog";
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/shared/Header.astro";
import Breadcrumbs from "../../../components/shared/Breadcrumbs.astro";
import BlogList from "../../../components/blog/BlogList.astro";
import Cta from "../../../components/Cta.astro";
import Footer from "../../../components/shared/Footer.astro";

const POSTS_PER_PAGE = 10;

const [posts, categories] = await Promise.all([getBlogPosts(), getBlogCategories()]);
const sortedPosts = posts;
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const page = Number(Astro.params.page);
if (page === 1) return Astro.redirect("/blog", 301);
if (!/^[1-9][0-9]*$/.test(Astro.params.page || "") || !Number.isSafeInteger(page) || page > totalPages) {
    return Astro.rewrite("/404");
}
const pagePosts = sortedPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE);

const breadcrumbItems = [
    { label: "Главная", href: "/" },
    { label: "Блог", href: "/blog" },
    { label: `Страница ${page}`, active: true }
];
---

<Layout title={`Блог об ИИ и автоматизации — страница ${page} | W1DO`} description={`Страница ${page} блога W1DO: статьи об AI-агентах, разработке и автоматизации. Практические материалы, выбор инструментов и подготовка проектов.`}>
    <Header/>
    <Breadcrumbs title="Наш Блог" breadcrumbItems={breadcrumbItems} />
    <BlogTopics categories={categories} />
    <BlogList posts={pagePosts} currentPage={page} totalPages={totalPages} />
    <Cta/>
    <Footer/>
</Layout>
