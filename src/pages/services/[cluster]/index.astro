---
import ServiceLayout from '../../../layouts/ServiceLayout.astro';
import { getServiceByPath, getServiceSpokes } from '../../../lib/server/w1do/services';

const pillar = await getServiceByPath([Astro.params.cluster || ""]);
if (!pillar?.hub) return Astro.rewrite("/404");
const spokes = await getServiceSpokes(pillar.cluster);
---
<ServiceLayout frontmatter={pillar} spokes={spokes}>
  <div set:html={pillar.bodyHtml} />
</ServiceLayout>
