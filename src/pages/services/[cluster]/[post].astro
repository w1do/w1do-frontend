---
import Layout from "../../../layouts/ServiceLandingLayout.astro";
import { getServiceByPath } from '../../../lib/server/w1do/services';

const entry = await getServiceByPath([Astro.params.cluster || "", Astro.params.post || ""]);
if (!entry || entry.hub) return Astro.rewrite("/404");
---
<Layout frontmatter={entry}>
  <div set:html={entry.bodyHtml} />
</Layout>
