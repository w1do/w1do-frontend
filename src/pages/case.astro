---
import { breadcrumbSchema } from "../lib/breadcrumbs";
import Layout from "../layouts/Layout.astro";
import Header from "../components/shared/Header.astro";
import Breadcrumbs from "../components/shared/Breadcrumbs.astro";
import ProjectsList from "../components/projects/ProjectsList.astro";
import Faqs from "../components/Faqs.astro";
import Footer from "../components/shared/Footer.astro";
import Testimonials from "../components/Testimonials.astro";
import { getCases } from "../lib/server/w1do/cases";

export const prerender = false;

const projects = await getCases();
const pageBreadcrumbs = breadcrumbSchema([
    { name: "Главная", path: "/" },
    { name: "Кейсы", path: "/case" }
]);

---
<Layout
    schema={pageBreadcrumbs} 
    title="Кейсы AiCRAFT | ИИ-агенты, RAG и автоматизация"
    description="Проекты AiCRAFT по внедрению ИИ и автоматизации. Исходные задачи, решения и интеграции с рабочими системами."
    keywords="кейсы ИИ-агентов, проекты RAG, примеры автоматизации процессов"
    image="/images/og-projects.jpg"
>
    <Header/>
    <Breadcrumbs title="Кейсы внедрения ИИ и автоматизации" breadcrumbItems={[
        {label: "Главная", href: "/"},
        {label: "Кейсы", active: true}
    ]}/>
    <ProjectsList projects={projects}/>
    <Faqs/>
    <Testimonials/>
    <Footer/>
</Layout>
