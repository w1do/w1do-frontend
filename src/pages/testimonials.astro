---
import Header from "../components/shared/Header.astro";
import Breadcrumbs from "../components/shared/Breadcrumbs.astro";
import Footer from "../components/shared/Footer.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Отзывы и обратная связь | AiCRAFT"
    description="Расскажите AiCRAFT о работе над вашим проектом. Для знакомства с подходом агентства доступны кейсы внедрения ИИ и автоматизации."
>
    <Header />
    <Breadcrumbs withSchema title="Отзывы и обратная связь" breadcrumbItems={[
        { label: "Главная", href: "/" },
        { label: "Отзывы", active: true },
    ]} />
    <main class="container py-5">
        <div class="section-title">
            <h2>Расскажите о совместной работе</h2>
            <p>Если мы работали над вашим проектом, напишите, какую задачу решали, что получилось и что можно улучшить.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-4">
            <a class="btn-default" href="/contact">Оставить отзыв</a>
            <a href="/case">Посмотреть опубликованные кейсы</a>
        </div>
    </main>
    <Footer />
</Layout>
