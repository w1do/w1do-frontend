---
import { breadcrumbSchema } from "../lib/breadcrumbs";
import Layout from "../layouts/Layout.astro";
import Header from "../components/shared/Header.astro";
import Breadcrumbs from "../components/shared/Breadcrumbs.astro";
import About from "../components/About.astro";
import Feature from "../components/Feature.astro";
import Process from "../components/Process.astro";
import Choose from "../components/Choose.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/shared/Footer.astro";
import IntroVideo from "../components/IntroVideo.astro";
import Spacer from "../components/shared/Spacer.astro";
import HireFaqs from "../components/hire/HireFaqs.astro";
import DevPricing from "../components/pricing/DevPricing.astro";

const pageBreadcrumbs = breadcrumbSchema([
    { name: "Главная", path: "/" },
    { name: "Цены", path: "/pricing" }
]);

---

<Layout 
    title="Стоимость разработки ИИ-агентов и интеграций | AiCRAFT"
    description="Форматы работы AiCRAFT и факторы стоимости: сценарии агента, объём данных, интеграции с CRM и 1С, проверки и сопровождение после запуска."
    keywords="стоимость разработки ии-агентов, цена внедрения ии-агента, оценка интеграции, бюджет пилота"
    schema={pageBreadcrumbs}
>
    <Header/>
    
    <Breadcrumbs 
        title="Стоимость внедрения ИИ"
        breadcrumbItems={[
            { label: "Главная", href: "/" },
            { label: "Цены", active: true }
        ]}
    />

    <About 
        subTitle="Форматы проекта"
        title="Из чего складывается смета"
        description="Смета зависит от числа сценариев, качества данных, доступных API и объёма проверок. На старте обсуждаем, что входит в пилот и какие расходы будут регулярными после запуска."
        counterValue="2"
        counterTag="Статьи расходов"
        counterDescription="Уточняем работы и инфраструктурные расходы отдельно."
    />

    <DevPricing />

    <Feature 
        subTitle="Состав работ"
        title="Что оцениваем перед разработкой"
        description="Уточняем необходимое число интеграций, источники данных, требования к доступам и процедуру проверки действий. Отдельно оцениваем сопровождение."
    />

    <IntroVideo 
        subTitle="Инфраструктура"
        title="Модели, данные и интеграции"
        tickerItems={["Claude", "Gemini", "Llama", "Pinecone / Weaviate", "n8n / LangChain", "MCP (Model Context Protocol)"]}
    />

    <div class="bg-section">
        <Process 
            subTitle="Ход проекта"
            title="Как уточняется объём внедрения"
            description="Уточняем сроки и работы по итогам проверок на ваших сценариях."
            step1Title="Оценка задачи"
            step1Desc="Изучаем процесс, данные и ограничения на использование моделей."
            step2Title="Прототипирование"
            step2Desc="Собираем прототип для проверки согласованного сценария."
            step3Title="Интеграция"
            step3Desc="Подключаем согласованные API, источники данных и инструменты."
            step4Title="Запуск"
            step4Desc="Проверяем реализацию, передаём инструкции и согласуем сопровождение."
        />
    </div>

    <Choose 
        subTitle="Расходы после запуска"
        title="Что учитывать в бюджете эксплуатации"
        description="Отдельно обсуждаем стоимость вызовов моделей, хранение данных, мониторинг и работу с инцидентами."
        benefit1Title="Оплата инфраструктуры"
        benefit1Desc="Расходы на модель и инфраструктуру зависят от объёма задач и требований к запуску."
        benefit2Title="Роль команды"
        benefit2Desc="Уточняем, кто проверяет спорные результаты, обновляет источники и следит за интеграциями."
    />

    <HireFaqs />
    
    <Spacer height="120px" />

    <Cta 
        subTitle="Оценка проекта"
        title="Рассчитаем стоимость под вашу задачу"
        description="Опишите процесс и используемые системы. Уточним требования и подготовим предложение с составом работ."
        formTitle="Запросить расчёт"
    />

    <Spacer/>

    <Footer/>
</Layout>
