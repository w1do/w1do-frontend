---
import Breadcrumbs from "../components/shared/Breadcrumbs.astro";
import Cta from "../components/Cta.astro";
import Faqs from "../components/Faqs.astro";
import Footer from "../components/shared/Footer.astro";
import Header from "../components/shared/Header.astro";
import Process from "../components/Process.astro";
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../lib/breadcrumbs";
import { INDIVIDUAL_PRICE_LABEL } from "../lib/pricing";
import { getPublicServiceOffers, type PublicServiceOffer } from "../lib/service-pricing";
import { getServiceHubs } from "../lib/server/w1do/services";

interface EstimateScenario {
    id: string;
    title: string;
    description: string;
    icon: string;
    aliases: string[];
    pricingCluster?: string;
    offerNames?: string[];
    faqTerm?: { offer: string; pattern: RegExp };
}

const selectedService = Astro.url.searchParams.get("service");
const breadcrumbs = [
    { label: "Главная", href: "/" },
    { label: "Калькулятор", active: true },
];
const pageBreadcrumbs = breadcrumbSchema([
    { name: "Главная", path: "/" },
    { name: "Калькулятор", path: "/calculator" },
]);

const noOffer: PublicServiceOffer = {
    name: "",
    priceLabel: INDIVIDUAL_PRICE_LABEL,
    priceFrom: null,
    unit: "custom",
    term: null,
};
const scenarios: EstimateScenario[] = [
    {
        id: "automation",
        title: "Автоматизация",
        description: "Передавайте заявки в CRM, связывайте таблицы и сервисы, запускайте уведомления и согласования по правилам.",
        icon: "/images/icon-process-item-2.svg",
        aliases: ["n8n-automation", "ai-integration", "ai-integration-1c-crm"],
        pricingCluster: "n8n-automation",
    },
    {
        id: "ai-agent",
        title: "ИИ-агент",
        description: "Поручите агенту целую цепочку действий: проверить данные, подобрать решение и записать результат в систему.",
        icon: "/images/icon-service-3.svg",
        aliases: ["ai-agent-development", "ai-agents"],
        pricingCluster: "ai-agent-development",
        faqTerm: { offer: "Базовый агент", pattern: /базового\s+агента[^.!?]{0,150}?за\s+(\d+\s*[-–—]\s*\d+\s+недел[ьи])/iu },
    },
    {
        id: "auto-replies",
        title: "Автоответы",
        description: "Отвечайте на входящие сообщения, собирайте контакты и передавайте сложные обращения сотруднику.",
        icon: "/images/icon-service-2.svg",
        aliases: ["ai-assistants-chatbots", "ai-bot-avito"],
        pricingCluster: "ai-assistants-chatbots",
        offerNames: ["Базовый бот"],
        faqTerm: { offer: "Базовый бот", pattern: /базовая\s+версия\s+ассистента[^.!?]{0,150}?за\s+(\d+\s*[-–—]\s*\d+\s+рабочих\s+дней)/iu },
    },
    {
        id: "auto-calls",
        title: "Автообзвоны",
        description: "Автоматизируйте исходящие звонки: подтверждение записи, напоминания и уточнение статуса заявки.",
        icon: "/images/icon-headphone-white.svg",
        aliases: [],
    },
    {
        id: "ai-consultant",
        title: "ИИ-консультант",
        description: "Подключите помощника, который отвечает по вашим документам, каталогу и регламентам и может показать источник.",
        icon: "/images/icon-service-4.svg",
        aliases: ["website-chatbot"],
        pricingCluster: "ai-assistants-chatbots",
        offerNames: ["Pro Ассистент"],
    },
];
const services = await getServiceHubs().catch(() => []);
const items = scenarios.map((scenario) => {
    const requestedSource = selectedService && scenario.aliases.includes(selectedService)
        ? services.find((service) => service.cluster === selectedService)
        : undefined;
    const source = requestedSource ?? services.find((service) => service.cluster === scenario.pricingCluster);
    const offerTerm = scenario.faqTerm;
    const termFromFaq = offerTerm && Array.isArray(source?.faqs)
        ? source.faqs.reduce<string | null>((term, faq) => term
            ?? (typeof faq?.answer === "string" ? faq.answer.match(offerTerm.pattern)?.[1] ?? null : null), null)
        : null;
    const offers = getPublicServiceOffers(source?.pricing, source?.cluster)
        .filter((offer) => source?.cluster !== scenario.pricingCluster
            || !scenario.offerNames || scenario.offerNames.includes(offer.name))
        .map((offer) => offer.term || offer.name !== offerTerm?.offer ? offer : { ...offer, term: termFromFaq });
    const href = source?.url && /^\/(?!\/)[a-z0-9/-]+$/.test(source.url) ? source.url : undefined;
    const checked = selectedService === scenario.id || scenario.aliases.some((alias) => selectedService === alias);
    return { ...scenario, offers, href, checked };
});
const faq = [
    {
        question: "Что означает цена «от» в калькуляторе?",
        answer: "Это опубликованная стартовая цена выбранного тарифа. Итог зависит от количества сценариев, интеграций, объёма данных и требований к запуску. Точную смету можно подготовить после разбора задачи.",
    },
    {
        question: "Можно ли объединить несколько задач в одном расчёте?",
        answer: "Да. Например, добавьте автоответы и передачу заявок в CRM. Калькулятор покажет разовые и ежемесячные позиции отдельно. Если автоответы и консультации нужны в одном боте, при уточнении сметы проверим, какие работы можно учесть один раз.",
    },
    {
        question: `Почему у некоторых задач указано «${INDIVIDUAL_PRICE_LABEL}»?`,
        answer: "Для сценария может не быть опубликованного тарифа. Такая позиция сохранится в расчёте и заявке. Стоимость и срок уточним по вводным, а числа в итоге будут относиться только к известным ценам.",
    },
    {
        question: "Чем автоответы отличаются от ИИ-консультанта и агента?",
        answer: "Автоответы помогают с типовыми входящими сообщениями. Консультант ищет информацию в ваших материалах и отвечает по ним. ИИ-агент может выполнять последовательность действий, например проверить наличие, завести заявку и уведомить менеджера.",
    },
    {
        question: "От чего зависит стоимость автоматизации?",
        answer: "На оценку влияют число систем, доступность API, правила обработки ошибок и количество веток процесса. Для начала полезно описать, что запускает процесс, кто участвует и каким должен быть результат.",
    },
    {
        question: "Что нужно для оценки автообзвона?",
        answer: "Опишите цель звонка, пример диалога, объём вызовов и правила передачи оператору. Укажите, какую телефонию и CRM используете и как получено согласие на звонки.",
    },
    {
        question: "Что подготовить для ИИ-консультанта?",
        answer: "Достаточно нескольких типовых вопросов и материалов, которыми пользуются сотрудники: базы знаний, каталога, инструкций или регламентов. По ним можно проверить, где нужны ссылки на источники и когда ответ следует передать человеку.",
    },
    {
        question: "Входят ли телефония, ИИ-модели и подписки в стоимость?",
        answer: "Телефония, услуги ИИ-провайдеров, хостинг и лицензии сторонних систем могут оплачиваться отдельно. Расход зависит от выбранных сервисов и нагрузки. Их стоит выделить отдельными строками при уточнении сметы.",
    },
    {
        question: "Как узнать срок запуска проекта?",
        answer: "Если для тарифа опубликован срок, он указан рядом с ценой. Дата запуска зависит от готовности данных, доступов и порядка этапов. Для нескольких задач часть работ может идти параллельно.",
    },
    {
        question: "Что происходит после отправки расчёта?",
        answer: "К заявке добавляются выбранные задачи, тарифы и ваши уточнения. Обсудим границы первого запуска, данные и интеграции, затем согласуем состав работ, бюджет и сроки.",
    },
];
---

<Layout schema={pageBreadcrumbs}>
    <Header />
    <main class="estimate-page">
        <div class="estimate-intro">
            <Breadcrumbs title="Калькулятор стоимости ИИ для бизнеса" breadcrumbItems={breadcrumbs}>
                <div class="estimate-intro__content" slot="after-title">
                    <p>Выберите, что хотите поручить ИИ: автоматизировать процесс, внедрить агента, настроить автоответы, автообзвоны или консультанта.</p>
                    <div class="estimate-intro__actions">
                        <a href="#estimate-catalog" class="btn-default">Собрать расчёт</a>
                        <a href="#estimate-faq" class="estimate-text-link">Как считаем стоимость</a>
                    </div>
                </div>
            </Breadcrumbs>
        </div>

        <section id="estimate-catalog" class="estimate-workspace" aria-labelledby="estimate-catalog-title">
            <div class="container">
                <div class="estimate-workspace__heading">
                    <h2 id="estimate-catalog-title">Что хотите автоматизировать?</h2>
                    <p>Добавьте одну или несколько задач. Цены даны по опубликованным тарифам, которые подходят для первого запуска. Точную стоимость уточним по вашему сценарию.</p>
                </div>
                <noscript><p>Для расчёта включите JavaScript. Стартовые цены и сроки можно посмотреть в карточках ниже.</p></noscript>

                <div class="estimate-layout" data-estimate>
                    <div class="estimate-catalog">
                        <a href="#estimate-summary" class="estimate-mobile-jump" data-mobile-jump data-estimate-control hidden>
                            <span data-mobile-count>Выбрано 0</span>
                            <span>К расчёту ↓</span>
                        </a>
                        <div class="estimate-grid">
                            {items.map((item) => {
                                const defaultOffer = item.offers.find((offer) => offer.unit === "project") ?? item.offers[0] ?? noOffer;
                                return <article class="estimate-card" data-estimate-item>
                                    <div class="estimate-card__heading">
                                        <span class="estimate-card__icon"><img src={item.icon} width="24" height="24" alt="" loading="lazy" /></span>
                                        <h3>{item.title}</h3>
                                    </div>
                                    <p class="estimate-card__description">{item.description}</p>
                                    <div class="estimate-card__quote">
                                        {item.offers.length > 1 && (
                                            <label class="estimate-offers" data-estimate-control hidden>
                                                <span>Тариф</span>
                                                <select data-offer aria-label={`Тариф: ${item.title}`}>
                                                    {item.offers.map((offer) => (
                                                        <option
                                                            selected={offer === defaultOffer}
                                                            data-name={offer.name}
                                                            data-price={offer.priceFrom ?? ""}
                                                            data-price-label={offer.priceLabel}
                                                            data-unit={offer.unit}
                                                            data-term={offer.term}
                                                        >{offer.name}</option>
                                                    ))}
                                                </select>
                                            </label>
                                        )}
                                        <div class="estimate-card__facts">
                                            <strong data-card-price>{defaultOffer.priceLabel}</strong>
                                            <span data-card-term>{defaultOffer.term || "Срок уточним"}</span>
                                            {defaultOffer.name && (
                                                item.offers.length > 1
                                                    ? <noscript><small>Тариф «{defaultOffer.name}»</small></noscript>
                                                    : <small>Тариф «{defaultOffer.name}»</small>
                                            )}
                                        </div>
                                    </div>
                                    <div class="estimate-card__actions">
                                        <label class="estimate-option" data-estimate-control hidden>
                                            <input
                                                type="checkbox"
                                                value={item.id}
                                                checked={item.checked}
                                                data-service
                                                data-title={item.title}
                                                data-name={defaultOffer.name}
                                                data-price={defaultOffer.priceFrom ?? ""}
                                                data-price-label={defaultOffer.priceLabel}
                                                data-unit={defaultOffer.unit}
                                                data-term={defaultOffer.term}
                                                aria-label={`Добавить к расчёту: ${item.title}`}
                                            />
                                            <span class="estimate-option__off">Добавить</span>
                                            <span class="estimate-option__on">Выбрано</span>
                                        </label>
                                        {item.href && <a href={item.href} class="estimate-text-link">О тарифе<span class="visually-hidden"> — {item.title}</span></a>}
                                    </div>
                                </article>;
                            })}
                        </div>

                        <details class="estimate-details" data-estimate-control hidden>
                            <summary>Уточнить параметры проекта</summary>
                            <p>Уточнения попадут в заявку и помогут подготовить смету.</p>
                            <label>
                                Масштаб
                                <select data-detail="Масштаб">
                                    <option value="">Не выбрано</option>
                                    <option>Один процесс или пилот</option>
                                    <option>Несколько процессов или отдел</option>
                                    <option>Внедрение в нескольких отделах</option>
                                </select>
                            </label>
                            <label>
                                Системы для интеграции
                                <input type="text" maxlength="120" placeholder="Например, Битрикс24 и 1С" data-detail="Интеграции" />
                            </label>
                            <label>
                                Желаемый срок
                                <select data-detail="Желаемый срок">
                                    <option value="">Не выбрано</option>
                                    <option>Через 2–3 недели</option>
                                    <option>В течение 1–2 месяцев</option>
                                    <option>Без жёсткого срока</option>
                                </select>
                            </label>
                        </details>
                    </div>

                    <aside id="estimate-summary" class="estimate-summary" aria-labelledby="estimate-summary-title" tabindex="-1">
                        <div class="estimate-summary__head">
                            <h3 id="estimate-summary-title">Ваш расчёт</h3>
                            <span class="estimate-summary__count" data-count aria-live="polite">Выбрано 0</span>
                        </div>
                        <p class="estimate-summary__empty" data-empty>Добавьте услуги, чтобы сравнить стоимость и сроки в одном списке.</p>
                        <ul class="estimate-summary__items" data-selection aria-label="Выбранные услуги" hidden></ul>
                        <dl class="estimate-summary__totals" data-totals aria-live="polite" hidden>
                            <div data-project-row hidden><dt>Разовые работы</dt><dd data-project-total></dd></div>
                            <div data-month-row hidden><dt>Сопровождение</dt><dd data-month-total></dd></div>
                        </dl>
                        <p class="estimate-summary__missing" data-missing hidden></p>
                        <p class="estimate-summary__longest" data-longest hidden></p>
                        <p class="estimate-summary__note">Итоговая смета и дата запуска зависят от состава работ, общих этапов и готовности данных.</p>
                        <a href="#estimate-request" class="btn-default estimate-summary__cta" data-submit-estimate>Обсудить задачу</a>
                        <a href="#estimate-catalog" class="estimate-text-link estimate-summary__back">Изменить выбор</a>
                    </aside>
                </div>
                <input type="hidden" name="calculation" form="calculator-lead" data-calculation />
            </div>
        </section>

        <section id="estimate-process" class="estimate-process" aria-label="Этапы внедрения">
            <Process
                subTitle="Этапы работы"
                title="От расчёта до запуска"
                description="Начинаем с одного понятного сценария. На примерах ваших обращений или процессов проверяем, что ИИ экономит время и делает нужную работу."
                step1Title="Разбор задачи"
                step1Desc="Уточняем сценарии, данные и системы"
                step2Title="Оценка проекта"
                step2Desc="Согласуем смету, сроки и первый запуск"
                step3Title="Пилот"
                step3Desc="Проверяем работу на ваших примерах"
                step4Title="Внедрение"
                step4Desc="Подключаем сервисы и передаём инструкции"
                buttonText="Получить смету"
                buttonHref="#estimate-request"
            />
        </section>

        <section id="estimate-faq" class="estimate-faq" aria-label="Вопросы о цене и сроках">
            <Faqs
                subTitle="Цены и сроки"
                title="Что влияет на стоимость"
                description="Как сравнить варианты, что понадобится для оценки и какие расходы учесть до запуска."
                customFaqs={faq}
            />
        </section>

        <section id="estimate-request" class="estimate-request" aria-label="Заявка на точную смету">
            <Cta
                subTitle="Точная смета"
                title="Получите смету под вашу задачу"
                description="Оставьте контакты. Выбранные услуги и параметры проекта добавятся к заявке."
                formTitle=""
                source="calculator"
                formId="calculator-lead"
            />
        </section>
    </main>
    <div class="estimate-footer"><Footer /></div>
</Layout>

<script>
    import { formatPrice, INDIVIDUAL_PRICE_LABEL } from "../lib/pricing";

    const calculator = document.querySelector<HTMLElement>("[data-estimate]");
    const calculation = document.querySelector<HTMLInputElement>("[data-calculation]");

    if (calculator && calculation) {
        const services = Array.from(calculator.querySelectorAll<HTMLInputElement>("[data-service]"));
        const offers = new Map(services.map((service) => [
            service,
            service.closest("[data-estimate-item]")?.querySelector<HTMLSelectElement>("[data-offer]"),
        ]));
        const selection = calculator.querySelector<HTMLUListElement>("[data-selection]")!;
        const cta = calculator.querySelector<HTMLAnchorElement>("[data-submit-estimate]")!;
        const details = Array.from(calculator.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-detail]"));
        let lastReported = "";

        const setText = (selector: string, text: string) => {
            calculator.querySelector<HTMLElement>(selector)!.textContent = text;
        };

        const toggle = (selector: string, show: boolean) => {
            calculator.querySelector<HTMLElement>(selector)!.hidden = !show;
        };

        const render = () => {
            const selected = services.filter((input) => input.checked);
            const projectPrices: number[] = [];
            const monthPrices: number[] = [];
            const lines: string[] = [];
            let separatePriceCount = 0;
            let longestDays = 0;
            let longestTerm = "";

            const items = selected.map((input) => {
                const { name: offerName, price, priceLabel, term, unit } = offers.get(input)?.selectedOptions[0]?.dataset ?? input.dataset;
                const name = offerName ? `${input.dataset.title} · ${offerName}` : input.dataset.title ?? "";
                const facts = `${priceLabel ?? INDIVIDUAL_PRICE_LABEL} · ${term || "Срок уточним"}`;
                lines.push(`${name} — ${facts}`);

                if (price && (unit === "project" || unit === "month")) {
                    const prices = unit === "month" ? monthPrices : projectPrices;
                    prices.push(Number(price));
                } else {
                    separatePriceCount++;
                }

                // Compare the published upper estimates for project work, excluding subscriptions.
                const range = unit === "project" && term?.match(/^(?:до\s+|\d+\s*[-–—]\s*)?(\d+)\s+(день|дня|дней|дн|неделя|недели|недель|нед)\.?$/i);
                if (range) {
                    const days = Number(range[1]) * (range[2].toLowerCase().startsWith("нед") ? 7 : 1);
                    if (days > longestDays) {
                        longestDays = days;
                        longestTerm = term?.replace(/\.$/, "") ?? "";
                    }
                }

                const item = document.createElement("li");
                const itemText = document.createElement("span");
                const itemTitle = document.createElement("strong");
                itemTitle.textContent = name;
                const itemFacts = document.createElement("small");
                itemFacts.textContent = facts;
                itemText.append(itemTitle, itemFacts);
                item.append(itemText);
                return item;
            });
            selection.replaceChildren(...items);

            const projectTotal = formatPrice({ priceFrom: projectPrices.reduce((a, b) => a + b, 0), unit: "project" });
            const monthTotal = formatPrice({ priceFrom: monthPrices.reduce((a, b) => a + b, 0), unit: "month" });
            const count = `Выбрано ${selected.length}`;
            setText("[data-count]", count);
            setText("[data-mobile-count]", count);
            setText("[data-project-total]", projectTotal);
            setText("[data-month-total]", monthTotal);
            setText("[data-missing]", `Позиций вне общей суммы: ${separatePriceCount}. Стоимость уточняется индивидуально или рассчитывается по отдельным условиям.`);
            setText("[data-longest]", `Самый долгий этап с оценкой в календарных днях или неделях: ${longestTerm}.`);
            toggle("[data-empty]", !selected.length);
            toggle("[data-selection]", Boolean(selected.length));
            toggle("[data-totals]", Boolean(projectPrices.length || monthPrices.length));
            toggle("[data-project-row]", Boolean(projectPrices.length));
            toggle("[data-month-row]", Boolean(monthPrices.length));
            toggle("[data-missing]", Boolean(separatePriceCount));
            toggle("[data-longest]", Boolean(longestTerm));
            cta.textContent = selected.length ? "Обсудить расчёт" : "Обсудить задачу";

            const qualifiers = details.filter((field) => field.value.trim()).map((field) => (
                `${field.dataset.detail}: ${field.value.trim()}`
            ));
            const totals = [
                ...(projectPrices.length ? [`Разовые работы: ${projectTotal}`] : []),
                ...(monthPrices.length ? [`Сопровождение: ${monthTotal}`] : []),
                ...(separatePriceCount ? [`Позиций вне общей суммы: ${separatePriceCount}`] : []),
            ];
            calculation.value = [...lines, ...totals, ...qualifiers].join("\n");
        };

        calculator.querySelectorAll<HTMLElement>("[data-estimate-control]").forEach((control) => {
            control.hidden = false;
        });
        calculator.addEventListener("input", (event) => {
            const field = event.target;
            if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement)) return;
            if (field instanceof HTMLSelectElement && field.matches("[data-offer]")) {
                const offer = field.selectedOptions[0];
                const card = field.closest("[data-estimate-item]");
                if (offer && card) {
                    card.querySelector("[data-card-price]")!.textContent = offer.dataset.priceLabel ?? INDIVIDUAL_PRICE_LABEL;
                    card.querySelector("[data-card-term]")!.textContent = offer.dataset.term || "Срок уточним";
                }
            }
            if (field.matches("[data-service], [data-detail], [data-offer]")) render();
        });

        cta.addEventListener("click", () => {
            if (!services.some((input) => input.checked) || calculation.value === lastReported) return;
            const { ym } = window as Window & {
                ym?: (counter: number, method: string, goal: string) => void;
            };
            if (typeof ym !== "function") return;
            ym(109810952, "reachGoal", "calculator_result");
            ym(109810952, "reachGoal", "quiz_complete");
            lastReported = calculation.value;
        });
        render();
    }
</script>

