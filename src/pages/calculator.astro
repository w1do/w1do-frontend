---
import Layout from "../layouts/Layout.astro";
import Header from "../components/shared/Header.astro";
import Breadcrumbs from "../components/shared/Breadcrumbs.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/shared/Footer.astro";
import { getPackages } from "../lib/pricing";

const packages = getPackages();
const pricingJson = JSON.stringify(packages);
---
<Layout
    title="Калькулятор стоимости ИИ-решения | AiCRAFT"
    description="Ответьте на четыре вопроса и получите вилку стоимости внедрения ИИ-агента, срок и рекомендацию по формату работы."
>
    <Header />
    <Breadcrumbs
        title="Калькулятор стоимости"
        breadcrumbItems={[
            { label: "Главная", href: "/" },
            { label: "Калькулятор", active: true }
        ]}
    />

    <section class="calculator-section">
        <div class="container">
            <div class="section-title section-title-center">
                <span class="section-sub-title wow fadeInUp">Оценка за 1 минуту</span>
                <h2 class="text-anime-style-3">Сколько стоит ваше ИИ-решение</h2>
                <p class="wow fadeInUp">Четыре вопроса — вилка стоимости, срок и следующий шаг. Точную смету считаем после разбора задачи.</p>
            </div>

            <form class="calculator" id="calculator" novalidate>
                <fieldset class="calculator-step">
                    <legend><span>01</span> Что нужно автоматизировать</legend>
                    <div class="calculator-options">
                        <label><input type="radio" name="task" value="support" checked><span>Поддержку клиентов</span></label>
                        <label><input type="radio" name="task" value="sales"><span>Продажи и заявки</span></label>
                        <label><input type="radio" name="task" value="docs"><span>Документы и базу знаний</span></label>
                        <label><input type="radio" name="task" value="unknown"><span>Пока не знаю</span></label>
                    </div>
                </fieldset>

                <fieldset class="calculator-step">
                    <legend><span>02</span> Объём обращений</legend>
                    <div class="calculator-options">
                        <label><input type="radio" name="scale" value="small" checked><span>До 100 в день</span></label>
                        <label><input type="radio" name="scale" value="medium"><span>100–1000 в день</span></label>
                        <label><input type="radio" name="scale" value="large"><span>Больше 1000 в день</span></label>
                    </div>
                </fieldset>

                <fieldset class="calculator-step">
                    <legend><span>03</span> С чем нужно интегрироваться</legend>
                    <div class="calculator-options">
                        <label><input type="checkbox" name="systems" value="crm"><span>CRM</span></label>
                        <label><input type="checkbox" name="systems" value="1c"><span>1С</span></label>
                        <label><input type="checkbox" name="systems" value="messengers"><span>Мессенджеры</span></label>
                        <label><input type="checkbox" name="systems" value="none"><span>Пока ни с чем</span></label>
                    </div>
                </fieldset>

                <fieldset class="calculator-step">
                    <legend><span>04</span> Когда нужен результат</legend>
                    <div class="calculator-options">
                        <label><input type="radio" name="deadline" value="fast" checked><span>Через 2–3 недели</span></label>
                        <label><input type="radio" name="deadline" value="normal"><span>В течение 1–2 месяцев</span></label>
                        <label><input type="radio" name="deadline" value="flexible"><span>Без жёсткого срока</span></label>
                    </div>
                </fieldset>

                <div class="calculator-actions">
                    <button type="submit" class="btn-default" data-cursor="-opaque">Показать вилку</button>
                    <span class="calculator-hint">Без звонка и регистрации</span>
                </div>
            </form>

            <div class="calculator-result" id="calculatorResult" hidden aria-live="polite">
                <span class="calculator-result__label">Рекомендуемый формат</span>
                <h3 id="resultPackage">AI MVP</h3>
                <p class="calculator-result__price" id="resultPrice">от 150 000 ₽</p>
                <p class="calculator-result__term" id="resultTerm">Срок: 2–3 недели</p>
                <p class="calculator-result__note" id="resultNote">Точную смету считаем после разбора задачи: она зависит от данных, интеграций и правил передачи диалога человеку.</p>
                <div class="calculator-result__actions">
                    <a href="/contact" class="btn-default" data-cursor="-opaque">Обсудить расчёт</a>
                    <a href="/pricing" class="btn-outline" data-cursor="-opaque">Сравнить тарифы</a>
                </div>
            </div>
        </div>
    </section>

    <script type="application/json" id="pricingData" set:html={pricingJson}></script>
    <script is:inline>
        (() => {
            const form = document.getElementById("calculator");
            const result = document.getElementById("calculatorResult");
            const dataEl = document.getElementById("pricingData");
            if (!form || !result || !dataEl) return;

            const packages = JSON.parse(dataEl.textContent || "[]");
            const byId = Object.fromEntries(packages.map((pkg) => [pkg.id, pkg]));

            const formatPrice = (pkg) => {
                const value = new Intl.NumberFormat("ru-RU").format(pkg.priceFrom).replace(/\u00A0/g, " ");
                return "от " + value + " ₽";
            };

            form.addEventListener("submit", (event) => {
                event.preventDefault();
                const data = new FormData(form);
                const task = data.get("task");
                const scale = data.get("scale");
                const systems = data.getAll("systems").filter((value) => value !== "none");
                const deadline = data.get("deadline");

                let id = "mvp";
                if (task === "unknown") id = "audit";
                else if (task === "sales" || scale === "large" || systems.length >= 2) id = "business";

                const pkg = byId[id];
                if (!pkg) return;

                document.getElementById("resultPackage").textContent = pkg.name;
                document.getElementById("resultPrice").textContent = formatPrice(pkg);
                document.getElementById("resultTerm").textContent = "Срок: " + pkg.term;

                const notes = [];
                if (task === "unknown") notes.push("Начнём с аудита: он покажет, что автоматизировать первым.");
                if (systems.length) notes.push("Интеграции: " + systems.length + ".");
                if (deadline === "fast") notes.push("Срочный запуск может потребовать отдельного плана.");
                document.getElementById("resultNote").textContent = notes.join(" ") ||
                    "Точную смету считаем после разбора задачи: она зависит от данных, интеграций и правил передачи диалога человеку.";

                result.hidden = false;
                const cta = result.querySelector('a[href="/contact"]');
                if (cta) {
                    const params = new URLSearchParams(window.location.search);
                    params.set("task", String(task || ""));
                    params.set("scale", String(scale || ""));
                    params.set("deadline", String(deadline || ""));
                    if (systems.length) params.set("systems", systems.join(","));
                    else params.delete("systems");
                    cta.href = "/contact?" + params.toString();
                }
                result.scrollIntoView({ behavior: "smooth", block: "start" });
                if (typeof window.ym === "function") {
                    window.ym(109810952, "reachGoal", "calculator_result");
                    window.ym(109810952, "reachGoal", "quiz_complete");
                }
            });
        })();
    </script>

    <Cta
        subTitle="Нужен точный расчёт?"
        title="Разберём задачу и посчитаем смету"
        description="Оставьте заявку — вернёмся с планом, сроком и стоимостью под ваш процесс."
        formTitle="Получить расчёт"
    />
    <Footer />
</Layout>

<style>
    .calculator-section { padding: 80px 0 40px; }
    .calculator {
        display: grid;
        gap: 20px;
        max-width: 880px;
        margin: 0 auto;
    }
    .calculator-step {
        margin: 0;
        padding: 24px;
        border: 1px solid var(--divider-color);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.02);
    }
    .calculator-step legend {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 8px;
        color: var(--primary-color);
        font-size: 18px;
        font-weight: 600;
    }
    .calculator-step legend span {
        color: var(--accent-color);
        font-size: 13px;
        letter-spacing: 0.08em;
    }
    .calculator-options {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-top: 16px;
    }
    .calculator-options label {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 52px;
        padding: 12px 16px;
        border: 1px solid var(--divider-color);
        border-radius: 12px;
        color: var(--primary-color);
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
    }
    .calculator-options label:has(input:checked) {
        border-color: var(--accent-color);
        background: rgba(207, 248, 94, 0.08);
    }
    .calculator-options input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }
    .calculator-options label:focus-within { outline: 2px solid var(--accent-color); outline-offset: 2px; }
    .calculator-options label span { font-size: 15px; line-height: 1.35; }
    .calculator-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        justify-content: center;
        padding-top: 8px;
    }
    .calculator-hint { color: var(--text-color); font-size: 14px; }
    .calculator-result {
        max-width: 880px;
        margin: 32px auto 0;
        padding: 32px;
        border: 1px solid var(--accent-color);
        border-radius: 24px;
        background: rgba(207, 248, 94, 0.06);
        text-align: center;
    }
    .calculator-result__label { color: var(--text-color); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; }
    .calculator-result h3 { margin: 8px 0 4px; color: var(--primary-color); font-size: 28px; }
    .calculator-result__price { margin: 0; color: var(--accent-color); font-size: 42px; font-weight: 700; line-height: 1.1; }
    .calculator-result__term { margin: 8px 0 16px; color: var(--primary-color); font-size: 17px; }
    .calculator-result__note { max-width: 620px; margin: 0 auto 22px; color: var(--text-color); font-size: 15px; line-height: 1.6; }
    .calculator-result__actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
    .btn-outline {
        display: inline-flex;
        align-items: center;
        padding: 14px 24px;
        border: 1px solid var(--divider-color);
        border-radius: 999px;
        color: var(--primary-color);
        font-weight: 600;
    }
    @media (max-width: 575px) {
        .calculator-section { padding: 48px 0 24px; }
        .calculator-step { padding: 18px; }
        .calculator-options { grid-template-columns: 1fr; }
        .calculator-result { padding: 24px 18px; }
        .calculator-result__price { font-size: 32px; }
    }
</style>
