---
import Layout from '../layouts/Layout.astro';
import { HOME_ORIGINAL_FAQS } from "../lib/home-faqs";
import Header from "../components/shared/Header.astro";
import Hero from "../components/Hero.astro";
import Segments from "../components/Segments.astro";
import About from "../components/About.astro";
import MediaResources from "../components/media/MediaResources.astro";
import Services from "../components/Services.astro";
import Choose from "../components/Choose.astro";
import IntroVideo from "../components/IntroVideo.astro";
import Feature from "../components/Feature.astro";
import Footer from "../components/shared/Footer.astro";
import Blog from "../components/blog/Blog.astro";
import ExpertiseVideos from "../components/ExpertiseVideos.astro";
import Faqs from "../components/Faqs.astro";
import Testimonials from "../components/Testimonials.astro";
import Cta from "../components/Cta.astro";
import Process from "../components/Process.astro";
import Projects from "../components/projects/Projects.astro";
import Awards from "../components/Awards.astro";
import Pricing from "../components/Pricing.astro";
import { formatRubleAmount, STARTING_PROJECT_PRICE } from "../lib/pricing";
const offerFormId = "home-offer-request";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
const homeFaqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": HOME_ORIGINAL_FAQS.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
    }))
};
---

<Layout
	image="/images/og-main.jpg"
	bodyClass="home-page"
	schema={homeFaqSchema}
>
	<Header/>
	<Hero
		title="ИИ-агенты для бизнеса, которые работают в ваших системах"
		description="Разрабатываем и внедряем агентов для поддержки, продаж и работы с документами. Обучаем модель на ваших данных, подключаем CRM, 1С и мессенджеры и проверяем результат на реальных примерах."
	>
		<ExpertiseVideos slot="after-hero" formId={offerFormId} />
	</Hero>
	<Segments />
	<About homeOriginal
		subTitle="Об агентстве AiCRAFT"
		title="Кто отвечает за внедрение агента"
		description="Вместе с сотрудниками разбираем процесс и выясняем, на каких шагах уходит время. Мы отвечаем за разработку агента, подключение к вашим системам и проверку на рабочих примерах. После запуска передаём команде инструкции и согласуем сопровождение."
		counterValue="100"
		counterTag="Разработанных ИИ-систем"
		counterDescription="для работы с обращениями, документами и данными"
	/>
	<MediaResources
		title="Как мы разрабатываем ИИ-агентов"
		description="В видео показываем, как подключаем модель к рабочему сервису и ищем причину ошибки, если агент отвечает неверно. В Telegram отвечаем на вопросы по разборам и обсуждаем задачи вашей команды."
	/>
	<Services homeOriginal
		subTitle="Услуги"
		title="Что входит в разработку ИИ-агента"
		description="Берём на себя весь проект или подключаемся к отдельному этапу. Для нового агента проектируем сценарий и подключаем данные, а для готового прототипа настраиваем доступ к сервисам и среду, в которой он будет работать."
	/>
	<Pricing homeOriginal
		subTitle="Стоимость"
		title="Сколько стоит внедрение ИИ-агента"
		description="Стоимость зависит от числа систем, с которыми работает агент, состояния базы знаний и действий, требующих проверки. После разбора процесса отдельно оцениваем разработку, интеграции и расходы на работу модели."
	/>
	<Awards homeOriginal
		subTitle="Инженерная практика"
		title="Как агент находит ответ и выполняет задачу"
		description="Запрос определяет, к какому источнику обратиться и какой инструмент вызвать. Для вопроса о правилах нужен утверждённый документ, для изменения статуса обращения — доступ к системе поддержки."
		counterValue="100"
		counterDesc="Реализованных ИИ-сценариев и интеграций."
		sliderText="Сравниваем модели на примерах из проекта: проверяем точность ответа, время обработки и стоимость запроса."
		awards={[
			{
				icon: '/images/llm/gemini-color.svg',
				title: 'Поиск по документам',
				description: 'С помощью RAG агент находит нужный фрагмент в базе знаний и показывает источник. Сотрудник может сверить ответ с регламентом.',
				year: '2025'
			},
			{
				icon: '/images/llm/claude-color.svg',
				title: 'Действия в рабочих системах',
				description: 'Через API агент находит обращение, указывает тему и назначает ответственную группу. Оператор видит, по каким признакам выбрана очередь.',
				year: '2025'
			},
			{
				icon: '/images/llm/deepseek-color.svg',
				title: 'Помощь разработчикам',
				description: 'Агент готовит тесты и черновик документации по изменениям в коде. Разработчик проверяет результат перед включением в проект.',
				year: '2026'
			}
		]}
	/>
	<Choose homeOriginal
		subTitle="Контроль автоматизации"
		title="Какие решения остаются за сотрудником"
		description="До запуска согласуем, что агент делает сам и когда обращается к человеку. Например, при запросе на возврат он может найти заказ и сверить условия, а решение о выплате принимает сотрудник."
		benefit1Title="Права на действия"
		benefit1Desc="Указываем, какие записи агент может читать и менять. Для действий, требующих решения сотрудника, добавляем запрос на подтверждение."
		benefit2Title="Передача сложных случаев"
		benefit2Desc="Если в справочнике нет ответа или клиент сообщает противоречивые данные, агент передаёт вопрос сотруднику вместе с историей обращения."
		priceTitle="Первый сценарий"
		priceDesc="Можно начать с одной операции и проверить её на пилоте, прежде чем подключать другие отделы."
		priceValue={formatRubleAmount(STARTING_PROJECT_PRICE)}
	/>
	<IntroVideo homeOriginal
		subTitle="Автоматизация на практике"
		title="Как оценить пользу ИИ для отдела"
		description="Возьмите типовой договор и засеките, сколько времени юрист ищет в нём расхождения с шаблоном. На пилоте сравните это время с проверкой правок, которые предложил агент. Отдельно отметьте пропуски и ложные замечания."
		tickerItems={["Время обработки", "Ручные операции", "Ошибки", "Проверка результата"]}
	/>
	<Feature homeOriginal
		subTitle="Технологии"
		title="Из чего состоит ИИ-агент"
		description="Языковая модель разбирает запрос, поиск по базе знаний подбирает документы, а интеграция через API читает или обновляет запись в рабочей системе. Выбор модели и места хранения данных зависит от задачи и правил доступа в компании."
	/>
	<Projects homeOriginal
		subTitle="Портфолио"
		title="Примеры автоматизации в бизнесе"
		description="В проектах можно посмотреть, с какой задачи началась разработка и какую часть работы поручили системе. Сравните эти примеры со своим процессом, чтобы понять, что стоит проверить на первом пилоте."
		filterAi="Нейросети"
		filterAutomation="ИИ-агенты"
	/>
	<Process homeOriginal
		subTitle="Этапы внедрения"
		title="Как проходит разработка ИИ-агента"
		description="Берём один типичный запрос и проходим его вместе с будущими пользователями. Так у команды есть пример, по которому можно проверить работу агента на каждом этапе."
		step1Title="Разбор процесса"
		step1Desc="Фиксируем исходные данные, ручные операции и признаки правильного результата."
		step2Title="Проектирование"
		step2Desc="Составляем схему интеграций. Для каждого шага указываем источник данных и нужные права."
		step3Title="Пилот"
		step3Desc="Проверяем прототип на обычных и спорных примерах. Вместе разбираем ошибки и уточняем правила."
		step4Title="Запуск"
		step4Desc="Подключаем рабочие системы, обучаем сотрудников и передаём инструкции по контролю агента."
	/>

	<Testimonials homeOriginal
		subTitle="Отзывы клиентов"
		title="Что изменилось после внедрения ИИ"
		description="Руководители рассказывают, что изменилось в работе их команд: как поддержка отвечает по документации, юристы проверяют договоры, а отдел продаж обрабатывает обращения из Telegram."
		testimonials={[
			{
				rating: 5,
				text: "Заказывал разработку RAG-системы для техподдержки. Денис внедрил решение, которое теперь отвечает на 80% запросов по нашей документации. Точность ответов поразительная, а нагрузка на живых операторов снизилась в три раза. Очень профессиональный подход.",
				authorName: "Алексей Волков",
				authorRole: "Технический директор SaaS-сервиса",
				authorImage: "/images/author-3.jpg"
			},
			{
				rating: 5,
				text: "Как разработчик ИИ, Денис помог нам автоматизировать анализ юридических документов. То, на что раньше уходило 2 дня работы юриста, теперь ИИ делает за 5 минут. Внедрение окупилось за первый же месяц работы. Рекомендую как сильного эксперта.",
				authorName: "Марина Соколова",
				authorRole: "Основатель юридической фирмы",
				authorImage: "/images/author-4.jpg"
			},
			{
				rating: 5,
				text: "Внедрение ИИ-агентов в наш отдел продаж стало прорывом. Теперь квалификация лидов происходит автоматически через Telegram. Денис спроектировал систему так, что она общается как живой человек и сразу заносит данные в CRM. Скорость обработки выросла на 40%.",
				authorName: "Дмитрий Кравцов",
				authorRole: "CEO рекламного агентства",
				authorImage: "/images/author-1.jpg"
			}
		]}
	/>
	<Faqs homeOriginal
		subTitle="Вопросы и ответы"
		title="Что уточнить перед заказом ИИ-агента"
		description="Здесь собраны вопросы, которые возникают до старта проекта. Ответы помогут подготовить примеры для пилота и обсудить с ИТ-командой доступ к данным."
		customFaqs={HOME_ORIGINAL_FAQS}
	/>
	<Blog
		title="Статьи об автоматизации и разработке ИИ"
		description="В блоге разбираем технологии и решения из практики. Статьи помогут разобраться, как работают агенты и какие вопросы задать разработчику перед внедрением."
	/>
	<Cta homeOriginal formId={offerFormId}
		subTitle="Обсудить проект"
		title="Какую задачу вы хотите автоматизировать?"
		description="Опишите одну операцию, которая отнимает время у команды. Укажите, откуда приходит запрос, где сотрудник ищет данные и что должно получиться. На первом разговоре обсудим, подходит ли задача для агента и что понадобится для оценки."
		formTitle="Расскажите о задаче"
	/>
	<Footer description="AiCRAFT разрабатывает и внедряет ИИ-агентов для бизнеса. Подключаем агента к данным и рабочим системам компании, вместе с командой проверяем его на реальных задачах." />
</Layout>

<style is:global>
    @media (width > 991px) {
        .home-page {
            --home-section-width: min(1820px, calc(100% - 30px));
        }

        .home-page > .bg-section:not(.main-footer-prime) {
            width: var(--home-section-width);
            margin-inline: auto;
        }

        .home-page > :not(.bg-section, .hero-prime) > .container {
            width: var(--home-section-width);
            max-width: none;
            padding-inline: 0;
        }
    }

    @media (768px <= width < 1200px) {
        .home-page .post-item-list > :last-child:nth-child(odd) {
            width: 100%;
        }
    }
</style>
