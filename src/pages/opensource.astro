---
import Layout from "../layouts/Layout.astro";
import Header from "../components/shared/Header.astro";
import Breadcrumbs from "../components/shared/Breadcrumbs.astro";
import ProjectsList from "../components/projects/ProjectsList.astro";
import Faqs from "../components/Faqs.astro";
import Footer from "../components/shared/Footer.astro";
import { getOpenSourceProjects } from "../lib/server/w1do/opensource";

export const prerender = false;

const projects = await getOpenSourceProjects();
---
<Layout
    title="Открытые проекты AiCRAFT | Репозитории и инструменты"
    description="Открытые инструменты AiCRAFT для разработки и интеграций. Репозитории, инструкции по установке и примеры применения."
    keywords="открытые проекты, инструменты ИИ, репозитории AiCRAFT"
    image="/images/og-projects.jpg"
>
    <Header/>
    <Breadcrumbs withSchema title="Открытые проекты" breadcrumbItems={[
        {label: "Главная", href: "/"},
        {label: "Открытые проекты", active: true}
    ]}/>
    <ProjectsList projects={projects} basePath="/opensource" actionText="Смотреть репозиторий"/>
    {projects.length === 0 && (
        <section class="container" style="padding: 0 1rem 5rem;">
            <p>Здесь будут доступны репозитории и инструкции по запуску.</p>
        </section>
    )}
    <Faqs/>
    <Footer/>
</Layout>
