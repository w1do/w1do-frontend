---
import { breadcrumbSchema } from "../../lib/breadcrumbs";
import { formatPrice, STARTING_PROJECT_PRICE } from "../../lib/pricing";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/shared/Header.astro";
import Breadcrumbs from "../../components/shared/Breadcrumbs.astro";
import FaqItem from "../../components/shared/faq/FaqItem.astro";
import FaqSection from "../../components/shared/faq/FaqSection.astro";
import FaqPageContent from "../../components/shared/faq/FaqPageContent.astro";
import Footer from "../../components/shared/Footer.astro";
import Cta from "../../components/Cta.astro";

const startingPrice = formatPrice({ priceFrom: STARTING_PROJECT_PRICE, unit: "project" });

const categories = [
    { label: "ИИ-агенты и RAG", href: "#faq_agents" },
    { label: "Автоматизация бизнеса", href: "#faq_business" },
    { label: "Аналитика и Excel", href: "#faq_excel" },
    { label: "Инструменты и интеграции", href: "#faq_tools" },
    { label: "Как проходит внедрение", href: "#faq_process" },
    { label: "Стоимость и запуск", href: "#faq_pricing" },
    { label: "Разработка ботов", href: "#faq_dev" },
];
const pageBreadcrumbs = breadcrumbSchema([
    { name: "Главная", path: "/" },
    { name: "База знаний", path: "/knowledge" }
]);

---
<Layout
    schema={pageBreadcrumbs} 
    title="База знаний об ИИ-агентах, RAG и внедрении | AiCRAFT"
    description="Ответы о запуске ИИ-агентов, работе с данными и RAG, доступах, инструментах и планировании затрат."
    keywords="RAG, LLM, разработка AI, Claude, ИИ агенты, база знаний ИИ, автоматизация бизнеса, внедрение ИИ"
>
    <Header />
    <Breadcrumbs title="База знаний об ИИ-агентах" breadcrumbItems={[
        {label: "Главная", href: "/"},
        {label: "База знаний", active: true}
    ]}/>

    <!-- Page Faqs Start -->
    <FaqPageContent categories={categories}>
        <FaqSection id="faq_agents" title="ИИ-агенты и LLM">
                            <FaqItem 
                                id="1" 
                                active={true}
                                question="1. Что входит в разработку ИИ-решения?"
                                answer="<p>Мы проектируем решения, которые используют рабочие данные, действия в сервисах и языковую модель. В проект входят правила работы, способы проверки результата и условия передачи задачи сотруднику.</p>"
                            />
                            <FaqItem 
                                id="2" 
                                delay="0.2s"
                                question="2. Что такое RAG и зачем это нужно моему бизнесу?" 
                                answer="<p>RAG позволяет найти фрагменты в документации, базе знаний или другой согласованной системе и передать их модели перед ответом. Это помогает обосновывать ответы источниками. Качество проверяем на рабочих примерах.</p>"
                            />
                            <FaqItem 
                                id="3" 
                                delay="0.4s"
                                question="3. Кто такой ИИ-агент и чем он отличается от обычного чат-бота?" 
                                answer="<p>ИИ-агент может получить данные, вызвать разрешённый инструмент и сохранить результат. Например, после диалога он заполняет карточку в CRM или передаёт обращение сотруднику.</p>"
                            />
                            <FaqItem 
                                id="4" 
                                delay="0.6s"
                                question="4. Как выбрать способ размещения агента?"
                                answer="<p>Доступность зависит от выбранной платформы, условий провайдера и требований компании. Для проекта обсуждаем, можно ли использовать внешние модели и какие данные должны оставаться в вашем контуре.</p>"
                            />
                        </FaqSection>

                        <FaqSection id="faq_business" title="Автоматизация бизнеса">
                            <FaqItem 
                                id="6" 
                                active={true}
                                parentId="accordion_faq_business"
                                question="1. Как использовать ИИ в продажах и маркетинге?" 
                                answer="<p>В продажах агент может уточнить задачу клиента, собрать данные для предложения и подготовить карточку сделки. В маркетинге — классифицировать обращения и подготовить черновики материалов по согласованным источникам.</p>"
                            />
                            <FaqItem 
                                id="7" 
                                delay="0.2s"
                                parentId="accordion_faq_business"
                                question="2. Какие задачи остаются у менеджеров?"
                                answer="<p>Агент может обработать типовые входящие сообщения и подготовить данные. Менеджер берёт на себя исключения, переговоры и решения, для которых нужно подтверждение.</p>"
                            />
                            <FaqItem 
                                id="8" 
                                delay="0.4s"
                                parentId="accordion_faq_business"
                                question="3. Как реализовать автоответчик на Авито с помощью ИИ?" 
                                answer="<p>Проверяем доступные способы интеграции Авито и согласуем правила ответов. Агент может уточнять запрос по наличию, формировать черновик и передавать сложные вопросы сотруднику.</p>"
                            />
                            <FaqItem 
                                id="9" 
                                delay="0.6s"
                                parentId="accordion_faq_business"
                                question="4. Как оценить эффект от ИИ-агента?"
                                answer="<p>Определите показатель, который агент должен изменить. Для заявок это может быть время первого ответа или полнота карточки. Сравните текущий процесс с пилотом и учтите расходы на модели и сопровождение.</p>"
                            />
                        </FaqSection>

                        <FaqSection id="faq_tools" title="Инструменты и интеграции">
                            <FaqItem 
                                id="11" 
                                active={true}
                                parentId="accordion_faq_tools"
                                question="1. Какие инструменты разработки вы используете?" 
                                answer="<p>Подбираем модель и инструменты под задачу и ограничения. Для команд разработки можем настроить <a href='/consultation/claude-cursor-setup'>Claude Code</a>, а для бизнес-агентов — рабочую среду, интеграции и проверки.</p>"
                            />
                            <FaqItem 
                                id="12" 
                                delay="0.2s"
                                parentId="accordion_faq_tools"
                                question="2. Что такое Web API и зачем оно нужно для ИИ?" 
                                answer="<p>Web API позволяет агенту читать и записывать данные в других системах. Например, через API можно запросить статус заказа или подготовить новую запись в CRM. Разрешения зависят от операции.</p>"
                            />
                            <FaqItem 
                                id="13" 
                                delay="0.4s"
                                parentId="accordion_faq_tools"
                                question="3. Как создаются дашборды для аналитики данных?" 
                                answer="<p>Определяем показатели, источники и правила обновления. Настраиваем выгрузку данных и проверку полей перед публикацией отчёта.</p>"
                            />
                            <FaqItem 
                                id="14" 
                                delay="0.6s"
                                parentId="accordion_faq_tools"
                                question="4. SaaS и PaaS: что выбрать для ИИ-решения?" 
                                answer="<p>У SaaS часть эксплуатации берёт на себя поставщик. PaaS даёт команде среду для своего приложения. Сравниваем допустимые данные, интеграции, требования к настройке и регулярные расходы.</p>"
                            />
                            <FaqItem 
                                id="15" 
                                delay="0.8s"
                                parentId="accordion_faq_tools"
                                question="5. Инструменты веб‑разработчика: что используем для сайтов и Web API?" 
                                answer="<p>Для сайтов используем Astro и подключаем CMS или формы через API. В агентных проектах интерфейс может передавать задачу в очередь и показывать статус и итог.</p>"
                            />
                            <FaqItem 
                                id="15b" 
                                delay="1.0s"
                                parentId="accordion_faq_tools"
                                question="6. Можно ли подключить корпоративный мессенджер?"
                                answer="<p>Для каждого канала проверяем официальный способ интеграции, доступность корпоративных функций и условия обработки данных. По результатам решаем, какие операции можно подключить.</p>"
                            />
                        </FaqSection>

                        <FaqSection id="faq_pricing" title="Стоимость и запуск">
                            <FaqItem 
                                id="16" 
                                active={true}
                                parentId="accordion_faq_pricing"
                                question="1. Сколько стоит создание ИИ-агента?" 
                                answer={`<p>Разработка базового сценария ИИ-агента — ${startingPrice}. Смета на внедрение зависит от числа сценариев, интеграций и проверок. Для расчёта опишите процесс и ожидаемый результат.</p>`}
                            />
                            <FaqItem 
                                id="17" 
                                delay="0.2s"
                                parentId="accordion_faq_pricing"
                                question="2. Как начать работу над проектом автоматизации?" 
                                answer="<p>Начинаем с разбора задачи и данных. Затем согласуем пилот, доступы и критерии приёмки. После проверок решаем, что включать в рабочем контуре.</p>"
                            />
                            <FaqItem 
                                id="18" 
                                delay="0.4s"
                                parentId="accordion_faq_pricing"
                                question="3. Сколько стоит чат‑бот/бот‑автоответчик для Авито и Telegram?" 
                                answer={`<p>Базовый автоответчик в одном канале — ${startingPrice}. Дополнительные каналы и интеграции оцениваем по смете. Расходы на модель зависят от нагрузки.</p>`}
                            />
                        </FaqSection>

                        <FaqSection id="faq_excel" title="Аналитика и Excel">
                            <FaqItem 
                                id="excel1" 
                                active={true}
                                parentId="accordion_faq_excel"
                                question="1. Как создать дашборд в Excel с нуля (пошаговая инструкция)?" 
                                answer="<p>Определите источники и обязательные поля, очистите данные, подготовьте сводную таблицу и добавьте графики. Для автоматического обновления настройте подключение к источнику и проверку новых данных.</p>"
                            />
                            <FaqItem 
                                id="excel2" 
                                delay="0.2s"
                                parentId="accordion_faq_excel"
                                question="2. Визуализация данных в Excel и дашборд: что это и как сделать?" 
                                answer="<p>Дашборд объединяет несколько показателей и фильтров в одном представлении. Перед разработкой уточняем, кто пользуется отчётом, как обновляются данные и какие решения принимают по показателям.</p>"
                            />
                            <FaqItem 
                                id="excel3" 
                                delay="0.4s"
                                parentId="accordion_faq_excel"
                                question="3. Как сделать дашборд по сводной таблице в Excel?" 
                                answer="<p>Используйте очищенные данные со стабильными именами полей, добавьте сводную таблицу и график. Для нескольких источников можно подготовить данные в Power Query и фиксировать ошибки обновления.</p>"
                            />
                            <FaqItem 
                                id="excel4" 
                                delay="0.6s"
                                parentId="accordion_faq_excel"
                                question="4. Обучение дашбордам в Excel: с чего начать?" 
                                answer="<p>Начните с одного отчёта и двух-трёх ключевых показателей. На практике полезно пройти весь путь: расчёт, график, фильтры и проверку при обновлении источника.</p>"
                            />
                        </FaqSection>

                        <FaqSection id="faq_process" title="Как проходит внедрение">
                            <FaqItem 
                                id="proc1" 
                                active={true}
                                parentId="accordion_faq_process"
                                question="1. Как проходит внедрение ИИ-агента?"
                                answer="<p>Проводим аудит, определяем цель пилота и проверяем действие агента на примерах. После оценки качества подключаем рабочие системы, настраиваем мониторинг и передаём инструкции.</p>"
                            />
                            <FaqItem 
                                id="proc2" 
                                delay="0.2s"
                                parentId="accordion_faq_process"
                                question="2. Какие данные агент может использовать?"
                                answer="<p>До запуска согласуем, какие данные можно передавать модели, где хранить исходные файлы и журналы и кому предоставить доступ. Условия зависят от проекта и контуров компании.</p>"
                            />
                            <FaqItem 
                                id="proc3" 
                                delay="0.4s"
                                parentId="accordion_faq_process"
                                question="3. Зачем агенту agent harness?"
                                answer="<p>В <a href='/services/ai-solution-architecture/ai-agent-development'>agent harness</a> задаём, как агент получает задачу и контекст, какие инструменты вызывает и где фиксирует итоги. Через эту среду можно применять права, согласования и правила повторного запуска.</p>"
                            />
                        </FaqSection>

                        <FaqSection id="faq_dev" title="Разработка ботов">
                            <FaqItem 
                                id="21" 
                                active={true}
                                parentId="accordion_faq_dev"
                                question="1. На каком языке программирования пишут ботов для Telegram?" 
                                answer="<p>Python подходит для интеграций с Telegram Bot API, обработки данных и инструментов агента. Для простой маршрутизации сообщений может быть достаточно готового коннектора.</p>"
                            />
                            <FaqItem 
                                id="22" 
                                delay="0.2s"
                                parentId="accordion_faq_dev"
                                question="2. Что лучше: aiogram или pytelegrambotapi?" 
                                answer="<p>Обе библиотеки работают с Telegram Bot API. Выбор зависит от текущего кода, архитектуры приложения и поддержки нужных функций. Нагрузку проверяем отдельно.</p>"
                            />
                            <FaqItem 
                                id="23" 
                                delay="0.4s"
                                parentId="accordion_faq_dev"
                                question="3. Как сделать аукцион в Telegram?" 
                                answer="<p>Нужны правила ставок, время завершения и журнал действий. До разработки согласуем обработку одновременных ставок, отмен и уведомлений.</p>"
                            />
                            <FaqItem 
                                id="24" 
                                delay="0.6s"
                                parentId="accordion_faq_dev"
                                question="4. Есть ли на Авито боты и как включить автоответ?" 
                                answer="<p>Если типовых ответов недостаточно, можно дополнить их поиском по каталогу и передачей заявки в рабочую систему. Проверяем доступность официальных интеграций и оговариваем правила общения.</p>"
                            />
                            <FaqItem 
                                id="25" 
                                delay="0.8s"
                                parentId="accordion_faq_dev"
                                question="5. Бот для участия в торгах и тендерах: что умеет?" 
                                answer="<p>Сценарий может отслеживать сроки, собрать документы и подготовить заявку для проверки. Действия с юридическими последствиями оставляем на согласовании ответственного.</p>"
                            />
                        </FaqSection>

                        <!-- Дополнительные вопросы по разработке ИИ и RAG -->
                        <FaqSection id="faq_extra" title="LLM и RAG — частые вопросы">
                            <FaqItem 
                                id="31" 
                                active={true}
                                parentId="accordion_faq_extra"
                                question="1. LLM и RAG: что это и как работает вместе?" 
                                answer="<p>Модель формирует ответ, а RAG находит материалы, на которые она может опираться. Проверяем качество поиска и соответствие ответа источникам отдельно.</p>"
                            />
                            <FaqItem 
                                id="32" 
                                delay="0.2s"
                                parentId="accordion_faq_extra"
                                question="2. LLM-агенты: что это такое?" 
                                answer="<p>Такой агент использует языковую модель для выбора шага и вызова разрешённых инструментов. Например, он может проверить наличие данных и подготовить обновление карточки после согласования.</p>"
                            />
                            <FaqItem 
                                id="33" 
                                delay="0.4s"
                                parentId="accordion_faq_extra"
                                question="3. «Безлимитный» ИИ-агент: возможен ли фикс-прайс?" 
                                answer="<p>Затраты зависят от модели, объёма контекста и количества операций. На пилоте оцениваем реальную нагрузку и обсуждаем лимиты, кэширование и расходы на инфраструктуру.</p>"
                            />
                        </FaqSection>

    </FaqPageContent>
    <!-- Page Faqs End -->

    <Cta/>

    <Footer/>
</Layout>