    "/services/web-support/website-speed-optimization": {
        description: "Начинаем с тех страниц и устройств, на которых посетители дольше всего ждут результата. Дальше оцениваем вклад сети, сервера и работы браузера, чтобы выбрать наиболее полезные изменения. После правок сравниваем результаты в сопоставимых условиях и проверяем, что функции сайта работают как прежде.",
        cards: [
            ["Замеры загрузки", "Проверяем ресурсы и критические этапы отрисовки на страницах, где заметно замедление."],
            ["Оптимизация ресурсов", "Сокращаем вес изображений и настраиваем порядок загрузки скриптов и запросов."],
        ],
    },
    "/services/web-support/website-technical-support": {
        description: "При технической поддержке уточняем, какие сбои требуют немедленной реакции и какие можно включить в план работ. Для каждой проблемы фиксируем, как её повторить и по каким признакам видно, что она устранена. Это даёт команде понятную картину работ и снижает риск повторных ошибок.",
        cards: [
            ["Логи приложения", "Сопоставляем ошибки с действиями пользователя, чтобы воспроизвести проблему."],
            ["Проверка обновлений", "Тестируем исправления на затронутых страницах и формах перед переносом на рабочий сайт."],
        ],
    },
};

const defaultCardIcons = [
    "/images/icon-service-offer-list-1.svg",
    "/images/icon-service-offer-list-2.svg",
];
const { servicePath } = Astro.props;
const isGeneralStack = servicePath === undefined;
const isLocalStack = servicePath === "/services/ai-training/llm-fine-tuning";
const serviceStack = isGeneralStack ? undefined : serviceStacks[servicePath];
const items: WorksItem[] = isGeneralStack
    ? works
    : (serviceStack?.cards ?? []).map(([name, description, icon], index) => ({
        name,
        description,
        icon: icon ?? defaultCardIcons[index % defaultCardIcons.length],
    }));

const title = isGeneralStack
    ? "Какие модели мы используем"
    : isLocalStack ? "Как устроена локальная среда" : "Как устроено решение";
const description = isGeneralStack
    ? "Подбираем языковую модель под задачу и проверяем её на рабочих примерах перед подключением к системам компании."
    : serviceStack?.description;
---

{items.length > 0 && (
    <>
        {!isGeneralStack && <Spacer />}
        <!-- Our Works Section Start -->
        <div class='our-awards-prime bg-section'>
            <div class='container'>
                <div class='row'>
                    <div class='col-xl-6'>
                        <!-- Works Item Content Start -->
                        <div class='awards-content-prime'>
                            <!-- Section Title Start -->
                            <div class='section-title'>
                                <span class='section-sub-title wow fadeInUp'>Технологический стек</span>
                                <h2 class='text-anime-style-3' data-cursor='-opaque'>{title}</h2>
                                {description && <p class='wow fadeInUp' data-wow-delay='0.2s'>{description}</p>}
                            </div>
                            <!-- Section Title End -->

                            <!-- Works Item Counter Box Start -->
                            {isGeneralStack && (
                                <div class='awards-counter-box-prime wow fadeInUp'>
                                    <h2><span class='counter'>10</span>+</h2>
                                    <p>Ведущих AI-лабораторий в нашем арсенале.</p>
                                </div>
                            )}
                            <!-- Works Item Counter Box End -->
                        </div>
                        <!-- Works Item Content End -->
                    </div>

                    <div class='col-xl-6'>
                        <!-- Works Item List Start -->
                        <div class='awards-item-list-prime box-border-gradiant'>
                            {items.map((item, index) => (
                                <!-- Works Item Start -->
                                <div class={`awards-item-prime wow fadeInUp`} data-wow-delay={`${index * 0.1}s`}>
                                    <!-- Works Items Start -->
                                    <div class='awards-item-body-prime'>
                                        <div class='icon-box'>
                                            <img loading="lazy" decoding="async" src={item.icon} alt={item.name} style='width: 80px; height: 80px; filter: brightness(0) invert(1);'>
                                        </div>
                                        <div class='awards-item-content-prime'>
                                            <h3>{item.name}</h3>
                                            <p>{item.description}</p>
                                        </div>
                                    </div>
                                    <!-- Works Items End -->

                                    <!-- Works Item Year Start -->
                                    {item.year && (
                                        <div class='awards-item-year-prime'>
                                            <h3>{item.year}</h3>
                                        </div>
                                    )}
                                    <!-- Works Item Year End -->
                                </div>
                                <!-- Works Item End -->
                            ))}
                        </div>
                        <!-- Works Item List End -->
                    </div>
                </div>
            </div>
        </div>
        <!-- Our Works Section End -->
        {!isGeneralStack && <Spacer />}
    </>
)}

<style>
    .awards-item-body-prime:only-child {
        width: 100%;
    }

    .awards-item-year-prime h3 {
        font-size: 32px !important;
    }
</style>
