---
import { formatPrice, getPackages } from "../lib/pricing";

interface PricingItem {
    title: string;
    price: string;
    description: string;
    features: string[];
    icon?: string;
    term?: string;
    highlighted?: boolean;
}

interface Props {
    subTitle?: string;
    title?: string;
    description?: string;
    pricingItems?: PricingItem[];
}

const {
    subTitle = "Тарифные планы",
    title = "Выберите подходящий вариант для вашего бизнеса",
    description = "Гибкие условия сотрудничества, адаптированные под масштаб и задачи вашего проекта. От простых интеграций до разработки сложных экосистем.",
    pricingItems = getPackages().map((pkg) => ({
        title: pkg.name,
        price: formatPrice(pkg),
        description: pkg.description,
        features: pkg.features,
        icon: pkg.icon,
        term: pkg.term,
        highlighted: pkg.highlighted,
    })),
} = Astro.props;
---
<!-- Our Pricing Plan Section Start -->
<div class="our-pricing-prime">
    <div class="container">
        <div class="row section-row">
            <div class="col-lg-12">
                <!-- Section Title Start -->
                <div class="section-title section-title-center">
                    <span class="section-sub-title wow fadeInUp">{subTitle}</span>
                    <h2 class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
                    <p class="wow fadeInUp" data-wow-delay="0.2s">{description}</p>
                </div>
                <!-- Section Title End -->
            </div>
        </div>

        <div class="row pricing-items-list">
            {pricingItems.map((item, index) => (
                <div class="col-xl-4 col-md-6">
                    <!-- Pricing Item Start -->
                    <div class:list={["pricing-item", "box-border-gradiant", "wow", "fadeInUp", { "pricing-item--highlighted": item.highlighted }]} data-wow-delay={`${index * 0.2}s`}>
                        <!-- Pricing Item Header Start -->
                        <div class="pricing-item-header">
                            <div class="icon-box">
                                <img src={item.icon || `/images/icon-pricing-${index + 1}.svg`} alt={item.title} loading="lazy" decoding="async">
                            </div>
                            <div class="pricing-item-header-title">
                                <h2>{item.title}</h2>
                            </div>
                        </div>
                        <!-- Pricing Item Header End -->

                        <!-- Pricing Item Price Start -->
                        <div class="pricing-item-price">
                            <h2>{item.price}</h2>
                            {item.term && <p class="pricing-item-term">Срок: {item.term}</p>}
                            <p>{item.description}</p>
                        </div>
                        <!-- Pricing Item Price End -->

                        <!-- Pricing Item Button Start -->
                        <div class="pricing-item-btn">
                            <a href="/contact" class="btn-default" data-cursor="-opaque">Обсудить проект</a>
                        </div>
                        <!-- Pricing Item Button End -->

                        <!-- Pricing Item List Start -->
                        <div class="pricing-item-list">
                            <h3>Что включено:</h3>
                            <ul>
                                {item.features.map((feature) => (
                                    <li>{feature}</li>
                                ))}
                            </ul>
                        </div>
                        <!-- Pricing Item List End -->
                    </div>
                    <!-- Pricing Item End -->
                </div>
            ))}

            <div class="col-lg-12">
                <!-- Pricing Benifit List Start -->
                <div class="pricing-benefit-list wow fadeInUp" data-wow-delay="0.6s">
                    <ul>
                        <li><img src="/images/icon-pricing-benefit-1.svg" alt="Гарантия" loading="lazy">Бесплатная консультация</li>
                        <li><img src="/images/icon-pricing-benefit-2.svg" alt="Прозрачность" loading="lazy">Никаких скрытых платежей</li>
                        <li><img src="/images/icon-pricing-benefit-3.svg" alt="Гибкость" loading="lazy">Гибкое управление задачами</li>
                    </ul>
                </div>
                <!-- Pricing Benifit List End -->
            </div>

            <div class="col-lg-12">
                <div class="pricing-calculator-cta">
                    <p>Не знаете, какой формат подходит? Ответьте на четыре вопроса.</p>
                    <a href="/calculator" class="btn-default" data-cursor="-opaque">Рассчитать стоимость</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Our Pricing Plan Section End -->

<style>
    .pricing-calculator-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: center;
        justify-content: center;
        margin-top: 32px;
    }
    .pricing-calculator-cta p { margin: 0; color: var(--text-color); }
    .pricing-item-term {
        margin: 4px 0 12px;
        color: var(--accent-color);
        font-size: 15px;
    }
    .pricing-item--highlighted {
        border-color: var(--accent-color);
    }
</style>
