---
import type { PublicServiceOffer } from "../../lib/service-pricing";

interface Props {
    offer: PublicServiceOffer;
    cluster?: string;
    fromHub?: boolean;
}
const { offer, cluster, fromHub = false } = Astro.props;
const calculatorUrl = cluster ? `/calculator?service=${encodeURIComponent(cluster)}#estimate-catalog` : "/calculator";
---
<div class="service-price-note">
    <div class="container">
        <div class="service-price-note__inner box-border-gradiant">
            <dl class="service-price-note__facts">
                <div>
                    <dt>{fromHub ? "Старт в направлении" : "Стоимость"}</dt>
                    <dd class="service-price-note__price">{offer.priceLabel}</dd>
                </div>
                {!fromHub && offer.term && (
                    <div>
                        <dt>Срок</dt>
                        <dd>{offer.term}</dd>
                    </div>
                )}
            </dl>
            <a href={calculatorUrl} class="btn-default service-price-note__cta" data-cursor="-opaque">
                Рассчитать стоимость
            </a>
        </div>
    </div>
</div>

<style>
    .service-price-note { padding: 18px 0 0; }
    .service-price-note__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: clamp(20px, 3vw, 32px);
    }
    .service-price-note__facts {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 12px clamp(20px, 4vw, 48px);
        min-width: 0;
        margin: 0;
        color: var(--primary-color);
        overflow-wrap: anywhere;
    }
    .service-price-note__facts dt {
        margin-bottom: 4px;
        color: var(--text-color);
        font-size: 14px;
        font-weight: 500;
    }
    .service-price-note__facts dd {
        margin: 0;
        font-weight: 600;
    }
    .service-price-note__price {
        font-size: clamp(24px, 3.2vw, 36px);
        line-height: 1.15;
    }
    .service-price-note__cta:focus-visible {
        outline: 2px solid var(--accent-color);
        outline-offset: 4px;
    }
    @media (max-width: 575px) {
        .service-price-note__cta { width: 100%; }
    }
</style>
