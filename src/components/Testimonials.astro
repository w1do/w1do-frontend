---
import { Image } from 'astro:assets';

interface TestimonialItem {
    rating: number;
    text: string;
    authorName: string;
    authorRole: string;
    authorImage: string;
}

interface Props {
    homeOriginal?: boolean;
    subTitle?: string;
    title?: string;
    description?: string;
    testimonials?: TestimonialItem[];
    ctaText?: string;
    showFeedback?: boolean;
}

const {
    homeOriginal = false,
    subTitle = "Отзывы клиентов",
    title = homeOriginal ? "Что говорят клиенты о моем опыте разработки ИИ" : "Как клиенты оценивают работу AiCRAFT",
    description = homeOriginal ? "Компании и предприниматели доверяют мне разработку ИИ-решений, которые реально влияют на бизнес-показатели и автоматизируют рутину." : "Отзывы о совместной работе и внедрении решений.",
    testimonials = [],
    ctaText = homeOriginal ? "Пилот запускаем на ограниченном участке, чтобы результат был измеримым." : "В пилоте согласуем, как измерить результат до рабочего запуска.",
    showFeedback = false,
} = Astro.props;

const hasTestimonials = testimonials.length > 0;
if (!hasTestimonials && !showFeedback) return null;
---
<!-- Our Testimonials Section Start -->
<div class="our-testimonials">
    <div class="container">
        <div class="row section-row align-items-center">
            <div class="col-xl-6">
                <!-- Section Title Start -->
                <div class="section-title">
                    <span class="section-sub-title wow fadeInUp">{subTitle}</span>
                    <h2 class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
                </div>
                <!-- Section Title End -->
            </div>

            <div class="col-xl-6">
                <!-- Section Content Button Start -->
                <div class="section-content-btn">
                    <!-- Section Title Content Start -->
                    <div class="section-title-content wow fadeInUp" data-wow-delay="0.2s">
                        <p>{description}</p>
                    </div>
                    <!-- Section Title Content End -->

                    <!-- Section Button Start -->
                    <div class="section-btn wow fadeInUp" data-wow-delay="0.4s">
                        <a href={homeOriginal ? "/testimonials/" : "/testimonials"} class="btn-default">{hasTestimonials ? "Все отзывы" : "Оставить отзыв"}</a>
                    </div>
                    <!-- Section Button End -->
                </div>
                <!-- Section Content Button End -->
            </div>
        </div>

        <div class="row">
            <div class="col-xl-4 col-lg-5">
                <!-- Testimonial Image Box Start -->
                <div class="testimonial-image-box wow fadeInUp">
                    <!-- Testimonial image Start -->
                    <div class="testimonial-image">
                        <figure>
                            <Image src="/images/testimonial-image.jpg" alt={homeOriginal ? "Отзыв клиента AI агентства" : ""} width={800} height={600} loading="lazy" />
                        </figure>
                    </div>
                    <!-- Testimonial image End -->

                    <!-- Testimonials CTA Box Start -->
                    <div class="testimonials-cta-box">
                        {homeOriginal && (
                            <div class="satisfy-client-images">
                                <div class="satisfy-client-image">
                                    <figure class="image-anime">
                                        <img loading="lazy" decoding="async" src="/images/author-1.jpg" alt="Александр Волков">
                                    </figure>
                                </div>
                                <div class="satisfy-client-image">
                                    <figure class="image-anime">
                                        <img loading="lazy" decoding="async" src="/images/author-2.jpg" alt="Мария Соколова">
                                    </figure>
                                </div>
                                <div class="satisfy-client-image">
                                    <figure class="image-anime">
                                        <img loading="lazy" decoding="async" src="/images/author-3.jpg" alt="Дмитрий Иванов">
                                    </figure>
                                </div>
                                <div class="satisfy-client-image">
                                    <figure class="image-anime">
                                        <img loading="lazy" decoding="async" src="/images/author-4.jpg" alt="Клиент">
                                    </figure>
                                </div>
                            </div>
                        )}
                        <div class="testimonials-cta-content">
                            <p>{homeOriginal && "“ "}{ctaText}</p>
                        </div>
                        <!-- Testimonials CTA Content End -->
                    </div>
                    <!-- Testimonials CTA Box End -->
                </div>
                <!-- Testimonial Image Box End -->
            </div>

            <div class="col-xl-8 col-lg-7">
                {hasTestimonials ? (
                <div class="testimonial-slider box-border-gradiant">
                    <div class="swiper">
                        <div class="swiper-wrapper" data-cursor-text="Drag">
                            {testimonials.map((item) => (
                                <!-- Testimonial Slide Start -->
                                <div class="swiper-slide">
                                    <!-- Testimonial Item Start -->
                                    <div class="testimonial-item">
                                        <!-- Testimonial Item Header Start -->
                                        <div class="testimonial-item-header">
                                            <!-- Testimonial Item Rating Start -->
                                            <div class="testimonial-item-rating">
                                                {[...Array(item.rating)].map(() => (
                                                    <i class="fa fa-solid fa-star"></i>
                                                ))}
                                            </div>
                                            <!-- Testimonial Item Rating End -->

                                            <!-- Testimonial Item Content Start -->
                                            <div class="testimonial-item-content">
                                                <p>“ {item.text} ”</p>{homeOriginal && " "}
                                            </div>
                                            <!-- Testimonial Item Content End -->
                                        </div>
                                        <!-- Testimonial Item Header End -->

                                        <!-- Testimonial Item Author Start -->
                                        <div class="testimonial-item-author">
                                            <div class="testimonial-author-image">
                                                <figure class="image-anime">
                                                    <img src={item.authorImage} alt={item.authorName} loading="lazy">
                                                </figure>
                                            </div>
                                            <div class="testimonial-author-content">
                                                <h2>{item.authorName}</h2>{homeOriginal && " "}
                                                <p>{item.authorRole}</p>{homeOriginal && " "}
                                            </div>
                                        </div>
                                        <!-- Testimonial Item Author End -->
                                    </div>
                                    <!-- Testimonial Item End -->
                                </div>
                                <!-- Testimonial Slide End -->
                            ))}
                        </div>
                        <div class="testimonial-slider-btn">
                            <div class="testimonial-button-prev"></div>
                            <div class="testimonial-button-next"></div>
                        </div>
                    </div>
                </div>
                ) : (
                    <div class="testimonial-feedback box-border-gradiant wow fadeInUp">
                        <h3>Что написать в отзыве</h3>
                        <p>Расскажите, какую задачу мы решали вместе, что получилось после запуска и что нам стоит улучшить.</p>
                        <a href="/contact" class="btn-default">Написать в AiCRAFT</a>
                    </div>
                )}
            </div>
        </div>
    </div>
</div>
<!-- Our Testimonials Section End -->

<style>
    .testimonial-feedback {
        display: flex;
        min-height: 100%;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 16px;
        padding: clamp(24px, 4vw, 56px);
    }

    .testimonial-feedback h3,
    .testimonial-feedback p {
        margin: 0;
    }
</style>
