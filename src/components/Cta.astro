---
import ContactForm from "./contact/ContactForm";

interface Props {
    homeOriginal?: boolean;
    subTitle?: string;
    title?: string;
    description?: string;
    formTitle?: string;
    source?: string;
    formId?: string;
    btnText?: string;
    btnLink?: string;
}

const {
    homeOriginal = false,
    subTitle = homeOriginal ? "Свяжитесь с командой AiCRAFT" : "Обсудить задачу",
    title = homeOriginal ? "Воплотите ваши идеи в реальность с помощью ИИ" : "Расскажите, где вам нужен ИИ",
    description = homeOriginal ? "Вместе с вашей командой разберём задачу и предложим сценарий автоматизации. На первой встрече обсудим данные, нужные интеграции и ожидаемый результат." : "Опишите процесс, системы и результат, который хотите получить. Подскажем, с какого сценария начать и что потребуется для проверки.",
    formTitle = "Оставить заявку",
    source = "cta-block",
    formId,
} = Astro.props;

const contactFormProps = { variant: "compact" as const, source, formId, title: formTitle, homeOriginal };
---
<!-- Cta Box Section Start -->
<div class="cta-box bg-section">
    <div class="container">
        <div class="row">
            <div class="col-xl-6">
                <!-- Cta Box Content Start -->
                <div class="cta-box-content">
                    <!-- Section Title Start -->
                    <div class="section-title">
                        <span class="section-sub-title wow fadeInUp">{subTitle}</span>
                        <h2 class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
                        <p class="wow fadeInUp" data-wow-delay="0.2s">{description}</p>
                    </div>
                    <!-- Section Title End -->

                    {homeOriginal && (
                        <div class="cta-btn wow fadeInUp" data-wow-delay="0.4s">
                            <a href={import.meta.env.PUBLIC_TELEGRAM_URL || "https://t.me/W1DO_DIGITAL"} class="btn-default">Написать в Telegram</a>
                        </div>
                    )}
                </div>
                <!-- Cta Box Content End -->
            </div>

            <div class="col-xl-6">
                {homeOriginal ? (
                    <div class="cta-form-box box-border-gradiant">
                        <ContactForm client:idle {...contactFormProps} />
                    </div>
                ) : (
                    <ContactForm client:idle {...contactFormProps} />
                )}
            </div>
        </div>
    </div>
</div>
<!-- Cta Box Section End -->
