---
import { formatPrice, getPackages, RETAINER } from "../../lib/pricing";

const packages = getPackages();
---
<!-- Dev Pricing Section Start -->
<div class="our-pricing-prime">
    <div class="container">
        <div class="row section-row">
            <div class="col-lg-12">
                <div class="section-title section-title-center">
                    <span class="section-sub-title wow fadeInUp">Стоимость услуг</span>
                    <h2 class="text-anime-style-3" data-cursor="-opaque">Цены на разработку и внедрение ИИ</h2>
                    <p class="wow fadeInUp" data-wow-delay="0.2s">Одна сетка для главной, услуг и этой страницы: от аудита до внедрения. Точную смету считаем после разбора задачи.</p>
                </div>
            </div>
        </div>

        <div class="row pricing-items-list">
            {packages.map((pkg, index) => (
                <div class="col-xl-4 col-md-6">
                    <div class="pricing-item box-border-gradiant wow fadeInUp" data-wow-delay={`${index * 0.2}s`}>
                        <div class="pricing-item-header">
                            <div class="icon-box">
                                <img src={pkg.icon} alt={pkg.name} loading="lazy" decoding="async">
                            </div>
                            <div class="pricing-item-header-title">
                                <h2>{pkg.name}</h2>
                            </div>
                        </div>

                        <div class="pricing-item-price">
                            <h2>{formatPrice(pkg)}</h2>
                            <p class="pricing-item-term">Срок: {pkg.term}</p>
                            <p>{pkg.description}</p>
                        </div>

                        <div class="pricing-item-btn">
                            <a href="/contact" class="btn-default" data-cursor="-opaque">{pkg.ctaLabel}</a>
                        </div>

                        <div class="pricing-item-list">
                            <h3>Что входит:</h3>
                            <ul>
                                {pkg.features.map((feature) => <li>{feature}</li>)}
                            </ul>
                        </div>
                    </div>
                </div>
            ))}

            <div class="col-xl-4 col-md-6">
                <div class="pricing-item box-border-gradiant wow fadeInUp" data-wow-delay="0.6s">
                    <div class="pricing-item-header">
                        <div class="icon-box">
                            <img src="/images/icon-pricing-benefit-1.svg" alt={RETAINER.name} loading="lazy" decoding="async">
                        </div>
                        <div class="pricing-item-header-title">
                            <h2>{RETAINER.name}</h2>
                        </div>
                    </div>

                    <div class="pricing-item-price">
                        <h2>{formatPrice(RETAINER)}</h2>
                        <p class="pricing-item-term">Срок: {RETAINER.term}</p>
                        <p>{RETAINER.description}</p>
                    </div>

                    <div class="pricing-item-btn">
                        <a href="/contact" class="btn-default" data-cursor="-opaque">Обсудить поддержку</a>
                    </div>

                    <div class="pricing-item-list">
                        <h3>Что входит:</h3>
                        <ul>
                            {RETAINER.features.map((feature) => <li>{feature}</li>)}
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="pricing-calculator-cta">
            <p>Не знаете, какой формат подходит? Ответьте на четыре вопроса.</p>
            <a href="/calculator" class="btn-default" data-cursor="-opaque">Рассчитать стоимость</a>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="pricing-benefit-list wow fadeInUp" data-wow-delay="0.8s">
                    <ul>
                        <li><img src="/images/icon-pricing-benefit-1.svg" alt="Гарантия" loading="lazy">Разбор задачи перед стартом</li>
                        <li><img src="/images/icon-pricing-benefit-2.svg" alt="Прозрачность" loading="lazy">Никаких скрытых платежей</li>
                        <li><img src="/images/icon-pricing-benefit-3.svg" alt="Гибкость" loading="lazy">Гибкое управление задачами</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Dev Pricing Section End -->

<style>
    .pricing-calculator-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: center;
        justify-content: center;
        margin: 8px 0 32px;
    }
    .pricing-calculator-cta p { margin: 0; color: var(--text-color); }
    .pricing-item-term {
        margin: 4px 0 12px;
        color: var(--accent-color);
        font-size: 15px;
    }
</style>
