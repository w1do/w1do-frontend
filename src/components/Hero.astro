---
import { Image } from 'astro:assets';

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Разработчик ИИ",
    description = "Разработка ИИ-агентов, автоматизация бизнеса и внедрение нейросетей."
} = Astro.props;
---
<!-- Hero Section Start -->
<div class="hero-prime">
    <!-- Video Start -->
    <div class="hero-bg-video-prime">
        <!-- Selfhosted Video Start -->
        <!-- <video autoplay muted loop id="herovideo"><source src="/images/hero-bg-video.mp4" type="video/mp4"></video> -->
        <video autoplay="" muted="" playsinline="" loop="" id="myvideo" preload="metadata"><source src="/videos/hero.mp4" type="video/mp4"></video>
        <!-- Selfhosted Video End -->

        <!-- Youtube Video Start -->
        <!-- <div id="herovideo" class="player" data-property="{videoURL:'OjTRVpgtcG4',containment:'.hero-video', showControls:false, autoPlay:true, loop:true, vol:0, mute:false, startAt:0,  stopAt:296, opacity:1, addRaster:true, quality:'large', optimizeDisplay:true}"></div> -->
        <!-- Youtube Video End -->
    </div>
    <!-- Video End -->

    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <!-- Hero Content Box Start -->
                <div class="hero-content-box-prime">
                    <!-- Hero Sub Heading Start -->
                    <a href="/chat" data-open-chat aria-haspopup="dialog" class="hero-sub-heading-prime hero-assistant-notice wow fadeInUp">
                        <img src="/images/assistant-robot.svg" alt="" aria-hidden="true" width="44" height="44">
                        <span>Заявки принимаются только через ИИ ассистента</span>
                    </a>
                    <!-- Hero Sub Heading End -->

                    <!-- Section Title Start -->
                    <div class="section-title">
                        <h1 class="wow fadeInUp" data-wow-delay="0.2s" data-cursor="-opaque">{title}</h1>
                        <p class="wow fadeInUp" data-wow-delay="0.4s">{description}</p>
                    </div>
                    <!-- Section Title End -->

                    <!-- Hero Content Counter Box Start -->
                    <div class="hero-content-counter-box-prime">
                        <!-- Hero Counter Box Start -->
                        <div class="hero-counter-box-prime">
                            <h2><span class="counter">95</span>%</h2>
                            <p>Уровень удовлетворенности</p>
                        </div>
                        <!-- Hero Counter Box End -->

                        <!-- Hero Counter Box Start -->
                        <div class="hero-counter-box-prime">
                            <h2><span class="counter">12</span>+ лет</h2>
                            <p>Опыта в разработке и автоматизации</p>
                        </div>
                        <!-- Hero Counter Box End -->

                        <!-- Hero Counter Box Start -->
                        <div class="hero-counter-box-prime">
                            <h2><span class="counter">250</span>+</h2>
                            <p>Реализованных проектов</p>
                        </div>
                        <!-- Hero Counter Box End -->
                    </div>
                    <!-- Hero Content Counter Box End -->

                    <!-- Hero Footer Start -->
                    <div class="hero-footer-prime wow fadeInUp" data-wow-delay="0.2s">
                        <!-- Hero Button Start -->
                        <div class="hero-btn-prime">
                            <a href="/chat" data-open-chat aria-haspopup="dialog" class="btn-default" data-cursor="-opaque">Обсудить проект</a>
                        </div>
                        <!-- Hero Button End -->

                        <!-- Google Rating Box Start -->
                        <div class="google-rating-box-prime">
                            <div class="google-rating-info-prime">
                                <div class="google-rating-info-header-prime">
                                    <h2><span class="counter">4.9</span>/5</h2>
                                    <span class="google-rating-star-prime"><i class="fa fa-solid fa-star"></i><i class="fa fa-solid fa-star"></i><i class="fa fa-solid fa-star"></i><i class="fa fa-solid fa-star"></i><i class="fa fa-solid fa-star"></i></span>
                                </div>
                                <div class="google-rating-info-content-prime">
                                    <p>Более 100 положительных отзывов на фриланс-биржах</p>
                                </div>
                            </div>
                        </div>
                        <!-- Google Rating Box End -->
                    </div>
                    <!-- Hero Footer End -->
                </div>
                <!-- Hero Content Box End -->
            </div>
        </div>
    </div>
</div>
<!-- Hero Section End -->

<style>
    .hero-assistant-notice {
        width: min(720px, 100%);
        justify-content: center;
        min-height: 58px;
        padding: 8px 22px;
        color: var(--white-color);
        font-size: 16px;
        font-weight: 500;
        line-height: 1.5;
        text-align: left;
    }
    .hero-assistant-notice:hover { color: var(--white-color); }
    .hero-assistant-notice:focus-visible {
        outline: 2px solid var(--accent-color);
        outline-offset: 4px;
    }
    .hero-assistant-notice img {
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }
    @media (max-width: 767px) {
        .hero-assistant-notice { gap: 12px; padding: 8px 14px; font-size: 15px; }
    }
</style>
