---
import ContactForm from "./contact/ContactForm";

interface Props {
    title?: string;
    description?: string;
    quickRequest?: boolean;
}

const {
    quickRequest = false,
    title = "Разработка ИИ-агентов для бизнеса",
    description = "Проектируем и внедряем ИИ-агентов для работы с заявками, клиентами, документами и внутренними процессами. Интегрируем с CRM, ERP, мессенджерами и вашими данными."
} = Astro.props;

const services = [
    {
        key: "infrastructure",
        chipLabel: "Инфраструктура",
        title: "Инфраструктура для ИИ",
        description: quickRequest ? "Готовим серверы для запуска агентов и настраиваем мониторинг, чтобы команда видела нагрузку и сбои." : "Разворачиваем и масштабируем надёжную инфраструктуру под ваши ИИ-задачи.",
        image: "/images/hero-service-infrastructure.webp",
    },
    {
        key: "claude-code",
        chipLabel: "Claude Code",
        title: "Настройка Claude Code",
        description: quickRequest ? "Настраиваем Claude Code для команды разработки. Подключаем инструменты, задаём права и правила работы с репозиторием." : "Интегрируем и настраиваем Claude Code под ваши процессы и команду.",
        image: "/images/hero-service-claude-code.webp",
    },
    {
        key: "ai-agent",
        chipLabel: "ИИ-агент",
        requestTitle: "Внедрение ИИ-агента",
        title: "ИИ-агенты для бизнеса",
        description: quickRequest ? "Для бухгалтерии агент может сверить сумму счёта с заказом и передать расхождения сотруднику до оплаты." : "Создаём автономных ИИ-агентов, которые берут на себя рутину и приносят результат.",
        image: "/images/hero-service-ai-agents.webp",
    },
    {
        key: "claude-tunnel",
        chipLabel: "Туннелирование",
        title: "Туннелирование Claude Code",
        description: quickRequest ? "Настраиваем сетевой маршрут для Claude Code, когда команде нужен доступ из выбранного региона." : "Настраиваем туннелирование трафика Claude Code с привязкой к выбранному гео.",
        image: "/images/hero-service-geo-tunnel.webp",
    }
];
const formAnchor = "quick-request";
const requestLink = (key = "ai-agent") =>
    quickRequest ? `#${formAnchor}-${key}` : "/contact";
const serviceOptions = services.map(service => ({
    anchor: requestLink(service.key),
    chipLabel: service.chipLabel,
    label: service.requestTitle ?? service.title,
})).sort((a, b) => Number(b.anchor === requestLink()) - Number(a.anchor === requestLink()));
---
<div class="hero-prime">
    <div class="hero-bg-video-prime">
        <video autoplay muted playsinline loop id="myvideo" preload="metadata" poster="/images/hero-poster.webp" aria-hidden="true" tabindex="-1"><source src="/videos/hero.mp4" type="video/mp4" media="(min-width: 768px)"></video>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <!-- Hero Content Box Start -->
                <div class="hero-content-box-prime">
                    <div class="hero-sub-heading-prime hero-assistant-notice wow fadeInUp">
                        <img src="/images/assistant-robot.svg" alt="" aria-hidden="true" width="44" height="44">
                        <span>Оставьте заявку — обсудим задачу и предложим решение</span>
                        <a href={requestLink()} aria-label="Оставить заявку" class="hero-assistant-notice__button">
                            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                        </a>
                    </div>

                    <!-- Section Title Start -->
                    <div class="section-title">
                        <h1 class="wow fadeInUp" data-wow-delay="0.2s" data-cursor="-opaque">{title}</h1>
                        <p class="wow fadeInUp" data-wow-delay="0.4s">{description}</p>
                    </div>
                    <!-- Section Title End -->

                    <!-- Hero Services Start -->
                    <div class="hero-content-counter-box-prime hero-services">
                        {services.map((service, index) => (
                            <article class="hero-service">
                                <img class="hero-service__image" src={service.image} alt="" width="960" height="640" loading="eager" decoding="async" fetchpriority={index === 0 ? "high" : undefined} />
                                <div class="hero-service__body">
                                    <h2>{service.title}</h2>
                                    <p class="hero-service__description">{service.description}</p>
                                    <a href={requestLink(service.key)} aria-label={`Обсудить услугу «${service.title}»`} class="hero-service__button">
                                        <span>Обсудить</span>
                                        <span class="hero-service__arrow" aria-hidden="true">→</span>
                                    </a>
                                </div>
                            </article>
                        ))}
                    </div>
                    <!-- Hero Services End -->

                    <!-- Hero Footer Start -->
                    <div class="hero-footer-prime wow fadeInUp" data-wow-delay="0.2s">
                        <!-- Hero Button Start -->
                        <div class="hero-btn-prime">
                            <a href={requestLink()} class="btn-default" data-cursor="-opaque">Обсудить ИИ-агента</a>
                        </div>
                        <!-- Hero Button End -->

                        <!-- Google Rating Box Start -->
                        <div class="google-rating-box-prime">
                            <div class="google-rating-info-prime">
                                <div class="google-rating-info-header-prime">
                                    <h2><span class="counter">4.9</span>/5</h2>
                                    <span class="google-rating-star-prime"><i class="fa fa-solid fa-star"></i><i class="fa fa-solid fa-star"></i><i class="fa fa-solid fa-star"></i><i class="fa fa-solid fa-star"></i><i class="fa fa-solid fa-star"></i></span>
                                </div>
                                <div class="google-rating-info-content-prime">
                                    <p>Более 100 положительных отзывов на фриланс-биржах</p>
                                </div>
                            </div>
                        </div>
                        <!-- Google Rating Box End -->
                    </div>
                    <!-- Hero Footer End -->
                </div>
                <!-- Hero Content Box End -->
            </div>
        </div>
    </div>
</div>

<slot name="after-hero" />

{quickRequest && (
    <div>
        <div class="container">
            <section class="quick-request" id={formAnchor} aria-labelledby="quick-request-title">
                {serviceOptions.map(service => (
                    <span class="quick-request__anchor" id={service.anchor.slice(1)} aria-hidden="true"></span>
                ))}
                <div class="quick-request__intro">
                    <h2 id="quick-request-title">Обсудим ваш проект</h2>
                    <p>Выберите услугу и оставьте телефон. Перезвоним, чтобы разобрать вашу задачу и предложить первый шаг.</p>
                </div>
                <ContactForm client:load variant="quick" source="home-quick-request" formId={`${formAnchor}-form`} services={serviceOptions} />
            </section>
        </div>
    </div>
)}

<style>
    .hero-services {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        width: 100%;
        max-width: none;
        gap: 20px;
        align-items: stretch;
        text-align: left;
    }
    .hero-service {
        position: relative;
        isolation: isolate;
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding: 12px;
        border: 1px solid rgba(255, 255, 255, .18);
        border-radius: 24px;
        background: linear-gradient(145deg, rgba(255, 255, 255, .055), transparent 42%), rgba(20, 20, 20, .58);
        -webkit-backdrop-filter: blur(16px);
        backdrop-filter: blur(16px);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .08), 0 18px 42px rgba(0, 0, 0, .15);
        transition: border-color .25s ease, box-shadow .25s ease;
    }
    .hero-service__image {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1.75;
        object-fit: cover;
        border-radius: 16px;
    }
    .hero-service__body {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 24px 4px 12px;
    }
    .hero-service h2 {
        margin: 0 0 14px;
        color: #fff;
        font-size: 26px;
        line-height: 1.22;
        font-weight: 600;
        letter-spacing: -.02em;
    }
    .hero-service__description {
        margin: 0 0 26px;
        color: #d5d5d5;
        font-family: var(--default-font), sans-serif;
        font-size: 15px;
        line-height: 1.6;
    }
    .hero-service__button {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        width: 100%;
        min-height: 52px;
        padding: 13px 18px;
        border: 1px solid rgba(255, 255, 255, .24);
        border-radius: 12px;
        background: rgba(255, 255, 255, .045);
        color: #fff;
        font-size: 16px;
        line-height: 1.5;
        font-weight: 600;
        transition: border-color .25s ease, background-color .25s ease, color .25s ease;
    }
    .hero-service__arrow { font-size: 22px; line-height: 1; }
    .hero-service__button:focus-visible {
        outline: 2px solid #cff85e;
        outline-offset: 4px;
        border-color: #cff85e;
        color: #cff85e;
    }
    .hero-service:has(.hero-service__button:focus-visible) { border-color: rgba(207, 248, 94, .55); }
    .hero-service__sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
    @media (hover: hover) and (pointer: fine) {
        .hero-service:hover {
            border-color: rgba(207, 248, 94, .48);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .08), 0 18px 42px rgba(0, 0, 0, .15), 0 0 24px rgba(207, 248, 94, .06);
        }
        .hero-service__button:hover {
            border-color: rgba(207, 248, 94, .55);
            background: rgba(207, 248, 94, .08);
            color: #cff85e;
        }
    }
    @media (max-width: 640px) {
        .hero-services { grid-template-columns: minmax(0, 1fr); }
        .hero-service__body { padding: 22px 10px 10px; }
        .hero-service h2 { font-size: 25px; }
        .hero-service__description { font-size: 16px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .hero-service, .hero-service__button { transition: none; }
    }
    .hero-assistant-notice {
        position: relative;
        isolation: isolate;
        width: min(720px, 100%);
        justify-content: space-between;
        min-height: 58px;
        padding: 8px 22px;
        color: var(--white-color);
        font-size: 16px;
        font-weight: 500;
        line-height: 1.5;
        text-align: left;
    }
    .hero-assistant-notice > span { flex: 1; min-width: 0; font-size: 18px; text-align: center; }
    .hero-assistant-notice__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--accent-color);
        color: #101010;
        font-size: 18px;
    }
    .hero-assistant-notice__button:hover { color: #101010; }
    .hero-assistant-notice__button:focus-visible { outline: 2px solid white; outline-offset: 3px; }
    @property --assistant-border-angle { syntax: "<angle>"; initial-value: 0deg; inherits: false; }
    .hero-assistant-notice::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 2px;
        background: conic-gradient(from var(--assistant-border-angle), #cff85e, #66dfcf, #9daeff, #cff85e);
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask-composite: exclude;
        pointer-events: none;
        animation: assistant-border-flow 8s linear infinite;
    }
    @keyframes assistant-border-flow { to { --assistant-border-angle: 360deg; } }
    @media (prefers-reduced-motion: reduce) { .hero-assistant-notice::before { animation: none; } }
    .hero-assistant-notice img {
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }
    @media (max-width: 767px) {
        .hero-assistant-notice { gap: 10px; padding: 8px 14px; }
        .hero-assistant-notice > span { font-size: 15px; text-align: left; }
        .hero-assistant-notice__button { flex-basis: 36px; width: 36px; height: 36px; }
    }
</style>

<style is:global>
    .quick-request {
        --request-pad: clamp(22px, 3.4vw, 44px);
        position: relative;
        margin: clamp(24px, 3.5vw, 56px) auto 0;
        border: 1px solid #424541;
        border-radius: 24px;
        background: #191b19;
        color: #f5f6f3;
        color-scheme: dark;
        overflow: clip;
    }
    .home-page:has(.offer-divider) .quick-request { margin-top: 0; }
    .quick-request,
    .quick-request__anchor { scroll-margin-top: 96px; }
    .quick-request__anchor { position: absolute; inset: 0 auto auto 0; pointer-events: none; }
    .quick-request__intro {
        position: relative;
        isolation: isolate;
        padding: 30px var(--request-pad) 27px;
        border-bottom: 1px solid #3b3e37;
        background: linear-gradient(100deg, #242823, #20241e 58%, #1b1e19);
    }
    .quick-request__intro::before {
        content: "";
        position: absolute;
        z-index: -1;
        inset: 0 0 0 auto;
        width: 35%;
        background: url("/images/hero-service-ai-agents.webp") 54% 48% / cover no-repeat;
        mask-image: linear-gradient(90deg, transparent, #000 45%);
    }
    .quick-request__intro h2 {
        margin: 0;
        color: #f5f6f3;
        font-size: clamp(32px, 3.4vw, 44px);
        font-weight: 600;
        letter-spacing: -.045em;
        line-height: 1.08;
    }
    .quick-request__intro p, .quick-request__success p {
        margin: 9px 0 0;
        color: #c6cbc3;
        font-size: 16px;
        line-height: 1.5;
    }
    .quick-request__body, .quick-request__success { padding: 24px var(--request-pad) 22px; }
    .quick-request__grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
        align-items: end;
        gap: 18px 14px;
    }
    .quick-request__services, .quick-request__field, .quick-request__grid > .form-group,
    .quick-request__actions [role="alert"] { grid-column: 1 / -1; }
    .quick-request__services { min-width: 0; padding: 0; margin: 0; border: 0; }
    .quick-request__services legend,
    .quick-request__field > label, .quick-request__contact > label {
        display: block;
        float: none;
        width: auto;
        margin: 0 0 8px;
        padding: 0;
        color: #dee2db;
        font-size: 15px;
        font-weight: 500;
        line-height: 1.35;
    }
    .quick-request__choices { display: flex; flex-wrap: wrap; gap: 7px; }
    .quick-request__choice { position: relative; margin: 0; cursor: pointer; }
    .quick-request__choice input {
        position: absolute;
        width: 1px;
        height: 1px;
        clip-path: inset(50%);
    }
    .quick-request__choice span {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        gap: 8px;
        padding: 6px 16px;
        border: 1px solid #50544b;
        border-radius: 24px;
        color: #d9ddd5;
        font-size: 15px;
        line-height: 1.2;
    }
    .quick-request__choice input:checked + span {
        border-color: #b7c79c;
        background: #e5ecd9;
        color: #23291d;
        font-weight: 600;
    }
    .quick-request__choice input:checked + span::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #587a22;
    }
    .quick-request__choice:hover span { border-color: #929989; }
    .quick-request .form-control {
        width: 100%;
        height: 50px;
        padding: 0 14px;
        border: 1px solid #55594f;
        border-radius: 10px;
        background: #242723;
        color: #fff;
        font: inherit;
        font-size: 16px;
    }
    .quick-request .form-control::placeholder { color: #aaafa6; }
    .quick-request__actions { display: contents; }
    .quick-request__submit {
        order: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 50px;
        padding: 0 24px;
        border: 0;
        border-radius: 10px;
        background: #cff85e;
        color: #172009;
        font: inherit;
        font-weight: 650;
    }
    .quick-request__submit span { font-size: 21px; line-height: 1; }
    .quick-request__submit:hover:enabled { background: #dcff81; }
    .quick-request__submit:disabled { opacity: .65; }
    .quick-request__grid > .form-group { order: 2; margin: 0 !important; }
    .quick-request .legal-consent .form-check-label { color: #acb1a8; font-size: 14px; line-height: 1.5; }
    .quick-request .legal-consent a { color: #c7cdc2; text-underline-offset: 3px; }
    .quick-request .legal-consent a:hover { color: #fff; }
    .quick-request :focus-visible, .quick-request__choice input:focus-visible + span {
        outline: 2px solid #cff85e;
        outline-offset: 3px;
    }
    .quick-request__success strong { color: #cff85e; font-size: 24px; }
    .quick-request__actions [role="alert"] { order: 4; color: #ffb9b2; }
    .quick-request__actions [role="alert"] ul { margin: 0; }
    @media (max-width: 840px) {
        .quick-request__intro::before { width: 30%; }
    }
    @media (max-width: 690px) {
        .quick-request { border-radius: 18px; }
        .quick-request__intro { padding-block: 24px 19px; }
        .quick-request__intro::before { display: none; }
        .quick-request__grid { grid-template-columns: minmax(0, 1fr); gap: 15px; }
        .quick-request__choice span { padding-inline: 12px; }
        .quick-request__submit { order: 3; width: 100%; }
    }
    @media (max-width: 480px) {
        .quick-request { --request-pad: 16px; }
        .quick-request__choices {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
            gap: 6px;
        }
        .quick-request__choice span { width: 100%; padding-inline: 4px; font-size: 14px; }
        .quick-request__choice:last-child { grid-column: 1 / -1; }
    }
</style>
