---
import HeroLeadForm from "./hero/HeroLeadForm";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "ИИ-агенты для бизнеса, которые работают в ваших системах",
    description = "Разрабатываем и внедряем агентов для поддержки, продаж и работы с документами. Обучаем модель на ваших данных, подключаем CRM, 1С и мессенджеры и проверяем результат на реальных примерах."
} = Astro.props;

const proof = [
    { icon: "fa-bolt", title: "Пилот на ваших данных" },
    { icon: "fa-server", title: "Данные в вашем контуре" },
    { icon: "fa-layer-group", title: "100+ ИИ-систем" },
];

---

<div class="hero-prime">
    <div class="hero-bg-video-prime">
        <video autoplay muted playsinline loop id="myvideo" preload="metadata" poster="/images/hero-poster.webp" aria-hidden="true" tabindex="-1"><source src="/videos/hero.mp4" type="video/mp4" media="(min-width: 768px)"></video>
    </div>
    <span class="hero-prime__shade" aria-hidden="true"></span>

    <div class="container">
        <div class="hero-grid">
            <div class="hero-copy">
                <span class="hero-eyebrow">
                    <span class="hero-eyebrow__dot" aria-hidden="true"></span>
                    Внедрение ИИ под ключ
                </span>

                <h1 class="hero-title" data-cursor="-opaque">{title}</h1>
                <p class="hero-desc">{description}</p>
            </div>

            <div class="hero-extra">
                <ul class="hero-proof" role="list">
                    {proof.map((item) => (
                        <li class="hero-proof__item">
                            <span class="hero-proof__icon" aria-hidden="true"><i class:list={["fa-solid", item.icon]}></i></span>
                            {item.title}
                        </li>
                    ))}
                </ul>

                <div class="hero-actions">
                    <a class="hero-action" href="#expertise-videos">
                        Смотреть, чем мы занимаемся
                        <span aria-hidden="true">↓</span>
                    </a>
                    <a class="hero-action-link" href="/contact" data-request-modal>Описать задачу подробно</a>
                </div>

                <div class="hero-trust">
                    <span class="hero-trust__stars" aria-hidden="true">
                        <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                    </span>
                    <p><strong>4.9 из 5</strong> — более 100 отзывов на фриланс-биржах</p>
                </div>
            </div>

            <aside class="hero-lead" aria-labelledby="hero-lead-title">
                <span class="hero-lead__eyebrow">Бесплатный разбор</span>
                <h2 class="hero-lead__title" id="hero-lead-title">Рассчитаем ваш проект</h2>
                <p class="hero-lead__text">Оставьте телефон — перезвоним, разберём задачу и предложим сценарий с оценкой.</p>
                <HeroLeadForm client:load source="hero" />
                <p class="hero-lead__offer">MVP за 2–3 недели · <a href="/pricing">от 5 000 ₽</a></p>
            </aside>
        </div>
    </div>
</div>

<slot name="after-hero" />

<style>
    .hero-prime {
        padding: clamp(140px, 10.5vw, 200px) 0 clamp(52px, 4.6vw, 88px);
    }

    .hero-prime .container {
        width: 100%;
        max-width: none;
        padding-inline: clamp(20px, 3vw, 56px);
    }

    .hero-prime__shade {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(115% 95% at 18% 32%, rgba(8, 9, 8, 0.94) 0%, rgba(8, 9, 8, 0.72) 46%, rgba(8, 9, 8, 0.34) 78%, rgba(8, 9, 8, 0.28) 100%),
            linear-gradient(0deg, rgba(8, 9, 8, 0.9) 0%, rgba(8, 9, 8, 0.3) 46%, rgba(8, 9, 8, 0.55) 100%);
        pointer-events: none;
    }

    .hero-bg-video-prime video {
        opacity: 0.7;
    }

    .hero-grid {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
        grid-template-areas:
            "copy lead"
            "extra lead";
        align-items: start;
        row-gap: clamp(16px, 1.6vw, 24px);
        column-gap: clamp(32px, 4vw, 72px);
    }

    .hero-copy {
        grid-area: copy;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        max-width: 46rem;
    }

    .hero-extra {
        grid-area: extra;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        max-width: 46rem;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 9px 18px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.05);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
        color: var(--white-color);
        font-family: var(--default-font), sans-serif;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.07em;
        line-height: 1;
        text-transform: uppercase;
    }

    .hero-eyebrow__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent-color);
        box-shadow: 0 0 14px rgba(207, 248, 94, 0.85);
    }

    .hero-title {
        max-width: 20ch;
        margin: clamp(18px, 2vw, 26px) 0 0;
        color: var(--white-color);
        font-size: clamp(38px, 4vw, 64px);
        font-weight: 600;
        letter-spacing: -0.035em;
        line-height: 1.03;
        text-wrap: balance;
    }

    .hero-desc {
        max-width: 48ch;
        margin: clamp(16px, 1.6vw, 22px) 0 0;
        color: #d7dad2;
        font-family: var(--default-font), sans-serif;
        font-size: clamp(15px, 1.1vw, 18px);
        line-height: 1.6;
    }

    .hero-proof {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: clamp(18px, 2vw, 26px) 0 0;
        padding: 0;
        list-style: none;
    }

    .hero-proof__item {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 16px 9px 11px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.04);
        color: #e2e6dd;
        font-family: var(--default-font), sans-serif;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.3;
        white-space: nowrap;
    }

    .hero-proof__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 24px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: rgba(207, 248, 94, 0.14);
        color: var(--accent-color);
        font-size: 11px;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px 26px;
        margin-top: clamp(18px, 2vw, 26px);
    }

    .hero-action {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-height: 54px;
        padding: 0 24px;
        border: 1px solid rgba(255, 255, 255, 0.24);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.04);
        color: var(--white-color);
        font-size: 16px;
        font-weight: 600;
        transition: border-color 0.25s ease, background-color 0.25s ease, color 0.25s ease;
    }

    .hero-action span {
        font-size: 17px;
        line-height: 1;
    }

    .hero-action:hover {
        border-color: var(--accent-color);
        background: rgba(207, 248, 94, 0.1);
        color: var(--accent-color);
    }

    .hero-action-link {
        color: #d4d9cd;
        font-size: 15px;
        text-decoration: underline;
        text-decoration-color: rgba(207, 248, 94, 0.5);
        text-underline-offset: 4px;
    }

    .hero-action-link:hover {
        color: var(--accent-color);
    }

    .hero-trust {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: clamp(16px, 1.7vw, 24px);
        padding-top: clamp(14px, 1.4vw, 20px);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        width: 100%;
    }

    .hero-trust__stars {
        display: inline-flex;
        gap: 3px;
        color: var(--accent-color);
        font-size: 13px;
    }

    .hero-trust p {
        margin: 0;
        color: #b9beb4;
        font-family: var(--default-font), sans-serif;
        font-size: 14px;
        line-height: 1.4;
    }

    .hero-trust strong {
        color: var(--white-color);
        font-weight: 600;
    }

    .hero-lead {
        position: relative;
        grid-area: lead;
        align-self: center;
        width: 100%;
        max-width: 29rem;
        justify-self: end;
        padding: clamp(22px, 2vw, 32px);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 24px;
        background: rgba(16, 17, 16, 0.86);
        -webkit-backdrop-filter: blur(20px);
        backdrop-filter: blur(20px);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
        overflow: hidden;
    }

    .hero-lead::before {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 2px;
        background: linear-gradient(90deg, var(--accent-color), rgba(207, 248, 94, 0));
    }

    .hero-lead__eyebrow {
        display: inline-block;
        color: var(--accent-color);
        font-family: var(--default-font), sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        line-height: 1.2;
        text-transform: uppercase;
    }

    .hero-lead__title {
        margin: 10px 0 0;
        color: var(--white-color);
        font-size: clamp(24px, 1.9vw, 30px);
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.12;
    }

    .hero-lead__text {
        margin: 10px 0 20px;
        color: #b9beb4;
        font-family: var(--default-font), sans-serif;
        font-size: 14.5px;
        line-height: 1.5;
    }

    .hero-lead__offer {
        margin: 14px 0 0;
        color: #a9afa5;
        font-family: var(--default-font), sans-serif;
        font-size: 13px;
        line-height: 1.4;
        text-align: center;
    }

    .hero-lead__offer a {
        color: var(--accent-color);
        text-underline-offset: 3px;
    }

    @media (max-width: 1199px) {
        .hero-grid {
            grid-template-columns: minmax(0, 1fr);
            grid-template-areas:
                "copy"
                "lead"
                "extra";
            row-gap: 26px;
        }

        .hero-copy,
        .hero-extra {
            max-width: none;
        }

        .hero-lead {
            align-self: stretch;
        }

        .hero-lead {
            max-width: none;
            justify-self: stretch;
        }

        .hero-title {
            max-width: 24ch;
        }
    }

    @media (max-width: 767px) {
        .hero-prime {
            padding: 130px 0 48px;
            margin: 10px 10px 0;
        }

        .hero-title {
            font-size: clamp(32px, 8.6vw, 42px);
        }

        .hero-proof__item {
            white-space: normal;
        }

        .hero-actions {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .hero-action {
            justify-content: space-between;
        }

        .hero-action-link {
            text-align: center;
        }

        .hero-lead {
            border-radius: 20px;
            padding: 20px 18px;
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .hero-copy > *,
        .hero-lead {
            animation: hero-reveal 0.7s ease both;
        }

        .hero-copy > :nth-child(2) { animation-delay: 0.06s; }
        .hero-copy > :nth-child(3) { animation-delay: 0.12s; }
        .hero-copy > :nth-child(4) { animation-delay: 0.18s; }
        .hero-copy > :nth-child(5) { animation-delay: 0.24s; }
        .hero-copy > :nth-child(6) { animation-delay: 0.3s; }
        .hero-lead { animation-delay: 0.16s; }
    }

    @keyframes hero-reveal {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }
</style>

<style is:global>
    .hero-prime .hero-lead__form {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .hero-prime .hero-lead__trap {
        position: absolute;
        left: -9999px;
    }

    .hero-prime .hero-lead__field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .hero-prime .hero-lead__field label {
        color: #dee2db;
        font-family: var(--default-font), sans-serif;
        font-size: 13px;
        font-weight: 500;
        line-height: 1.3;
    }

    .hero-prime .hero-lead__field input {
        width: 100%;
        height: 52px;
        padding: 0 15px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--white-color);
        font: inherit;
        font-family: var(--default-font), sans-serif;
        font-size: 16px;
    }

    .hero-prime .hero-lead__field input::placeholder {
        color: #8f958b;
    }

    .hero-prime .hero-lead__field input:focus {
        outline: none;
        border-color: var(--accent-color);
        background: rgba(207, 248, 94, 0.06);
        box-shadow: 0 0 0 3px rgba(207, 248, 94, 0.15);
    }

    .hero-prime .hero-lead .legal-consent {
        margin: 2px 0 0;
    }

    .hero-prime .hero-lead .legal-consent .form-group {
        margin: 0;
    }

    .hero-prime .hero-lead .legal-consent .form-check {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin: 0;
        padding-left: 0;
    }

    .hero-prime .hero-lead .legal-consent .form-check-input {
        flex: 0 0 16px;
        width: 16px;
        height: 16px;
        margin: 2px 0 0;
        accent-color: var(--accent-color);
    }

    .hero-prime .hero-lead .legal-consent .form-check-label {
        color: #9aa092;
        font-family: var(--default-font), sans-serif;
        font-size: 12px;
        line-height: 1.45;
    }

    .hero-prime .hero-lead .legal-consent a {
        color: #c9cfc2;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .hero-prime .hero-lead__submit {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
        min-height: 54px;
        margin-top: 2px;
        padding: 0 20px;
        border: 0;
        border-radius: 12px;
        background: var(--accent-color);
        color: #10150a;
        font: inherit;
        font-family: var(--default-font), sans-serif;
        font-size: 17px;
        font-weight: 650;
        cursor: pointer;
        transition: background-color 0.25s ease;
    }

    .hero-prime .hero-lead__submit span {
        font-size: 20px;
        line-height: 1;
    }

    .hero-prime .hero-lead__submit:hover:enabled {
        background: #dcff81;
    }

    .hero-prime .hero-lead__submit:disabled {
        opacity: 0.7;
        cursor: default;
    }

    .hero-prime .hero-lead__note {
        margin: 0;
        color: #8f958b;
        font-family: var(--default-font), sans-serif;
        font-size: 12px;
        line-height: 1.4;
        text-align: center;
    }

    .hero-prime .hero-lead__error {
        margin: 0;
        color: #ffb9b2;
        font-family: var(--default-font), sans-serif;
        font-size: 13px;
        line-height: 1.4;
    }

    .hero-prime .hero-lead__success {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 26px 8px 18px;
        text-align: center;
    }

    .hero-prime .hero-lead__success-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        margin-bottom: 4px;
        border-radius: 50%;
        background: rgba(207, 248, 94, 0.14);
        color: var(--accent-color);
        font-size: 18px;
    }

    .hero-prime .hero-lead__success strong {
        color: var(--white-color);
        font-size: 20px;
        font-weight: 600;
    }

    .hero-prime .hero-lead__success p {
        max-width: 32ch;
        margin: 0;
        color: #b9beb4;
        font-family: var(--default-font), sans-serif;
        font-size: 14px;
        line-height: 1.5;
    }
</style>
