---
import ProjectCard from "./ProjectCard.astro";

interface Props {
    projects: import("./ProjectCard.astro").Props["project"][];
    basePath?: string;
    actionText?: string;
}

const { projects, basePath = "/case", actionText = "Смотреть проект" } = Astro.props;
---

<!-- Page Projects Start -->
<div class="page-projects">
    <div class="container">
        <div class="row">
            {projects.map((project: any, index: number) => (
                <ProjectCard 
                    project={project} 
                    delay={`${(index % 3) * 0.2}s`}
                    basePath={basePath}
                    actionText={actionText}
                />
            ))}
        </div>
    </div>
</div>
<!-- Page Projects End -->
