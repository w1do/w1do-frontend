---
import { FOOTER_LEGAL_LINKS } from '../../lib/legal';
import { CONTACT_EMAILS } from '../../lib/contact-emails';
import { REQUISITES } from '../../lib/requisites';
import { getServiceHubs } from '../../lib/server/w1do/services';

interface Props {
    description?: string;
}

const { description = "Разрабатываем ИИ-агентов для бизнеса. Помогаем подключить данные и инструменты, развернуть agent harness и настроить Claude Code для команд." } = Astro.props;
const currentYear = new Date().getFullYear();

const featuredServices = [
    { title: "Разработка ИИ-агентов", link: "/ai-agents" },
    { title: "Разработка agent harness", link: "/services/ai-solution-architecture/ai-agent-development" },
    { title: "Инфраструктура Claude Code", link: "/consultation/claude-cursor-setup" },
];
const services = [
    ...featuredServices,
    ...(await getServiceHubs())
        .filter((service) => !featuredServices.some(({ link }) => link === service.url))
        .map((service) => ({ title: service.title, link: service.url })),
];

const navigationLinks = [
    { label: "Главная", href: "/" },
    { label: "Об агентстве", href: "/about" },
    { label: "Услуги", href: "/services" },
    { label: "База знаний", href: "/knowledge" },
    { label: "Консультация", href: "/consultation" },
    { label: "ИИ-инженерия", href: "/vibe-coding" },
    { label: "Обучение разработке с ИИ", href: "/ai-training" },
    { label: "Цены", href: "/pricing" },
    { label: "Калькулятор", href: "/calculator" },
    { label: "Кейсы", href: "/case" },
    { label: "Открытые проекты", href: "/opensource" },
];
---
<div class="main-footer-prime bg-section">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="footer-header-prime">
                    <div class="footer-logo-prime">
                        <img src="/images/logo-aicraft-480.png" alt="AiCRAFT.AGENCY" width="240" height="80" style="width: 240px; max-width: 100%; height: auto;">
                    </div>
                    <div class="section-title">
                        <h2 class="text-anime-style-3">
                            <a href="/contact" data-cursor="-opaque">Обсудим вашу задачу</a>
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="about-footer-prime">
                    <div class="about-footer-content-prime">
                        <h2>Агентство AiCRAFT</h2>
                        <p>{description}</p>
                    </div>
                    <div class="footer-contact-list-prime">
                        <ul>
                            {CONTACT_EMAILS.map(({ address }) => (
                                <li><img src="/images/icon-mail-accent.svg" alt="" aria-hidden="true"><a href={`mailto:${address}`} data-cursor="-opaque">{address}</a></li>
                            ))}
                            <li><img src="/images/icon-location-accent.svg" alt="" aria-hidden="true">Удалённая работа по всей России</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-xl-8">
                <div class="footer-links-box-prime">
                    <div class="footer-links-prime">
                        <h2>Навигация</h2>
                        <ul class="expandable-list" data-limit="5">
                            {navigationLinks.map((link, index) => (
                                <li class={index >= 5 ? "hidden-link" : ""}><a href={link.href}>{link.label}</a></li>
                            ))}
                        </ul>
                        {navigationLinks.length > 5 && <button class="show-more-btn" data-cursor="-opaque">Показать ещё</button>}
                    </div>

                    <div class="footer-links-prime">
                        <h2>Услуги</h2>
                        <ul class="expandable-list" data-limit="5">
                            {services.map((service, index) => (
                                <li class={index >= 5 ? "hidden-link" : ""}><a href={service.link}>{service.title}</a></li>
                            ))}
                        </ul>
                        {services.length > 5 && <button class="show-more-btn" data-cursor="-opaque">Показать ещё</button>}
                    </div>

                    <div class="footer-links-prime footer-newsletter-form-prime">
                        <h2>IT-ИИшница в Telegram</h2>
                        <div class="footer-newsletter-form-box-prime">
                            <div class="icon-box"><i class="fa-solid fa-bell" aria-hidden="true"></i></div>
                            <div class="footer-newsletter-form-content">
                                <p>Примеры внедрения агентов и заметки о работе с ИИ.</p>
                            </div>
                        </div>
                        <div class="footer-social-links">
                            <ul>
                                <li><a href="https://t.me/+sJeHrjLGkbNjN2Yy" data-cursor="-opaque" aria-label="Telegram-канал"><i class="fa-brands fa-telegram" aria-hidden="true"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="footer-copyright-prime">
        <p>Copyright © 2022–{currentYear} AiCRAFT.AGENCY. Все права защищены.</p>
        <div class="footer-legal-links">
            {FOOTER_LEGAL_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
        <p class="footer-requisites">Исполнитель: {REQUISITES.legalName} · {REQUISITES.status} · ИНН {REQUISITES.inn}</p>
    </div>
</div>

<style>
    .hidden-link { display: none; }
    .show-more-btn {
        background: none;
        border: none;
        color: var(--primary-color);
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        margin-top: 10px;
        padding: 5px 0;
        transition: all 0.3s ease;
    }
    .show-more-btn:hover { opacity: 0.8; }
    .expandable-list { margin-bottom: 0 !important; }
    .footer-legal-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px 24px;
        justify-content: center;
        margin-top: 18px;
    }
    .footer-legal-links a {
        color: var(--text-color);
        font-size: 15px;
        line-height: 1.4em;
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: all 0.3s ease;
    }
    .footer-legal-links a:hover { color: var(--accent-color); }
    .footer-requisites {
        margin: 12px 0 0;
        color: var(--text-color);
        font-size: 13px;
        line-height: 1.5em;
    }
    @media (max-width: 767px) {
        .footer-legal-links { gap: 10px 16px; }
    }
</style>

<script>
    function setupShowMore() {
        document.querySelectorAll('.show-more-btn').forEach((button) => {
            button.addEventListener('click', () => {
                const list = button.previousElementSibling;
                if (!list) return;

                const isExpanding = button.textContent === 'Показать ещё';
                list.querySelectorAll('.hidden-link').forEach((link) => {
                    (link as HTMLElement).style.display = isExpanding ? 'block' : 'none';
                });
                button.textContent = isExpanding ? 'Скрыть' : 'Показать ещё';
            });
        });
    }

    setupShowMore();
    document.addEventListener('astro:after-swap', setupShowMore);
</script>
