---
import { FOOTER_LEGAL_LINKS } from '../../lib/legal';
import { CONTACT_EMAILS } from '../../lib/contact-emails';
import { getServiceHubs } from '../../lib/server/w1do/services';

const services = (await getServiceHubs()).map((service) => ({
    title: service.title,
    link: service.url,
}));

const navigationLinks = [
    { label: "Главная", href: "/" },
    { label: "Обо мне", href: "/about" },
    { label: "Услуги", href: "/services" },
    { label: "База знаний", href: "/knowledge" },
    { label: "Консультация", href: "/consultation" },
    { label: "ИИ-разработчик", href: "/vibe-coding" },
    { label: "ИИ-агенты", href: "/ai-agents" },
    { label: "Обучение разработке с ИИ", href: "/ai-training" },
    { label: "Цены", href: "/pricing" },
    { label: "Проекты", href: "/case" },
    { label: "OpenSource", href: "/opensource" },
];
---
<div class="main-footer-prime bg-section">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="footer-header-prime">
                    <div class="footer-logo-prime">
                        <img src="/images/logo.svg" alt="AI агентство">
                    </div>
                    <div class="section-title">
                        <h2 class="text-anime-style-3">
                            <a href={import.meta.env.PUBLIC_TELEGRAM_URL || "https://t.me/W1DO_DIGITAL"} data-cursor="-opaque">Давайте создадим ваше ИИ-решение</a>
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="about-footer-prime">
                    <div class="about-footer-content-prime">
                        <h2>Обо мне</h2>
                        <p>Специализируюсь на разработке ИИ-агентов, RAG-систем и автоматизации бизнес-процессов для повышения эффективности вашей компании.</p>
                    </div>
                    <div class="footer-contact-list-prime">
                        <ul>
                            <li><img src="/images/icon-mail-accent.svg" alt="Telegram"><a href={import.meta.env.PUBLIC_TELEGRAM_URL || "https://t.me/W1DO_DIGITAL"} data-cursor="-opaque">Написать в Telegram</a></li>
                            <li><img src="/images/icon-mail-accent.svg" alt="Email"><a href="mailto:uniqdeveloper@yandex.ru" data-cursor="-opaque">Написать на почту</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-xl-8">
                <div class="footer-links-box-prime">
                    <div class="footer-links-prime">
                        <h2>Навигация</h2>
                        <ul class="expandable-list" data-limit="5">
                            {navigationLinks.map((link, index) => (
                                <li class={index >= 5 ? "hidden-link" : ""}><a href={link.href}>{link.label}</a></li>
                            ))}
                        </ul>
                        {navigationLinks.length > 5 && <button class="show-more-btn" data-cursor="-opaque">Показать еще</button>}
                    </div>

                    <div class="footer-links-prime">
                        <h2>Услуги</h2>
                        <ul class="expandable-list" data-limit="5">
                            {services.map((service, index) => (
                                <li class={index >= 5 ? "hidden-link" : ""}><a href={service.link}>{service.title}</a></li>
                            ))}
                        </ul>
                        {services.length > 5 && <button class="show-more-btn" data-cursor="-opaque">Показать еще</button>}
                    </div>

                    <div class="footer-links-prime footer-newsletter-form-prime">
                        <h2>IT-ИИшница в Telegram</h2>
                        <div class="footer-social-links">
                            <ul>
                                <li><a href="https://t.me/+sJeHrjLGkbNjN2Yy" data-cursor="-opaque"><i class="fa-brands fa-telegram"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="footer-legal-links">
                    {FOOTER_LEGAL_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
                </div>
            </div>
        </div>
        <div class="footer-business-emails" aria-label="Почта для обращений">
            {CONTACT_EMAILS.map(({ label, address }) => (
                <div class="footer-business-email">
                    <span>{label}</span>
                    <a href={`mailto:${address}`} data-cursor="-opaque">{address}</a>
                </div>
            ))}
        </div>
    </div>

    <div class="footer-copyright-prime">
        <p>Copyright © 2022-2024 AI Agency. Все права защищены.</p>
    </div>
</div>

<style>
    .hidden-link { display: none; }
    .show-more-btn {
        background: none;
        border: none;
        color: var(--primary-color);
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        margin-top: 10px;
        padding: 5px 0;
        transition: all 0.3s ease;
    }
    .show-more-btn:hover { opacity: 0.8; }
    .expandable-list { margin-bottom: 0 !important; }
    .footer-legal-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px 24px;
        margin-top: 34px;
    }
    .footer-legal-links a {
        color: var(--text-color);
        font-size: 15px;
        line-height: 1.4em;
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: all 0.3s ease;
    }
    .footer-legal-links a:hover { color: var(--accent-color); }
    .footer-business-emails {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px 32px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid var(--dark-divider-color);
    }
    .footer-business-email span,
    .footer-business-email a {
        display: block;
    }
    .footer-business-email span {
        color: var(--text-color);
        font-size: 14px;
        margin-bottom: 4px;
    }
    .footer-business-email a {
        color: var(--primary-color);
        font-size: 16px;
        font-weight: 600;
        overflow-wrap: anywhere;
        transition: color 0.3s ease;
    }
    .footer-business-email a:hover { color: var(--accent-color); }

    @media (max-width: 767px) {
        .footer-business-emails {
            grid-template-columns: 1fr;
            gap: 14px;
        }
    }
</style>

<script>
    function setupShowMore() {
        document.querySelectorAll('.show-more-btn').forEach((button) => {
            button.addEventListener('click', () => {
                const list = button.previousElementSibling;
                if (!list) return;

                const isExpanding = button.textContent === 'Показать еще';
                list.querySelectorAll('.hidden-link').forEach((link) => {
                    (link as HTMLElement).style.display = isExpanding ? 'block' : 'none';
                });
                button.textContent = isExpanding ? 'Скрыть' : 'Показать еще';
            });
        });
    }

    setupShowMore();
    document.addEventListener('astro:after-swap', setupShowMore);
</script>
