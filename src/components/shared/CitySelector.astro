---
import { cityPath } from "../../lib/regions";
const region = Astro.locals.region;
---
{region && (
  <details class="city-selector">
    <summary title={region.city.name} aria-label={`Выбрать город. Сейчас: ${region.city.name}`}>{region.city.name}</summary>
    <nav aria-label="Выбор города">
      {region.cities.map(city => (
        <a data-city-link href={cityPath(city.slug, region.defaultCitySlug)} aria-current={city.slug === region.city.slug ? "true" : undefined}>
          {city.name}
        </a>
      ))}
    </nav>
  </details>
)}
<style>
  .city-selector { position: relative; margin-left: auto; margin-right: 20px; color: var(--primary-color, #fff); }
  summary { cursor: pointer; font-size: 14px; white-space: nowrap; }
  nav { position: absolute; right: 0; top: calc(100% + 12px); z-index: 1000; display: grid; gap: 6px;
    min-width: 230px; max-height: min(420px, 65vh); overflow-y: auto; padding: 16px;
    background: var(--secondary-color, #141414); border: 1px solid var(--divider-color, #444); border-radius: 12px; }
  nav a { padding: 6px 8px; color: var(--primary-color, #fff); font-size: 14px; }
  nav a:hover, nav a[aria-current] { color: var(--accent-color, #a8ff53); }
  @media (max-width: 767px) { .city-selector { margin-right: 12px; } nav { right: -40px; } }
  @media (max-width: 375px) { summary { max-width: calc(100vw - 240px); overflow: hidden; text-overflow: ellipsis; } }
</style>
