---
import { getServiceHubs } from '../../lib/server/w1do/services';
import CitySelector from './CitySelector.astro';

function shortDescription(description: string): string {
    const normalized = description.replace(/\s+/g, ' ').trim();
    const graphemes = Array.from(new Intl.Segmenter('ru', { granularity: 'grapheme' }).segment(normalized),
        ({ segment }) => segment);

    if (graphemes.length <= 50) return normalized;

    const excerpt = graphemes.slice(0, 49).join('').trimEnd();
    const lastWordBoundary = excerpt.lastIndexOf(' ');

    return `${lastWordBoundary > 0 ? excerpt.slice(0, lastWordBoundary) : excerpt}…`;
}

const services = (await getServiceHubs()).map((service) => ({
    title: service.title,
    link: service.url,
    image: service.image,
    description: service.excerpt || service.description,
    shortDescription: shortDescription(service.excerpt || service.description),
}));
const defaultService = services.find((service) => service.link === '/ai-agents') || services[0];
---
<!-- Header Start -->
<header class="main-header">
    <div class="header-sticky">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <!-- Logo Start -->
                <a class="navbar-brand" href="/">
                    <img src="/images/logo-aicraft-480.png" alt="AiCRAFT" width="240" height="80">
                </a>
                <!-- Logo End -->

                <!-- Main Menu Start -->
                <div class="collapse navbar-collapse main-menu">
                    <div class="nav-menu-wrapper">
                        <ul class="navbar-nav mr-auto" id="menu">
                            <li class="nav-item nav-home"><a class="nav-link" href="/">Главная</a></li>
                            <li class="nav-item submenu has-mega-menu"><a class="nav-link" href="/services">Услуги</a>
                                <ul class="services-mega-menu">
                                    {services.map((service) => (
                                        <li class:list={['nav-item', { 'is-preview-active': service === defaultService }]}>
                                            <a class="nav-link service-menu-link" href={service.link}>
                                                <span class="service-menu-link__icon" aria-hidden="true">
                                                    {service.image && <img src={service.image} alt="" loading="lazy" />}
                                                </span>
                                                <span class="service-menu-link__text">
                                                    <span class="service-menu-link__title">{service.title}</span>
                                                    {service.shortDescription && (
                                                        <span class="service-menu-link__description">{service.shortDescription}</span>
                                                    )}
                                                </span>
                                            </a>
                                            <div class="service-menu-preview">
                                                {service.image && (
                                                    <div class="service-menu-preview__image">
                                                        <img src={service.image} alt="" loading="lazy" />
                                                    </div>
                                                )}
                                                <div class="service-menu-preview__content">
                                                    <span class="service-menu-preview__title">{service.title}</span>
                                                    {service.description && <p>{service.description}</p>}
                                                </div>
                                            </div>
                                        </li>
                                    ))}
                                </ul>
                            </li>
                            <li class="nav-item submenu"><a class="nav-link" href="/ai-agents">ИИ-агенты</a>
                                <ul>
                                    <li class="nav-item"><a class="nav-link" href="/ai-agents">Разработка ИИ-агентов</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/services/ai-solution-architecture/ai-agent-development">Разработка agent harness</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/consultation/claude-cursor-setup">Инфраструктура Claude Code</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/ai-agents/ai-agent-implementation">Внедрение в процессы</a></li>
                                </ul>
                            </li>
                            <li class="nav-item submenu"><a class="nav-link" href="/about">Агентство</a>
                                <ul>
                                    <li class="nav-item"><a class="nav-link" href="/about">Об AiCRAFT</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/pricing">Цены</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/calculator">Калькулятор</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/consultation">Консультация по ИИ</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/vibe-coding">ИИ-инженерия</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/ai-training">Обучение разработке с ИИ</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/opensource">Открытые проекты</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/knowledge">База знаний</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="/case">Кейсы</a></li>
                            <li class="nav-item"><a class="nav-link" href="/blog">Блог</a></li>
                            <li class="nav-item nav-contact"><a class="nav-link" href="/contact">Контакты</a></li>
                        </ul>
                    </div>

                    <!-- Header Btn Start -->
                    <div class="header-btn">
                        <a href="/contact" class="btn-default" data-cursor="-opaque" data-request-modal>Связаться</a>
                    </div>
                    <!-- Header Btn End -->
                </div>
                <!-- Main Menu End -->
                <CitySelector />
                <div class="navbar-toggle"></div>
            </div>
        </nav>
        <div class="responsive-menu"></div>
    </div>
</header>
<!-- Header End -->

<script>
    document.querySelectorAll<HTMLElement>('.main-menu .services-mega-menu').forEach((menu) => {
        const items = Array.from(menu.querySelectorAll<HTMLElement>(':scope > li'));
        const defaultItem = items.find((item) => item.classList.contains('is-preview-active')) || null;

        function activatePreview(activeItem: HTMLElement | null) {
            items.forEach((item) => item.classList.toggle('is-preview-active', item === activeItem));
        }

        items.forEach((item) => {
            item.addEventListener('pointerenter', () => activatePreview(item));
            item.addEventListener('focusin', () => activatePreview(item));
        });

        menu.addEventListener('pointerleave', () => {
            activatePreview(items.find((item) => item.matches(':focus-within')) || defaultItem);
        });
        menu.addEventListener('focusout', (event) => {
            if (event.relatedTarget instanceof Node && menu.contains(event.relatedTarget)) return;
            activatePreview(items.find((item) => item.matches(':hover')) || defaultItem);
        });
        menu.addEventListener('scroll', () => {
            menu.style.setProperty('--service-preview-scroll', `${menu.scrollTop}px`);
        });
        menu.classList.add('has-preview-control');
    });
</script>

<style>
    .navbar-brand {
        display: flex;
        align-items: center;
        flex: 0 0 240px;
        width: 240px;
        height: 48px;
        overflow: hidden;
    }
    .navbar-brand img {
        display: block;
        flex-shrink: 0;
        width: 100%;
        height: auto;
    }
    @media (min-width: 992px) {
        #menu > .nav-item { margin-inline: 4px; }
        #menu > .nav-item > .nav-link {
            padding-inline: 8px !important;
            white-space: nowrap;
        }
        #menu > .nav-contact { display: none; }
        .header-btn { flex-shrink: 0; }
        .header-btn > .btn-default { white-space: nowrap; }
        .navbar > .container :global(.city-selector) {
            flex-shrink: 0;
            margin-inline: 8px 0;
        }
    }
    @media (max-width: 1199px) {
        .navbar-brand { flex-basis: 200px; width: 200px; height: 44px; }
    }
    @media (min-width: 992px) and (max-width: 1199px) {
        #menu > .nav-home { display: none; }
        .navbar-brand { flex-basis: 172px; width: 172px; }
    }
    @media (max-width: 767px) {
        .navbar-brand { flex-basis: 180px; width: 180px; height: 40px; }
    }

    header.main-header .header-sticky {
        width: 100%;
        max-width: none;
    }

    header.main-header .header-sticky .navbar > .container {
        width: 100%;
        max-width: none;
        padding-inline: clamp(22px, 4.2vw, 88px);
    }

    @media (min-width: 992px) {
        header.main-header .header-sticky .main-menu .nav-menu-wrapper {
            flex: 0 1 auto;
            margin: 0 0 0 clamp(24px, 3vw, 64px);
            text-align: left;
        }

        header.main-header .header-sticky .main-menu .header-btn {
            margin-left: auto;
        }

        header.main-header .header-sticky #menu {
            display: flex;
            align-items: center;
            justify-content: flex-start;
        }

        header.main-header .header-sticky #menu > .nav-item {
            margin-inline: 6px;
        }
    }
</style>
