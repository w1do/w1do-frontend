---
import { getServiceHubs } from '../../lib/server/w1do/services';
import CitySelector from './CitySelector.astro';

const services = (await getServiceHubs()).map((service) => ({
    title: service.title,
    link: service.url,
}));
---
<!-- Header Start -->
<header class="main-header">
    <div class="header-sticky">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <!-- Logo Start -->
                <a class="navbar-brand" href="/">
                    <img src="/images/logo-aicraft.png" alt="AiCRAFT.AGENCY" width="240" height="80">
                </a>
                <!-- Logo End -->

                <!-- Main Menu Start -->
                <div class="collapse navbar-collapse main-menu">
                    <div class="nav-menu-wrapper">
                        <ul class="navbar-nav mr-auto" id="menu">
                            <li class="nav-item"><a class="nav-link" href="/">Главная</a></li>
                            <li class="nav-item submenu has-mega-menu"><a class="nav-link" href="/services">Услуги</a>
                                <ul class="services-mega-menu">
                                    {services.map((service) => (
                                        <li class="nav-item"><a class="nav-link" href={service.link}>{service.title}</a></li>
                                    ))}
                                </ul>
                            </li>
                            <li class="nav-item submenu"><a class="nav-link" href="#">Разработка</a>
                                <ul>
                                    <li class="nav-item"><a class="nav-link" href="/sozdanie-saita">Разработка сайтов</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/ai-agents">AI agents</a></li>
                                </ul>
                            </li>
                            <li class="nav-item submenu"><a class="nav-link" href="#">Страницы</a>
                                <ul>
                                    <li class="nav-item"><a class="nav-link" href="/about">Обо мне</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/pricing">Цены</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/consultation">Консультация по ИИ</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/vibe-coding">Вайб кодер, MLOps</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/ai-training">Обучение ИИ</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/case">Проекты</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/opensource">OpenSource</a></li>
                                    <li class="nav-item"><a class="nav-link" href="/knowledge">База знаний</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="/instructions">Инструкции</a></li>
                            <li class="nav-item"><a class="nav-link" href="/blog">Блог</a></li>
                            <li class="nav-item"><a class="nav-link" href="/contact">Контакты</a></li>
                        </ul>
                    </div>

                    <!-- Header Btn Start -->
                    <div class="header-btn">
                        <a href={import.meta.env.PUBLIC_TELEGRAM_URL || "https://t.me/W1DO_DIGITAL"} class="btn-default" data-cursor="-opaque">Связаться</a>
                    </div>
                    <!-- Header Btn End -->
                </div>
                <!-- Main Menu End -->
                <CitySelector />
                <div class="navbar-toggle"></div>
            </div>
        </nav>
        <div class="responsive-menu"></div>
    </div>
</header>
<!-- Header End -->

<style>
    .navbar-brand {
        display: flex;
        align-items: center;
        flex: 0 0 240px;
        width: 240px;
        height: 48px;
        overflow: hidden;
    }
    .navbar-brand img {
        display: block;
        flex-shrink: 0;
        width: 100%;
        height: auto;
    }
    @media (max-width: 1199px) {
        .navbar-brand { flex-basis: 200px; width: 200px; height: 44px; }
    }
    @media (max-width: 767px) {
        .navbar-brand { flex-basis: 180px; width: 180px; height: 40px; }
    }
</style>
