---
interface Props {
    homeOriginal?: boolean;
    subTitle?: string;
    title?: string;
    description?: string;
    buttonText?: string;
    buttonHref?: string;
    step1Title?: string;
    step1Desc?: string;
    step2Title?: string;
    step2Desc?: string;
    step3Title?: string;
    step3Desc?: string;
    step4Title?: string;
    step4Desc?: string;
}

const {
    homeOriginal = false,
    subTitle = homeOriginal ? "Процесс работы" : "Порядок работы",
    title = homeOriginal ? "Как мы внедряем ИИ в бизнес" : "Как внедряем ИИ в рабочий процесс",
    description = homeOriginal ? "Вместе с командой заказчика разбираем процесс, проверяем прототип и подключаем рабочие системы." : "Согласуем ожидаемый результат, проверяем сценарий на пилоте и только после этого подключаем рабочие системы.",
    buttonText = homeOriginal ? "Связаться" : "Обсудить задачу",
    buttonHref = homeOriginal ? (import.meta.env.PUBLIC_TELEGRAM_URL || "https://t.me/W1DO_DIGITAL") : "/contact",
    step1Title = homeOriginal ? "Анализ" : "Разбор",
    step1Desc = homeOriginal ? "Выбираем вместе с вами задачу для автоматизации" : "Изучаем шаги процесса и данные, которыми пользуется команда",
    step2Title = homeOriginal ? "Прототип" : "Проектирование",
    step2Desc = homeOriginal ? "Собираем прототип и проверяем его на примерах" : "Определяем архитектуру, интеграции и критерии проверки",
    step3Title = homeOriginal ? "Масштабирование" : "Пилот",
    step3Desc = homeOriginal ? "Полноценная интеграция в ваши системы" : "Проверяем поведение на типовых и нестандартных примерах",
    step4Title = homeOriginal ? "Поддержка" : "Запуск",
    step4Desc = homeOriginal ? "Постоянная оптимизация алгоритмов под задачи" : "Подключаем рабочие системы и передаём инструкции команде",
} = Astro.props;
---
<!-- Our Process Section Start -->
<div class="our-process">
    <div class="container">
        <div class="row section-row align-items-center">
            <div class="col-xl-6">
                <!-- Section Title Start -->
                <div class="section-title">
                    <span class="section-sub-title wow fadeInUp">{subTitle}</span>
                    <h2 class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
                </div>
                <!-- Section Title End -->
            </div>

            <div class="col-xl-6">
                <!-- Section Content Button Start -->
                <div class="section-content-btn">
                    <!-- Section Title Content Start -->
                    <div class="section-title-content wow fadeInUp" data-wow-delay="0.2s">
                        <p>{description}</p>
                    </div>
                    <!-- Section Title Content End -->

                    <!-- Section Button Start -->
                    <div class="section-btn wow fadeInUp" data-wow-delay="0.4s">
                        <a href={buttonHref} class="btn-default" data-cursor="-opaque">{buttonText}</a>
                    </div>
                    <!-- Section Button End -->
                </div>
                <!-- Section Content Button End -->
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <!-- Process Item List Start -->
                <div class="process-item-list">
                    <!-- Process Item Start -->
                    <div class="process-item box-border-gradiant wow fadeInUp">
                        <div class="icon-box">
                            <img src="/images/icon-process-item-1.svg" alt={step1Title}>
                        </div>
                        <div class="process-item-content">
                            {homeOriginal ? (
                                <>
                                    <p>{step1Title}</p>
                                    <h3>{step1Desc}</h3>
                                </>
                            ) : (
                                <>
                                    <h3>{step1Title}</h3>
                                    <p>{step1Desc}</p>
                                </>
                            )}
                        </div>
                        {homeOriginal && <div class="process-item-no"><h3>.01</h3></div>}
                    </div>
                    <!-- Process Item End -->

                    <!-- Process Item Start -->
                    <div class="process-item box-border-gradiant wow fadeInUp" data-wow-delay="0.2s">
                        <div class="icon-box">
                            <img src="/images/icon-process-item-2.svg" alt={step2Title}>
                        </div>
                        <div class="process-item-content">
                            {homeOriginal ? (
                                <>
                                    <p>{step2Title}</p>
                                    <h3>{step2Desc}</h3>
                                </>
                            ) : (
                                <>
                                    <h3>{step2Title}</h3>
                                    <p>{step2Desc}</p>
                                </>
                            )}
                        </div>
                        {homeOriginal && <div class="process-item-no"><h3>.02</h3></div>}
                    </div>
                    <!-- Process Item End -->

                    <!-- Process Item Start -->
                    <div class="process-item box-border-gradiant wow fadeInUp" data-wow-delay="0.4s">
                        <div class="icon-box">
                            <img src="/images/icon-process-item-3.svg" alt={step3Title}>
                        </div>
                        <div class="process-item-content">
                            {homeOriginal ? (
                                <>
                                    <p>{step3Title}</p>
                                    <h3>{step3Desc}</h3>
                                </>
                            ) : (
                                <>
                                    <h3>{step3Title}</h3>
                                    <p>{step3Desc}</p>
                                </>
                            )}
                        </div>
                        {homeOriginal && <div class="process-item-no"><h3>.03</h3></div>}
                    </div>
                    <!-- Process Item End -->

                    <!-- Process Item Start -->
                    <div class="process-item box-border-gradiant wow fadeInUp" data-wow-delay="0.6s">
                        <div class="icon-box">
                            <img src="/images/icon-process-item-4.svg" alt={step4Title}>
                        </div>
                        <div class="process-item-content">
                            {homeOriginal ? (
                                <>
                                    <p>{step4Title}</p>
                                    <h3>{step4Desc}</h3>
                                </>
                            ) : (
                                <>
                                    <h3>{step4Title}</h3>
                                    <p>{step4Desc}</p>
                                </>
                            )}
                        </div>
                        {homeOriginal && <div class="process-item-no"><h3>.04</h3></div>}
                    </div>
                    <!-- Process Item End -->
                </div>
                <!-- Process Item List End -->
            </div>


        </div>
    </div>
</div>
<!-- Our Process Section End -->