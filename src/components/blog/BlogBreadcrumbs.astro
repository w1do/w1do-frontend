---
interface Props {
    title: string;
    pubDate: string | Date;
    author?: string;
    breadcrumbItems: { label: string; href?: string; active?: boolean }[];
}

const { title, pubDate, breadcrumbItems, author = "Admin" } = Astro.props;

const formattedDate = new Date(pubDate).toLocaleDateString('ru-RU', {
                                            timeZone: 'Asia/Irkutsk',
    year: 'numeric',
    month: 'long',
    day: 'numeric'
});
---
<!-- Page Header Section Start -->
<div class="page-header dark-section parallaxie">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <!-- Page Header Box Start -->
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">{title}</h1>
                    <nav class="article-breadcrumbs" aria-label="Хлебные крошки">
                        <ol class="breadcrumb">
                            {breadcrumbItems.map(item => (
                                <li class:list={["breadcrumb-item", { active: item.active }]} aria-current={item.active ? "page" : undefined}>
                                    {item.active ? item.label : <a href={item.href}>{item.label}</a>}
                                </li>
                            ))}
                        </ol>
                    </nav>
                    <div class="post-single-meta wow fadeInUp">
                        <ol class="breadcrumb">
                            <li><i class="fa-regular fa-user"></i> {author}</li>
                            <li><i class="fa-regular fa-clock"></i> {formattedDate}</li>
                        </ol>
                    </div>
                </div>
                <!-- Page Header Box End -->
            </div>
        </div>
    </div>
</div>
<!-- Page Header Section End --><style>
    .article-breadcrumbs { margin-top: 24px; }
    .article-breadcrumbs .breadcrumb { flex-wrap: wrap; row-gap: 8px; line-height: 1.5; }
    .article-breadcrumbs a:focus-visible { outline: 2px solid var(--accent-color); outline-offset: 4px; }
</style>
