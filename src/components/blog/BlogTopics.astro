---
import type { BlogCategory } from "../../lib/server/w1do/blog-categories";
interface Props { categories: BlogCategory[] }
const { categories } = Astro.props;
---
{categories.length > 0 && (
  <nav class="container blog-topics" aria-label="Темы блога">
    <span class="topics-label">Темы блога</span>
    <div class="topics-links">
      {categories.map(category => <a href={`/blog/categories/${category.slug}`}>{category.name}</a>)}
    </div>
  </nav>
)}
<style>
  .blog-topics { padding-top: 40px; }
  .topics-label { display: block; margin-bottom: 16px; color: var(--text-color); font-size: 14px; line-height: 1.4; }
  .topics-links { display: flex; flex-wrap: wrap; gap: 12px; }
  a { display: inline-flex; align-items: center; min-height: 46px; padding: 12px 20px; border: 1px solid var(--dark-divider-color); border-radius: 100px; background: var(--secondary-color); color: var(--primary-color); font-size: 16px; font-weight: 500; line-height: 1.4; transition: color .2s, background-color .2s, border-color .2s; }
  a:hover { background: var(--accent-color); border-color: var(--accent-color); color: var(--black-color); }
  a:focus-visible { outline: 2px solid var(--accent-color); outline-offset: 4px; }
  @media (max-width: 767px) { .blog-topics { padding-top: 28px; } .topics-links { gap: 8px; } a { padding: 10px 16px; font-size: 14px; max-width: 100%; } }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } }
</style>
