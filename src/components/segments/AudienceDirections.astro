<script>
    interface DirectionPayload {
        slug: string;
        label: string;
        pain: string;
        workflow: string[];
        outcome: string;
        example: string;
        scene: { title: string; input: string; output: string };
        alt: string;
        illustration: string;
        links: { title: string; href: string }[];
    }

    class AudienceDirections extends HTMLElement {
        private data: DirectionPayload[] = [];
        private active = "";
        private abort?: AbortController;
        private paintToken = 0;

        connectedCallback() {
            const raw = this.querySelector<HTMLScriptElement>("[data-ad-data]");
            if (!raw?.textContent) return;
            try {
                this.data = JSON.parse(raw.textContent) as DirectionPayload[];
            } catch {
                return;
            }
            if (!this.data.length) return;

            this.active = this.data[0].slug;
            this.abort = new AbortController();
            const options = { signal: this.abort.signal };

            this.addEventListener("click", (event) => {
                const target = event.target as HTMLElement;
                if (target.closest("[data-ad-close]")) {
                    this.closeCard();
                    return;
                }
                const chip = target.closest<HTMLButtonElement>(".ad-chip[data-slug]");
                if (!chip) return;
                event.preventDefault();
                this.openCard();
                this.select(chip.dataset.slug!, { focus: false, scroll: true });
            }, options);

            this.querySelector("[data-ad-pause]")?.addEventListener("click", (event) => {
                const button = event.currentTarget as HTMLButtonElement;
                const marquee = this.querySelector<HTMLElement>("[data-ad-marquee]");
                const paused = button.getAttribute("aria-pressed") === "true";
                button.setAttribute("aria-pressed", String(!paused));
                const hint = button.querySelector(".visually-hidden");
                if (hint) hint.textContent = paused ? "Остановить движение строк" : "Продолжить движение строк";
                if (marquee) marquee.dataset.paused = String(!paused);
            }, options);

            const search = this.querySelector<HTMLInputElement>("[data-ad-search]");
            search?.addEventListener("input", () => this.filter(search.value), options);
            search?.addEventListener("keydown", (event) => {
                if (event.key !== "Enter") return;
                event.preventDefault();
                const first = this.pills()[0];
                if (first) {
                    this.openCard();
                    this.select(first.dataset.slug!, { focus: true, scroll: true });
                }
            }, options);

            this.addEventListener("keydown", (event) => this.onKey(event as KeyboardEvent), options);
            document.addEventListener("keydown", (event) => {
                if (event.key !== "Escape") return;
                const search = this.querySelector<HTMLInputElement>("[data-ad-search]");
                if (search && search.value) {
                    search.value = "";
                    this.filter("");
                    return;
                }
                const card = this.querySelector<HTMLElement>("[data-ad-card]");
                if (!card || card.classList.contains("is-closed")) return;
                this.closeCard();
            }, options);

            const fromHash = location.hash.match(/^#direction-(.+)$/);
            const initial = fromHash && this.data.some((item) => item.slug === fromHash[1])
                ? fromHash[1]
                : this.data[0].slug;
            this.select(initial, { focus: false, scroll: false });
        }

        disconnectedCallback() {
            this.abort?.abort();
        }

        private card() {
            return this.querySelector<HTMLElement>("[data-ad-card]");
        }

        private openCard() {
            this.card()?.classList.remove("is-closed");
        }

        private closeCard() {
            const card = this.card();
            if (!card) return;
            card.classList.add("is-closed");
            const chip = this.querySelector<HTMLButtonElement>('.ad-chip[data-slug="' + this.active + '"]:not(.ad-chip--clone)');
            chip?.focus({ preventScroll: true });
        }

        private pills() {
            return Array.from(this.querySelectorAll<HTMLButtonElement>(".ad-chip[data-slug]"))
                .filter((chip) => !chip.hidden);
        }

        private rowOf(chip: HTMLElement) {
            return chip.closest<HTMLElement>("[data-ad-row]");
        }

        private onKey(event: KeyboardEvent) {
            const chip = (event.target as HTMLElement).closest<HTMLButtonElement>(".ad-chip[data-slug]");
            if (!chip) return;
            const row = this.rowOf(chip);
            if (!row) return;
            const rowChips = Array.from(row.querySelectorAll<HTMLButtonElement>(".ad-chip[data-slug]")).filter((item) => !item.hidden);
            const index = rowChips.indexOf(chip);
            let target: HTMLButtonElement | undefined;

            if (event.key === "ArrowRight") target = rowChips[index + 1] ?? rowChips[0];
            else if (event.key === "ArrowLeft") target = rowChips[index - 1] ?? rowChips[rowChips.length - 1];
            else if (event.key === "Home") target = rowChips[0];
            else if (event.key === "End") target = rowChips[rowChips.length - 1];
            else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
                const rows = Array.from(this.querySelectorAll<HTMLElement>("[data-ad-row]"));
                const targetRow = rows[rows.indexOf(row) + (event.key === "ArrowDown" ? 1 : -1)];
                const targetChips = targetRow
                    ? Array.from(targetRow.querySelectorAll<HTMLButtonElement>(".ad-chip[data-slug]")).filter((item) => !item.hidden)
                    : [];
                if (targetChips.length) {
                    const ratio = rowChips.length > 1 ? index / (rowChips.length - 1) : 0;
                    target = targetChips[Math.round(ratio * (targetChips.length - 1))];
                }
            } else {
                return;
            }

            if (!target) return;
            event.preventDefault();
            this.openCard();
            this.select(target.dataset.slug!, { focus: true, scroll: false });
            target.scrollIntoView({ block: "nearest", inline: "center", behavior: "smooth" });
        }

        private filter(query: string) {
            const value = query.trim().toLowerCase();
            const marquee = this.querySelector<HTMLElement>("[data-ad-marquee]");
            const empty = this.querySelector<HTMLElement>("[data-ad-empty]");
            let visible = 0;

            for (const chip of this.querySelectorAll<HTMLButtonElement>(".ad-chip[data-slug]")) {
                const match = !value || (chip.textContent ?? "").toLowerCase().includes(value);
                chip.hidden = !match;
                if (match) visible += 1;
            }

            if (marquee) marquee.dataset.searching = String(Boolean(value));
            if (empty) empty.hidden = visible > 0 || !value;

            const active = this.querySelector<HTMLButtonElement>('.ad-chip[data-slug="' + this.active + '"]:not(.ad-chip--clone)');
            if (value && active?.hidden) {
                const first = this.pills()[0];
                if (first) this.select(first.dataset.slug!, { focus: false, scroll: false });
            }
        }

        private select(slug: string, options: { focus: boolean; scroll: boolean }) {
            const item = this.data.find((entry) => entry.slug === slug);
            if (!item) return;
            this.active = slug;

            for (const chip of this.querySelectorAll<HTMLButtonElement>(".ad-chip[data-slug]")) {
                const isActive = chip.dataset.slug === slug;
                chip.setAttribute("aria-pressed", String(isActive));
                chip.tabIndex = isActive ? 0 : -1;
            }

            const card = this.card();
            const paint = () => {
                const setText = (selector: string, value: string) => {
                    const node = this.querySelector<HTMLElement>(selector);
                    if (node) node.textContent = value;
                };
                setText("[data-ad-badge]", item.label);
                setText("[data-ad-title]", "ИИ-агент: " + item.label);
                setText("[data-ad-pain]", item.pain);
                setText("[data-ad-outcome-text]", item.outcome);
                setText("[data-ad-example]", item.example);
                setText("[data-ad-scene]", item.scene.title);
                setText("[data-ad-output]", item.scene.output);
                setText("[data-ad-input]", item.scene.input);
                setText("[data-ad-output-text]", item.scene.output);

                const workflow = this.querySelector<HTMLElement>("[data-ad-workflow]");
                if (workflow) {
                    workflow.replaceChildren(...item.workflow.map((step) => {
                        const li = document.createElement("li");
                        const check = document.createElement("span");
                        check.className = "ad-card__check";
                        check.setAttribute("aria-hidden", "true");
                        const text = document.createElement("span");
                        text.textContent = step;
                        li.append(check, text);
                        return li;
                    }));
                }

                const image = this.querySelector<HTMLImageElement>("[data-ad-illustration]");
                if (image) {
                    image.src = item.illustration;
                    image.alt = item.alt;
                }

                const links = this.querySelector<HTMLElement>("[data-ad-links]");
                if (links) {
                    links.replaceChildren(...item.links.map((link) => {
                        const anchor = document.createElement("a");
                        anchor.className = "ad-card__link";
                        anchor.href = link.href;
                        anchor.textContent = link.title;
                        const icon = document.createElement("span");
                        icon.className = "ad-icon ad-icon--external";
                        icon.setAttribute("aria-hidden", "true");
                        anchor.append(icon);
                        return anchor;
                    }));
                }

                card?.classList.remove("is-updating");
            };

            const token = ++this.paintToken;
            if (card && !options.focus) {
                card.classList.add("is-updating");
                window.setTimeout(() => {
                    if (token === this.paintToken) paint();
                }, 110);
            } else {
                paint();
            }

            if (options.focus) {
                const target = this.querySelector<HTMLButtonElement>('.ad-chip[data-slug="' + slug + '"]:not(.ad-chip--clone)');
                target?.focus({ preventScroll: true });
            }

            if (options.scroll && card) {
                const rect = card.getBoundingClientRect();
                if (rect.top > window.innerHeight - 120 || rect.bottom < 80) {
                    card.scrollIntoView({ behavior: "smooth", block: "start" });
                }
            }
        }
    }

    if (!customElements.get("aicraft-directions")) customElements.define("aicraft-directions", AudienceDirections);
</script>
