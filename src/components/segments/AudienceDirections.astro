---
import { AUDIENCES, AUDIENCE_COUNT, AUDIENCE_SECTION, type Audience } from "../../lib/audience-directions";

interface Props {
    id?: string;
    subTitle?: string;
    title?: string;
    titleAccent?: string;
    description?: string;
    allHref?: string;
    allLabel?: string;
    ctaLabel?: string;
    audiences?: readonly Audience[];
    defaultSlug?: string;
}

const {
    id = "directions",
    subTitle = AUDIENCE_SECTION.eyebrow,
    title = "ИИ-агенты",
    titleAccent = "для вашей сферы",
    description = AUDIENCE_SECTION.intro,
    allHref = "/services",
    allLabel = "Все " + AUDIENCE_COUNT + " направлений",
    ctaLabel = "Обсудить задачу",
    audiences = AUDIENCES,
    defaultSlug = "lawyers",
} = Astro.props;

const initial = audiences.find((audience) => audience.slug === defaultSlug) ?? audiences[0];
const half = Math.ceil(audiences.length / 2);
const rows = [audiences.slice(0, half), audiences.slice(half)];
const payload = audiences.map(({ slug, label, pain, workflow, outcome, example, scene, alt, illustration, links }) => ({
    slug, label, pain, workflow, outcome, example, scene, alt, illustration, links,
}));
const services = [
    { title: "Разработка ИИ-агентов", href: "/ai-agents" },
    { title: "Внедрение ИИ в бизнес-процессы", href: "/services/ai-integration" },
    { title: "Интеграция с 1С и CRM", href: "/services/ai-integration-1c-crm" },
    { title: "ИИ-ассистенты и чат-боты", href: "/services/ai-assistants-chatbots" },
    { title: "Автоматизация маркетинга", href: "/services/ai-marketing-content" },
    { title: "Архитектура ИИ-систем", href: "/services/ai-solution-architecture" },
];
const seo = [
    { title: "Где ИИ-агент забирает рутину", text: AUDIENCE_SECTION.seoParagraphs[0] },
    { title: "Как мы подключаем агента к процессам", text: AUDIENCE_SECTION.seoParagraphs[1] },
    { title: "С чего начать в вашей сфере", text: AUDIENCE_SECTION.seoParagraphs[2] },
];
---

<section class="ad" id={id} aria-labelledby={id + "-title"}>
    <div class="container">
        <aicraft-directions class="ad__inner">
            <div class="ad__panel">
                <header class="ad__head">
                    <span class="ad__eyebrow">
                        <span class="ad__eyebrow-dot" aria-hidden="true"></span>
                        {subTitle}
                    </span>
                    <h2 class="ad__title" id={id + "-title"}>
                        {title}
                        <span class="ad__title-accent">{titleAccent}</span>
                    </h2>
                    <p class="ad__lead">{description}</p>

                    <div class="ad__tools">
                        <label class="ad-search">
                            <span class="ad-icon ad-icon--search" aria-hidden="true"></span>
                            <input
                                class="ad-search__input"
                                type="search"
                                name="direction"
                                placeholder="Найти свою сферу…"
                                autocomplete="off"
                                aria-label="Найти сферу среди направлений"
                                data-ad-search
                            />
                        </label>
                        <a class="ad__all" href={allHref}>
                            {allLabel}
                            <span class="ad-icon ad-icon--external" aria-hidden="true"></span>
                        </a>
                        <button class="ad__pause" type="button" data-ad-pause aria-pressed="false">
                            <span class="visually-hidden">Остановить движение строк</span>
                            <span class="ad-icon ad__pause-icon ad__pause-icon--pause" aria-hidden="true"></span>
                            <span class="ad-icon ad__pause-icon ad__pause-icon--play" aria-hidden="true"></span>
                        </button>
                    </div>
                </header>

                <div class="ad__marquee" data-ad-marquee>
                    {rows.map((row, rowIndex) => (
                        <div class="ad__row" data-ad-row={rowIndex + 1} data-direction={rowIndex === 0 ? "left" : "right"}>
                            <div class="ad__track">
                                {row.map((audience) => (
                                    <button
                                        type="button"
                                        class="ad-chip"
                                        data-slug={audience.slug}
                                        aria-pressed={audience.slug === initial.slug ? "true" : "false"}
                                        aria-controls="direction-detail"
                                        tabindex={audience.slug === initial.slug ? 0 : -1}
                                        aria-label={audience.label + " — подробнее"}
                                        style={"--ad-icon: url(" + audience.icon + ")"}
                                    >
                                        <span class="ad-chip__icon" aria-hidden="true"></span>
                                        <span class="ad-chip__label">{audience.label}</span>
                                        <span class="ad-chip__more" aria-hidden="true">
                                            Подробнее
                                            <span class="ad-chip__more-icon"></span>
                                        </span>
                                    </button>
                                ))}
                                {row.map((audience) => (
                                    <span class="ad-chip ad-chip--clone" aria-hidden="true" style={"--ad-icon: url(" + audience.icon + ")"}>
                                        <span class="ad-chip__icon"></span>
                                        <span class="ad-chip__label">{audience.label}</span>
                                    </span>
                                ))}
                            </div>
                        </div>
                    ))}

                    <p class="ad__hint" aria-hidden="true">
                        <span></span>
                        Наведите на сферу — строка остановится
                        <span></span>
                    </p>
                    <p class="ad__empty" data-ad-empty hidden>Такой сферы пока нет в списке. Опишите задачу — подберём похожий сценарий.</p>
                </div>

                <article class="ad-card" id="direction-detail" data-ad-card aria-live="polite">
                    <button class="ad-card__close" type="button" data-ad-close aria-label="Закрыть карточку направления">
                        <span class="ad-icon ad-icon--close" aria-hidden="true"></span>
                    </button>

                    <div class="ad-card__main">
                        <span class="ad-card__badge" data-ad-badge>{initial.label}</span>
                        <h3 class="ad-card__title" data-ad-title>{"ИИ-агент: " + initial.label}</h3>

                        <p class="ad-card__label">Задача</p>
                        <p class="ad-card__pain" data-ad-pain>{initial.pain}</p>

                        <p class="ad-card__label">Что делает агент</p>
                        <ul class="ad-card__workflow" data-ad-workflow>
                            {initial.workflow.map((step) => (
                                <li>
                                    <span class="ad-card__check" aria-hidden="true"></span>
                                    <span>{step}</span>
                                </li>
                            ))}
                        </ul>

                        <p class="ad-card__outcome" data-ad-outcome>
                            <span class="ad-card__outcome-label">Результат</span>
                            <span data-ad-outcome-text>{initial.outcome}</span>
                        </p>
                        <p class="ad-card__example" data-ad-example>{initial.example}</p>
                    </div>

                    <aside class="ad-visual" aria-label="Пример результата">
                        <div class="ad-visual__top">
                            <span class="ad-visual__eyebrow">Пример результата</span>
                            <span class="ad-visual__status" data-ad-output>{initial.scene.output}</span>
                        </div>
                        <p class="ad-visual__title" data-ad-scene>{initial.scene.title}</p>
                        <img
                            class="ad-visual__image"
                            data-ad-illustration
                            src={initial.illustration}
                            alt={initial.alt}
                            width="960"
                            height="640"
                            loading="lazy"
                            decoding="async"
                        />
                        <div class="ad-visual__flow">
                            <span class="ad-visual__step"><span class="ad-visual__dot" aria-hidden="true"></span><span data-ad-input>{initial.scene.input}</span></span>
                            <span class="ad-visual__arrow" aria-hidden="true"></span>
                            <span class="ad-visual__step ad-visual__step--end"><span class="ad-visual__dot" aria-hidden="true"></span><span data-ad-output-text>{initial.scene.output}</span></span>
                        </div>
                    </aside>

                    <footer class="ad-card__footer">
                        <nav class="ad-card__links" data-ad-links aria-label="Связанные услуги">
                            {initial.links.map((item) => (
                                <a class="ad-card__link" href={item.href}>
                                    {item.title}
                                    <span class="ad-icon ad-icon--external" aria-hidden="true"></span>
                                </a>
                            ))}
                        </nav>
                        <a class="ad-card__cta" href="/contact" data-request-modal>
                            {ctaLabel}
                            <span class="ad-icon ad-icon--arrow" aria-hidden="true"></span>
                        </a>
                    </footer>
                </article>

                <p class="ad__note">{AUDIENCE_SECTION.disclaimer}</p>

                <div class="ad-outro">
                    <div class="ad-outro__copy">
                        <h3>Автоматизация начинается с вашей задачи</h3>
                        <p>Заявки, документы, ответы клиентам и отчёты — находим процессы, где ИИ полезен вашей команде. Подключаем агента к CRM и базе знаний, настраиваем сценарии и контроль результата.</p>
                        <a class="ad-outro__link" href="/contact" data-request-modal>
                            Подобрать решение для моего бизнеса
                            <span class="ad-icon ad-icon--arrow" aria-hidden="true"></span>
                        </a>
                    </div>
                    <figure class="ad-outro__visual" aria-hidden="true">
                        <img
                            src="/images/aicraft-audience-assets-120/ai/agent-assistant.svg"
                            alt=""
                            width="1024"
                            height="1024"
                            loading="lazy"
                            decoding="async"
                        />
                    </figure>
                </div>

                <div class="ad-seo">
                    <div class="ad-seo__text">
                        {seo.map((block, index) => (
                            <div class="ad-seo__item">
                                <span class="ad-seo__num" aria-hidden="true">{"0" + (index + 1)}</span>
                                <h3>{block.title}</h3>
                                <p>{block.text}</p>
                            </div>
                        ))}
                    </div>
                    <figure class="ad-seo__visual">
                        <img
                            src="/images/aicraft-audience-assets-120/ai/agent-analytics.svg"
                            alt=""
                            width="1024"
                            height="1024"
                            loading="lazy"
                            decoding="async"
                        />
                        <figcaption class="ad-seo__caption">Агент работает с сообщениями, документами и записями в ваших системах — результат приходит со ссылками на источники.</figcaption>
                    </figure>
                    <nav class="ad-seo__nav" aria-label="Услуги для внедрения">
                        {services.map((service) => (
                            <a href={service.href}>{service.title}</a>
                        ))}
                    </nav>
                </div>
            </div>

            <script is:inline type="application/json" data-ad-data set:html={JSON.stringify(payload)} />
        </aicraft-directions>
    </div>
</section>


<style>
    .ad {
        --ad-accent: #cff85e;
        --ad-accent-bright: #e4ff92;
        --ad-accent-soft: rgba(207, 248, 94, 0.1);
        --ad-ink: #f4f6ee;
        --ad-text: #b9bdb2;
        --ad-muted: #8f948a;
        --ad-line: #3c4236;
        --ad-line-strong: #4e5545;
        --ad-surface: #191c17;
        --ad-surface-2: #1f231d;
        --ad-deep: #101310;
        position: relative;
        padding: clamp(24px, 3vw, 52px) 0 clamp(38px, 4vw, 72px);
        scroll-margin-top: 96px;
    }

    .ad__panel {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        color: var(--ad-ink);
    }

    .ad__head {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        max-width: 900px;
        margin: 0 auto;
    }

    .ad__eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        min-height: 36px;
        padding: 7px 16px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.04);
        color: #e2e6da;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.11em;
        text-transform: uppercase;
        line-height: 1.2;
    }

    .ad__eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--ad-accent);
        box-shadow: 0 0 0 4px rgba(207, 248, 94, 0.12);
    }

    .ad__title {
        display: flex;
        flex-direction: column;
        gap: 0.04em;
        margin: 20px 0 0;
        color: var(--ad-ink);
        font-size: clamp(32px, 4.2vw, 64px);
        font-weight: 500;
        line-height: 0.99;
        letter-spacing: -0.045em;
    }

    .ad__title-accent {
        color: var(--ad-accent);
    }

    .ad__lead {
        max-width: 660px;
        margin: 18px 0 0;
        color: var(--ad-text);
        font-size: clamp(15px, 1.15vw, 18px);
        line-height: 1.6;
    }

    .ad__tools {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        max-width: 800px;
        margin-top: 26px;
    }

    .ad-search {
        display: flex;
        flex: 1 1 auto;
        align-items: center;
        gap: 11px;
        min-height: 54px;
        padding: 0 18px;
        border: 1px solid var(--ad-line);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        color: var(--ad-accent);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .ad-search:focus-within {
        border-color: rgba(207, 248, 94, 0.55);
        background: rgba(255, 255, 255, 0.05);
        box-shadow: 0 0 0 4px rgba(207, 248, 94, 0.1);
    }

    .ad-search__input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--ad-ink);
        font: inherit;
        font-size: 16px;
    }

    .ad-search__input::placeholder {
        color: var(--ad-muted);
    }

    .ad-search__input::-webkit-search-cancel-button {
        filter: invert(1) opacity(0.5);
    }

    .ad-icon {
        display: inline-block;
        flex: none;
        width: 18px;
        height: 18px;
        background-color: currentColor;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-position: center;
        mask-position: center;
        -webkit-mask-size: contain;
        mask-size: contain;
    }

    .ad-icon--search {
        -webkit-mask-image: url("/images/aicraft-audience-assets-120/common/search.svg");
        mask-image: url("/images/aicraft-audience-assets-120/common/search.svg");
    }

    .ad-icon--external {
        -webkit-mask-image: url("/images/aicraft-audience-assets-120/common/external-link.svg");
        mask-image: url("/images/aicraft-audience-assets-120/common/external-link.svg");
    }

    .ad-icon--close {
        -webkit-mask-image: url("/images/aicraft-audience-assets-120/common/close.svg");
        mask-image: url("/images/aicraft-audience-assets-120/common/close.svg");
    }

    .ad-icon--arrow {
        -webkit-mask-image: url("/images/aicraft-audience-assets-120/common/arrow-right.svg");
        mask-image: url("/images/aicraft-audience-assets-120/common/arrow-right.svg");
    }

    .ad__pause-icon--pause {
        -webkit-mask-image: url("/images/aicraft-audience-assets-120/common/pause.svg");
        mask-image: url("/images/aicraft-audience-assets-120/common/pause.svg");
    }

    .ad__pause-icon--play {
        -webkit-mask-image: url("/images/aicraft-audience-assets-120/common/play.svg");
        mask-image: url("/images/aicraft-audience-assets-120/common/play.svg");
    }

    .ad__all {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 44px;
        padding: 0 4px;
        color: var(--ad-accent);
        font-size: 15px;
        font-weight: 500;
        text-decoration: underline;
        text-decoration-color: rgba(207, 248, 94, 0.4);
        text-underline-offset: 6px;
        white-space: nowrap;
        transition: color 0.2s ease;
    }

    .ad__all .ad-icon {
        width: 14px;
        height: 14px;
    }

    .ad__all:hover {
        color: var(--ad-accent-bright);
    }

    .ad__pause {
        position: relative;
        display: grid;
        flex: none;
        place-items: center;
        width: 54px;
        height: 54px;
        border: 1px solid var(--ad-line);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        color: #e7eadf;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .ad__pause:hover {
        border-color: rgba(207, 248, 94, 0.55);
        color: var(--ad-accent);
    }

    .ad__pause[aria-pressed="true"] {
        border-color: rgba(207, 248, 94, 0.55);
        color: var(--ad-accent);
        background: var(--ad-accent-soft);
    }

    .ad__pause-icon {
        grid-area: 1 / 1;
        width: 16px;
        height: 16px;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .ad__pause-icon--play {
        opacity: 0;
        transform: scale(0.75);
    }

    .ad__pause[aria-pressed="true"] .ad__pause-icon--pause {
        opacity: 0;
        transform: scale(0.75);
    }

    .ad__pause[aria-pressed="true"] .ad__pause-icon--play {
        opacity: 1;
        transform: scale(1);
    }

    .ad__marquee {
        margin-top: clamp(22px, 2.4vw, 34px);
    }

    .ad__row {
        position: relative;
        overflow: hidden;
        padding-block: 6px;
        mask-image: linear-gradient(90deg, transparent, #000 2.5%, #000 97.5%, transparent);
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 2.5%, #000 97.5%, transparent);
    }

    .ad__track {
        display: flex;
        gap: 9px;
        width: max-content;
        animation: ad-scroll 165s linear infinite;
        will-change: transform;
    }

    .ad__row[data-direction="right"] .ad__track {
        animation-direction: reverse;
        animation-duration: 185s;
    }

    .ad__row:hover .ad__track,
    .ad__row:focus-within .ad__track,
    .ad__marquee[data-paused="true"] .ad__track {
        animation-play-state: paused;
    }

    @keyframes ad-scroll {
        from { transform: translate3d(0, 0, 0); }
        to { transform: translate3d(-50%, 0, 0); }
    }

    .ad-chip {
        display: inline-flex;
        flex: none;
        align-items: center;
        gap: 10px;
        min-height: 54px;
        padding: 0 20px;
        border: 1px solid var(--ad-line);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.035);
        color: #e7eadf;
        font: inherit;
        font-size: 16px;
        font-weight: 500;
        line-height: 1.1;
        white-space: nowrap;
        cursor: pointer;
        transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
    }

    .ad-chip__icon {
        flex: none;
        width: 24px;
        height: 24px;
        background-color: var(--ad-accent);
        -webkit-mask-image: var(--ad-icon);
        mask-image: var(--ad-icon);
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-position: center;
        mask-position: center;
        -webkit-mask-size: contain;
        mask-size: contain;
        transition: background-color 0.25s ease;
    }

    .ad-chip__more {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        max-width: 0;
        overflow: hidden;
        opacity: 0;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        transition: max-width 0.28s ease, opacity 0.22s ease, margin-left 0.28s ease;
    }

    .ad-chip__more-icon {
        width: 13px;
        height: 13px;
        background-color: currentColor;
        -webkit-mask: url("/images/aicraft-audience-assets-120/common/arrow-right.svg") center / contain no-repeat;
        mask: url("/images/aicraft-audience-assets-120/common/arrow-right.svg") center / contain no-repeat;
    }

    .ad-chip:hover,
    .ad-chip:focus-visible {
        background: var(--ad-accent);
        border-color: var(--ad-accent);
        color: #14170d;
        box-shadow: 0 12px 26px rgba(207, 248, 94, 0.18);
        outline: none;
    }

    .ad-chip:hover .ad-chip__icon,
    .ad-chip:focus-visible .ad-chip__icon {
        background-color: #14170d;
    }

    .ad-chip:hover .ad-chip__more,
    .ad-chip:focus-visible .ad-chip__more {
        max-width: 150px;
        margin-left: 2px;
        opacity: 1;
    }

    .ad-chip[aria-pressed="true"] {
        background: var(--ad-accent);
        border-color: var(--ad-accent);
        color: #14170d;
        box-shadow: 0 12px 26px rgba(207, 248, 94, 0.18);
    }

    .ad-chip[aria-pressed="true"] .ad-chip__icon {
        background-color: #14170d;
    }

    .ad-chip:focus-visible {
        outline: 2px solid var(--ad-accent);
        outline-offset: 3px;
    }

    .ad-chip--clone {
        pointer-events: none;
    }

    .ad-chip[hidden] {
        display: none;
    }

    .ad__hint {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 8px auto 0;
        max-width: 620px;
        color: var(--ad-muted);
        font-size: 14px;
        line-height: 1.3;
        text-align: center;
    }

    .ad__hint span {
        flex: 1 1 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--ad-line));
    }

    .ad__hint span:last-child {
        background: linear-gradient(90deg, var(--ad-line), transparent);
    }

    .ad__empty {
        margin: 16px auto 0;
        max-width: 560px;
        color: var(--ad-text);
        font-size: 15px;
        line-height: 1.5;
        text-align: center;
    }

    .ad__marquee[data-searching="true"] .ad__hint {
        display: none;
    }

    .ad__marquee[data-searching="true"] .ad__track {
        animation: none;
        flex-wrap: wrap;
        justify-content: center;
        width: 100%;
        gap: 8px;
    }

    .ad__marquee[data-searching="true"] .ad__row {
        overflow: visible;
        mask-image: none;
        -webkit-mask-image: none;
    }

    .ad__marquee[data-searching="true"] .ad-chip--clone {
        display: none;
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }

    .ad-card {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
