---
interface FaqItemData {
    question: string;
    answer: string;
}

interface Props {
    homeOriginal?: boolean;
    withBottomSpacing?: boolean;
    subTitle?: string;
    title?: string;
    description?: string;
    customFaqs?: FaqItemData[];
}

import FaqItem from "./shared/faq/FaqItem.astro";
import { HOME_FAQS, HOME_ORIGINAL_FAQS } from "../lib/home-faqs";
const {
    homeOriginal = false,
    withBottomSpacing = false,
    subTitle = homeOriginal ? "Часто задаваемые вопросы" : "Вопросы перед началом",
    title = homeOriginal ? "Ответы на ключевые вопросы по внедрению ИИ" : "Как подготовить проект по внедрению ИИ",
    description = homeOriginal ? "Узнайте больше о том, как искусственный интеллект может трансформировать ваш бизнес, оптимизировать процессы и создать новые возможности для роста." : "Как выбрать процесс, подготовить данные и проверить работу ИИ-агента.",
    customFaqs = homeOriginal ? HOME_ORIGINAL_FAQS : HOME_FAQS,
} = Astro.props;
---
<!-- Our Faq Section Start -->
<div class:list={["our-faqs bg-section", { "our-faqs--spaced": withBottomSpacing }]}>
    <div class="container">
        <div class="row">
            <div class="col-xl-6">
                <!-- FAQ Content Start -->
                <div class="faq-content">
                    <!-- Section Title Start -->
                    <div class="section-title">
                        <span class="section-sub-title wow fadeInUp">{subTitle}</span>
                        <h2 class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
                        <p class="wow fadeInUp" data-wow-delay="0.2s">{description}</p>
                    </div>
                    <!-- Section Title End -->

                    <!-- Contact Us Circle Start -->
                    <div class="contact-us-circle wow fadeInUp" data-wow-delay="0.4s">
                        <a href="/contact">
                            <img src="/images/contact-us-circle.svg" alt="Задать вопрос по ИИ">
                        </a>
                    </div>
                    <!-- Contact Us Circle End -->
                </div>
                <!-- FAQ Content End -->
            </div>

            <div class="col-xl-6">
                <!-- FAQ Accordion Start -->
                <div class="faqs-accordion" id="accordion">
                    {customFaqs.map((faq, index) => (
                        <FaqItem 
                            id={(index + 1).toString()}
                            question={homeOriginal ? `${index + 1}. ${faq.question}` : faq.question}
                            answer={faq.answer}
                            active={index === 0}
                            delay={`${index * 0.1}s`}
                        />
                    ))}
                </div>
                <!-- FAQ Accordion End -->
            </div>


        </div>
    </div>
</div>
<!-- Our Faq Section End -->

<style>
    .our-faqs--spaced {
        padding-block-end: clamp(32px, 4vw, 64px);
    }
</style>
