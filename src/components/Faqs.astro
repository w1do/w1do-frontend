---
interface FaqItemData {
    question: string;
    answer: string;
}

interface Props {
    subTitle?: string;
    title?: string;
    description?: string;
    customFaqs?: FaqItemData[];
}

import FaqItem from "./shared/faq/FaqItem.astro";
const { 
    subTitle = "Часто задаваемые вопросы",
    title = "Ответы на ключевые вопросы по внедрению ИИ",
    description = "Узнайте больше о том, как искусственный интеллект может трансформировать ваш бизнес, оптимизировать процессы и создать новые возможности для роста.",
    customFaqs
} = Astro.props;


const defaultFaqs = [
    {
        question: "Как происходит процесс заказа и старта разработки ИИ-решения?",
        answer: "Процесс начинается с бесплатной консультации и заполнения брифа. Затем я провожу аудит процессов, формирую техническое задание с KPI и подписываю договор. После этого приступаю к разработке MVP."
    },
    {
        question: "Какие этапы включает в себя разработка кастомного ИИ-агента?",
        answer: "Разработка включает 4 этапа: 1) Проектирование архитектуры и выбор модели. 2) Подготовка и индексация данных (RAG). 3) Настройка логики агента и промпт-инжиниринг. 4) Тестирование на реальных кейсах и финальная отладка."
    },
    {
        question: "Можно ли внедрить ИИ в уже существующую CRM или ERP систему?",
        answer: "Да, большинство наших решений интегрируются через API. У меня есть опыт внедрения ИИ-инструментов в Битрикс24, amoCRM, 1С и кастомные системы, с автоматизацией передачи данных между ними."
    },
    {
        question: "Сколько времени занимает автоматизация одного бизнес-процесса?",
        answer: "Первичная автоматизация несложного процесса (например, классификация входящих писем) занимает от 7 до 14 дней. Более сложные цепочки с многошаговой логикой требуют 3-5 недель разработки и тестирования."
    },
    {
        question: "Предоставляете ли вы услуги по доработке и оптимизации сторонних ИИ-решений?",
        answer: "Да, я провожу аудит текущих решений, исправляю ошибки в промптах, оптимизирую затраты на токены и повышаю точность ответов существующих систем."
    },
    {
        question: "Какие данные необходимы для начала разработки и обучения системы?",
        answer: "Для RAG-систем нужны ваши внутренние документы (PDF, DOCX, базы знаний). Для автоматизации задач — примеры выполненных работ и описание логики, по которой человек принимает решения в данном процессе."
    },
    {
        question: "Как осуществляется техническая поддержка после внедрения?",
        answer: "Я предлагаю пакеты сопровождения: мониторинг работы системы, обновление версий моделей, доработку логики под меняющиеся задачи и оперативное устранение сбоев."
    },
    {
        question: "Можно ли автоматизировать задачи, требующие сложного анализа и принятия решений?",
        answer: "Да, современные агенты способны выполнять многошаговые задачи: от анализа юридических рисков в контрактах до оценки кредитоспособности. Я выстраиваю цепочки проверок (chain-of-thought) для контроля качества."
    },
    {
        question: "Как оценивается стоимость разработки проекта?",
        answer: "Стоимость зависит от сложности логики, количества интеграций и объема данных. Я работаю по двум моделям: фиксированная цена за проект (Fixed Price) или оплата за часы разработки (Time & Materials)."
    },
    {
        question: "Возможна ли масштабируемость и доработка системы в будущем?",
        answer: "Мои решения строятся по модульному принципу. Вы можете начать с автоматизации одного отдела и постепенно добавлять новые функции, подключать дополнительные модели и расширять базу знаний без переписывания ядра системы."
    }
];

const faqs = customFaqs || defaultFaqs;
---
<!-- Our Faq Section Start -->
<div class="our-faqs bg-section">
    <div class="container">
        <div class="row">
            <div class="col-xl-6">
                <!-- FAQ Content Start -->
                <div class="faq-content">
                    <!-- Section Title Start -->
                    <div class="section-title">
                        <span class="section-sub-title wow fadeInUp">{subTitle}</span>
                        <h2 class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
                        <p class="wow fadeInUp" data-wow-delay="0.2s">{description}</p>
                    </div>
                    <!-- Section Title End -->

                    <!-- Contact Us Circle Start -->
                    <div class="contact-us-circle wow fadeInUp" data-wow-delay="0.4s">
                        <a href="/contact">
                            <img src="/images/contact-us-circle.svg" alt="Задать вопрос по ИИ">
                        </a>
                    </div>
                    <!-- Contact Us Circle End -->
                </div>
                <!-- FAQ Content End -->
            </div>

            <div class="col-xl-6">
                <!-- FAQ Accordion Start -->
                <div class="faqs-accordion" id="accordion">
                    {faqs.map((faq, index) => (
                        <FaqItem 
                            id={(index + 1).toString()}
                            question={`${index + 1}. ${faq.question}`}
                            answer={faq.answer}
                            active={index === 0}
                            delay={`${index * 0.1}s`}
                        />
                    ))}
                </div>
                <!-- FAQ Accordion End -->
            </div>


        </div>
    </div>
</div>
<!-- Our Faq Section End -->